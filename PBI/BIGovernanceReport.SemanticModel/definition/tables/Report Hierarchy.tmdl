table 'Report Hierarchy'
	lineageTag: 55ab2f49-41f2-4c58-a5f4-d860fc89b665

	measure 'App Page URL Link' =
			VAR A = MAX( 'Report Hierarchy'[App Page URL] )
			RETURN
			    SWITCH(
			        TRUE( ),
			        ISINSCOPE( 'Report Hierarchy'[Workspace Name] )
			            && ISINSCOPE( 'Report Hierarchy'[Report Name] )
			            && ISINSCOPE( 'Report Hierarchy'[Page Name] ), A,
			        BLANK( )
			    )
		lineageTag: 665cb320-f5ec-42ea-9c69-2d4ac70303ff
		dataCategory: WebUrl

	measure 'App Report URL Link' =
			VAR A = MAX( 'Report Hierarchy'[App Report URL] )
			RETURN
			    SWITCH(
			        TRUE( ),
			        ISINSCOPE( 'Report Hierarchy'[Workspace Name] )
			            && ISINSCOPE( 'Report Hierarchy'[Report Name] ), A,
			        BLANK( )
			    )
		lineageTag: c9b7343d-9d69-42a0-84f8-70954727613f
		dataCategory: WebUrl

	measure 'App URL Link' = MAX('Report Hierarchy'[App URL])
		lineageTag: 183a44f8-32b3-4f8e-ab07-802f9fd31c34
		dataCategory: WebUrl

	/// Generates a clickable URL to navigate directly to a specific page within the Power BI workspace (not the app). Only returns a value when a specific workspace, report, and page are selected.
	measure 'Workspace Page URL Link' =
			VAR A =
			    CALCULATE(
			        MAX( 'Report Hierarchy'[Workspace Page URL] ),
			        KEEPFILTERS( 'All Reports' )
			    )
			RETURN
			    SWITCH(
			        TRUE( ),
			        ISINSCOPE( 'Report Hierarchy'[Workspace Name] )
			            && ISINSCOPE( 'Report Hierarchy'[Report Name] )
			            && ISINSCOPE( 'Report Hierarchy'[Page Name] ), A,
			        BLANK( )
			    )
		lineageTag: 44eaaae4-2aac-4e49-ae8e-5589a8c66f3e
		dataCategory: WebUrl

	/// Generates a clickable URL to navigate to a report within the Power BI workspace. Only returns a value when a specific workspace and report are selected.
	measure 'Workspace Report URL Link' =
			VAR A =
			    CALCULATE(
			        MAX( 'Report Hierarchy'[Workspace Report URL] ),
			        KEEPFILTERS( 'All Reports' )
			    )
			RETURN
			    SWITCH(
			        TRUE( ),
			        ISINSCOPE( 'Report Hierarchy'[Workspace Name] )
			            && ISINSCOPE( 'Report Hierarchy'[Report Name] ), A,
			        BLANK( )
			    )
		lineageTag: 40171e82-10a1-419a-be18-0de468552afd
		dataCategory: WebUrl

	/// Generates a clickable URL to navigate to the Power BI workspace. Only returns a value when a specific workspace is selected.
	measure 'Workspace URL Link' =
			VAR A = MAX( 'Report Hierarchy'[Workspace URL] )
			RETURN
			    SWITCH(
			        TRUE( ),
			        ISINSCOPE( 'Report Hierarchy'[Workspace Name] ), A,
			        BLANK( )
			    )
		lineageTag: 75dabe8d-475e-40b0-b70e-9f582f9e9345
		dataCategory: WebUrl

	/// Counts the distinct Power BI reports that reference a specific object. When a user asks "where do I use Total Sales?" or "how many reports use Revenue?", filter 'Model Object Hierarchy'[Object Name] to the name the user provided (e.g. "Total Sales"). The Object Name column contains the actual names of measures, columns, calculated columns, hierarchy levels, etc. — do not search for the word "measure" or "column" itself. The count spans all workspaces and models in the current filter context.
	measure 'Report Distinct Count (Visual Impact)' =
			CALCULATE(
			    DISTINCTCOUNT(
			        'Report Hierarchy'[Workspace Name - Model ID - Report ID]
			    ),
			    KEEPFILTERS( 'All Reports' )
			)
		formatString: #,##0
		lineageTag: a414763f-5f01-4f6c-8fad-bc7979f7afe9

	/// Counts the distinct Power BI workspaces containing reports that reference a specific object. When a user asks "how many workspaces use Total Sales?" or "which workspaces are impacted by Revenue?", filter 'Model Object Hierarchy'[Object Name] to the name the user provided. The Object Name column holds the actual names of measures, columns, calculated columns, hierarchy levels, etc. — do not search for type keywords like "measure" or "column".
	measure 'Workspace Distinct Count (Visual Impact)' =
			CALCULATE(
			    DISTINCTCOUNT(
			        'Report Hierarchy'[Workspace Name]
			    ),
			    KEEPFILTERS( 'All Reports' )
			)
		formatString: #,##0
		lineageTag: 45d6f65b-0d7e-4404-a355-e132c56fe6cc

	/// Counts the distinct report pages that reference a specific object. When a user asks "how many pages use Total Sales?" or "which pages would break if I change Revenue?", filter 'Model Object Hierarchy'[Object Name] to the name the user provided. The Object Name column holds the actual names of measures, columns, calculated columns, hierarchy levels, etc. — do not search for type keywords like "measure" or "column".
	measure 'Page Distinct Count (Visual Impact)' =
			CALCULATE(
			    DISTINCTCOUNT(
			        'All Reports'[UniquePageID]
			    ),
			    KEEPFILTERS( 'All Reports' )
			)
		formatString: #,##0
		lineageTag: eaf831f2-69bc-4fdb-9493-a1ee667770a2

	/// Counts the distinct semantic models whose connected reports reference a specific object. When a user asks "how many models are impacted by Total Sales?", filter 'Model Object Hierarchy'[Object Name] to the name the user provided. Useful when the same object name exists in multiple models. The Object Name column holds the actual names of measures, columns, calculated columns, hierarchy levels, etc. — do not search for type keywords like "measure" or "column".
	measure 'Model Distinct Count (Visual Impact)' =
			CALCULATE(
			    DISTINCTCOUNT(
			        'Report Hierarchy'[Workspace Name - Model ID]
			    ),
			    KEEPFILTERS( 'All Reports' )
			)
		formatString: 0
		lineageTag: b580e931-126f-4c15-9a92-8101834813d6

