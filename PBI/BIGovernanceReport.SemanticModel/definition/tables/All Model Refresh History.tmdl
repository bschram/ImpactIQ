	partition 'All Model Refresh History' = m
		mode: import
		queryGroup: 'Model Layer'
		source = ```
				let
				    // Load model refresh history from the base query
				    Source = #"Base Power BI Model Refresh History",
				    // Sanitize workspace name using the Clean Name function
				    #"Invoked Custom Function" = Table.AddColumn(Source, "Clean Name", each #"Clean Name"([WorkspaceName]), type text),
				    // Sanitize model (dataset) name using the Clean Name function
				    #"Invoked Custom Function1" = Table.AddColumn(#"Invoked Custom Function", "Clean Name.1", each #"Clean Name"([DatasetName]), type text),
				    // Remove the original unsanitized workspace and dataset name columns
				    #"Removed Columns" = Table.RemoveColumns(#"Invoked Custom Function1",{"WorkspaceName", "DatasetName"}),
				    // Rename the sanitized columns back to their original names
				    #"Renamed Columns" = Table.RenameColumns(#"Removed Columns",{{"Clean Name", "WorkspaceName"}, {"Clean Name.1", "DatasetName"}}),
				    // Keep only the essential refresh history columns
				    #"Removed Other Columns" = Table.SelectColumns(#"Renamed Columns", {"DatasetName", "DatasetId", "DatasetRefreshRequestId", "DatasetRefreshId", "DatasetRefreshStartTime", "DatasetRefreshEndTime", "DatasetRefreshType", "DatasetRefreshStatus"}),
				    // Pre-filter Workspace & Model Mapping to home workspace only (prevents fan-out duplication and memory explosion)
				    #"Merged Queries" = Table.NestedJoin(#"Removed Other Columns", {"DatasetId"}, Table.SelectRows(#"Workspace & Model Mapping", each [Model in Workspace Flag] = "TRUE"), {"Model ID"}, "Workspace & Model Mapping", JoinKind.LeftOuter),
				    // Expand workspace name, ID, and model home workspace from the mapping
				    #"Expanded Workspace & Model Mapping" = Table.ExpandTableColumn(#"Merged Queries", "Workspace & Model Mapping", {"Model in Workspace Flag", "Workspace Name", "Workspace ID", "Model Home Workspace Name"}, {"Model in Workspace Flag", "WorkspaceName", "Workspace ID", "Model Home Workspace Name"}),
				    // Rename all columns to user-friendly display names
				    #"Renamed Columns1" = Table.RenameColumns(#"Expanded Workspace & Model Mapping",{{"DatasetId", "Model ID"}, {"DatasetRefreshRequestId", "Refresh Request ID"}, {"DatasetRefreshId", "Refresh ID"}, {"DatasetRefreshStartTime", "Refresh Start Time"}, {"DatasetRefreshEndTime", "Refresh End Time"}, {"DatasetRefreshType", "Refresh Type"}, {"DatasetRefreshStatus", "Refresh Status"}, {"DatasetName", "Model Name"}}),
				    // Create a composite key combining workspace and model names
				    #"Added Custom" = Table.AddColumn(#"Renamed Columns1", "Workspace Name - Model Name", each [WorkspaceName]&" - "&[Model Name], type text),
				    // Create a composite key combining workspace name and model ID
				    #"Added Custom1" = Table.AddColumn(#"Added Custom", "Workspace Name - Model ID", each [WorkspaceName]&" - "&[Model ID], type text),
				    // Calculate refresh duration in HH:MM:SS format from start and end times
				    #"Added Custom2" = Table.AddColumn(#"Added Custom1", "Refresh Duration (HH:MM:SS)", each let
				            Duration = [Refresh End Time] - [Refresh Start Time],
				            TotalSeconds = Duration.TotalSeconds(Duration),
				            Hours = Number.IntegerDivide(TotalSeconds, 3600),
				            Minutes = Number.IntegerDivide(TotalSeconds - (Hours * 3600), 60),
				            Seconds = Number.Round(TotalSeconds - (Hours * 3600) - (Minutes * 60), 0),
				            DurationFormatted = Text.PadStart(Text.From(Hours), 2, "0") & ":" & 
				                                Text.PadStart(Text.From(Minutes), 2, "0") & ":" & 
				                                Text.PadStart(Text.From(Seconds), 2, "0")
				        in
				            DurationFormatted, type text),
				    #"Replaced Value" = Table.ReplaceValue(#"Added Custom2",null,"TRUE",Replacer.ReplaceValue,{"Model in Workspace Flag"})
				in
				    #"Replaced Value"
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Exception

