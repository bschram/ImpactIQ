				    #"Expanded dependencies_with_types (2)7" = Table.ExpandTableColumn(#"Merged Queries7", "dependencies_with_types (2)", {"Depends On"}, {"Depends On.7"}),
				    // Level 09: Chain to ninth-level dependencies
				    #"Merged Queries8" = Table.NestedJoin(#"Expanded dependencies_with_types (2)7", {"Depends On.7"}, MeasureDependencies, {"Measure Name"}, "dependencies_with_types (2)", JoinKind.LeftOuter),
				    #"Expanded dependencies_with_types (2)8" = Table.ExpandTableColumn(#"Merged Queries8", "dependencies_with_types (2)", {"Depends On"}, {"Depends On.8"}),
