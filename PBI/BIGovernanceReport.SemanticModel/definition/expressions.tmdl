expression UsedObjects =
		let
		    // Start with the report-level usage data
		    Source = UsedinReports,
		    // Combine all usage sources: reports, relationships, measures (columns & measures), and calculated columns
		    #"Appended Query" = Table.Combine({Source, UsedinRelationships, ColumnsUsedinMeasures, MeasuresUsedinMeasures, ColumnsUsedinCalculatedColumns, MeasuresUsedinCalculatedColumns, UsedinRLS, ColumnsUsedinCalculationGroups, MeasuresUsedinCalculationGroups}),
		    // Keep only the composite key and usage source columns
		    #"Removed Other Columns" = Table.SelectColumns(#"Appended Query",{"WorkspaceName - ModelName - ObjectType - TableName - ObjectName", "Object Used In"}),
		    // Add a static "Used" value to serve as the pivot fill value
		    #"Added Custom1" = Table.AddColumn(#"Removed Other Columns", "Usage", each "Used", type text),
		    // Pivot usage sources into separate columns (Reports, Relationships, Measures, etc.)
		    #"Pivoted Column" = Table.Pivot(#"Added Custom1", List.Distinct(#"Added Custom1"[#"Object Used In"]), "Object Used In", "Usage"),
		    // Check if Reports column exists and create a normalized flag (handles dynamic pivot results)
		#"Added Conditional Column" =
		    Table.AddColumn(
		        #"Pivoted Column",
		        "Reports1",
		        each if Table.HasColumns(#"Pivoted Column", "Reports") and [Reports] <> null
		             then "Reports"
		             else null,
		        type text
		    ),
		    // Check if Relationships column exists and create a normalized flag
		
		#"Added Conditional Column1" =
		    Table.AddColumn(
		        #"Added Conditional Column",
		        "Relationships1",
		        each if Table.HasColumns(#"Added Conditional Column", "Relationships") and [Relationships] <> null
		             then "Relationships"
		             else null,
		        type text
		    ),
		    // Check if Measures column exists and create a normalized flag
		
		#"Added Conditional Column2" =
		    Table.AddColumn(
		        #"Added Conditional Column1",
		        "Measures1",
		        each if Table.HasColumns(#"Added Conditional Column1", "Measures") and [Measures] <> null
		             then "Measures"
		             else null,
		        type text
		    ),
		    // Check if Other Measures column exists and create a normalized flag
		
		#"Added Conditional Column3" =
		    Table.AddColumn(
		        #"Added Conditional Column2",
		        "Other Measures1",
		        each if Table.HasColumns(#"Added Conditional Column2", "Other Measures") and [Other Measures] <> null
		             then "Other Measures"
		             else null,
		        type text
		    ),
		    // Check if Calculated Columns column exists and create a normalized flag
		
		#"Added Conditional Column4" =
		    Table.AddColumn(
		        #"Added Conditional Column3",
		        "Calculated Columns1",
		        each if Table.HasColumns(#"Added Conditional Column3", "Calculated Columns") and [Calculated Columns] <> null
		             then "Calculated Columns"
		             else null,
		        type text
		    ),
		    #"Added Conditional Column5" = Table.AddColumn(#"Added Conditional Column4", "RLS1", each if Table.HasColumns(#"Added Conditional Column4", "RLS") and [RLS] <> null
		             then "RLS"
		             else null, type text),
		    #"Added Conditional Column6" = Table.AddColumn(#"Added Conditional Column5", "Calculation Groups1", each if Table.HasColumns(#"Added Conditional Column3", "Calculation Groups") and [Calculation Groups] <> null
		             then "Calculation Groups"
		             else null, type text),
		    // Combine all non-null usage flags into a comma-separated UsageType string
		    #"Added Custom" = Table.AddColumn(#"Added Conditional Column6", "UsageType", each Text.Combine(
		    List.Select(
		        { [Reports1], [Relationships1], [Measures1], [Other Measures1], [Calculated Columns1], [RLS1], [Calculation Groups1] },
		        each _ <> null and _ <> ""
		    ),
		    ", "
		), type text),
		    // Keep only the composite key and the combined UsageType for the final output
		    #"Removed Other Columns1" = Table.SelectColumns(#"Added Custom",{"WorkspaceName - ModelName - ObjectType - TableName - ObjectName", "UsageType"})
		in
		    #"Removed Other Columns1"
	lineageTag: ed9c143a-9793-4f82-8881-ab6b0db78f00
