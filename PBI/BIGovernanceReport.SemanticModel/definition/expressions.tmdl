expression 'Workspace, Dataflow, & Model Mapping' =
		let
		    // Load the dataflow-to-model lineage data
		    Source = #"Base Dataflow Lineage",
		    // Sanitize workspace names by removing special characters
		    #"Invoked Custom Function" = Table.AddColumn(Source, "Clean Name", each #"Clean Name"([WorkspaceName]), type text),
		    // Sanitize dataflow names by removing special characters
		    #"Invoked Custom Function1" = Table.AddColumn(#"Invoked Custom Function", "Clean Name.1", each #"Clean Name"([DataflowName]), type text),
		    // Sanitize dataset/model names by removing special characters
		    #"Invoked Custom Function2" = Table.AddColumn(#"Invoked Custom Function1", "Clean Name.2", each #"Clean Name"([DatasetName]), type text),
		    // Drop the original unsanitized name columns
		    #"Removed Columns" = Table.RemoveColumns(#"Invoked Custom Function2",{"WorkspaceName", "DataflowName", "DatasetName"}),
		    // Rename the cleaned names back to their standard column names
		    #"Renamed Columns" = Table.RenameColumns(#"Removed Columns",{{"Clean Name", "WorkspaceName"}, {"Clean Name.1", "DataflowName"}, {"Clean Name.2", "DatasetName"}}),
		    // Create a composite key for workspace-dataflow lookups
		    #"Added Custom" = Table.TransformColumnTypes(Table.AddColumn(#"Renamed Columns", "Workspace Name - Dataflow Name", each [WorkspaceName] & " - " & [DataflowName]), {{"Workspace Name - Dataflow Name", type text}}),
		    // Create a composite key for workspace-dataflow-model lineage tracing
		    #"Added Custom1" = Table.AddColumn(#"Added Custom", "Workspace Name - Dataflow Name - Model Name", each [WorkspaceName]&" - "&[DataflowName]&" - "&[DatasetName], type text)
		in
		  #"Added Custom1"
