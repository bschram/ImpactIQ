table 'Measure Lineage - Dependents'
	lineageTag: 356b5d2d-ec02-49a7-90d1-300f1a6e0590

	/// Lists all dependent measures (downstream) for a selected measure — both direct and indirect. When a user asks 'what measures are affected if I change Total Sales?', filter 'Model Object Hierarchy'[Object Name] to 'Total Sales' and this measure returns a newline-separated list of every measure that references it, directly or through a chain of dependencies. The Object Name column holds the actual names — do not search for 'measure' or 'column' as keywords.
	measure 'Dependent Measures - All' =
			VAR SelectedMeasure =
			    SELECTEDVALUE(
			        'Measure Lineage - Dependents'[Measure Name]
			    )
			VAR ConcatenationResult =
			    CALCULATE(
			        CONCATENATEX(
			            DISTINCT(
			                FILTER(
			                    'Measure Lineage - Dependents',
			                    'Measure Lineage - Dependents'[Measure Name]
			                        = SelectedMeasure
			                )
			            ),
			            'Measure Lineage - Dependents'[Dependent Measure Name],
			            UNICHAR( 10 )   // This inserts a new line between each result
			        )
			    )
			RETURN
			    CALCULATE(
			        ConcatenationResult,
			        KEEPFILTERS(
			            'Measure Lineage - Dependents'[Dependent Measure Name]
			                <> BLANK( )
			        )
			    )
		lineageTag: 978a7a2f-b360-4b68-84ae-a670f71cc60b

	/// Lists only the direct (Level 01) dependent measures for a selected measure. These are measures that directly reference the selected measure in their DAX expression. Filter 'Model Object Hierarchy'[Object Name] to the measure name the user asks about.
	measure 'Dependent Measures - Direct' =
			CALCULATE(
			    [Dependent Measures - All],
			    KEEPFILTERS(
			        'Measure Lineage - Dependents'[Dependent Measure Drillthrough Level] IN { "Level 01" }
			    )
			)
		lineageTag: e1ab896f-dd24-43e3-8c77-129180b41111

	/// Lists only the indirect dependent measures (Level 02+) for a selected measure. These are measures that don't directly reference the selected measure but depend on it through a chain of other measures. Filter 'Model Object Hierarchy'[Object Name] to the measure name.
	measure 'Dependent Measures - Indirect' =
			CALCULATE(
			    [Dependent Measures - All],
			    KEEPFILTERS(
			        'Measure Lineage - Dependents'[Dependent Measure Drillthrough Level]
			            <> "Level 01"
			    )
			)
		lineageTag: 0a5e5288-109a-4bac-bdad-92ae250041ac

	/// Counts all distinct downstream measures that depend on the selected measure (both direct and indirect). Answers: 'How many measures would be affected if I change Total Sales?' Filter 'Model Object Hierarchy'[Object Name] to the name the user provides.
	measure 'Dependent Measures Distinct Count - All' =
			DISTINCTCOUNTNOBLANK(
			        'Measure Lineage - Dependents'[Dependent Measure Name]
			    )
		formatString: 0
		lineageTag: a74b5c5f-1f91-4c1c-b166-18d020cfec29

	/// Counts only the direct (Level 01) dependent measures. These directly reference the selected measure in their DAX code.
	measure 'Dependent Measures Distinct Count - Direct' =
			CALCULATE(
			    [Dependent Measures Distinct Count - All],
			    KEEPFILTERS(
			        'Measure Lineage - Dependents'[Dependent Measure Drillthrough Level] IN { "Level 01" }
			    )
			)
		formatString: #,0
		lineageTag: e4edb99d-26a3-42d8-87da-d37c0a655442

	/// Counts only the indirect dependent measures (Level 02+). These depend on the selected measure through a chain of other measures.
	measure 'Dependent Measures Distinct Count - Indirect' =
			CALCULATE(
			    [Dependent Measures Distinct Count - All],
			    KEEPFILTERS(
			        'Measure Lineage - Dependents'[Dependent Measure Drillthrough Level]
			            <> "Level 01"
			    )
			)
		formatString: #,0
		lineageTag: 04a1e1b4-d4c2-4c0c-ae67-79e42ddb7905

	/// Counts distinct downstream dependent measures. Same as 'Dependent Measures Distinct Count - All' — use either interchangeably.
	measure 'Dependent Measures Distinct Count' =
			DISTINCTCOUNTNOBLANK(
			            'Measure Lineage - Dependents'[Dependent Measure Name]
			        )
		formatString: 0
		lineageTag: 190c61eb-0220-4d2b-a7b7-754536ed0630

