		    // Rename resolved ReportID and standardize the AppliedFilter column name
		    #"Renamed Columns" = Table.RenameColumns(#"Removed Columns",{{"Custom", "ReportID"}, {"AppliedFilterVersion", "AppliedFilter"}}),
