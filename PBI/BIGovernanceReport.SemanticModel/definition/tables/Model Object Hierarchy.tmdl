table 'Model Object Hierarchy'
	lineageTag: 577b944f-fd4d-4383-ba91-cd70e869ac92

	/// Counts model objects (measures, columns, hierarchy levels) that are referenced in at least one report. An object is 'Used' if it appears in any visual, filter, or other report element. Filter by 'Model Object Hierarchy'[Object Name] to check if a specific object is used.
	measure 'Used Model Objects' =
			CALCULATE(
			    COUNT(
			        'Model Object Hierarchy'[WorkspaceName - ModelName - ObjectType - TableName - ObjectName]
			    ),
			    KEEPFILTERS(
			        'Model Object Hierarchy'[Object Used Flag] IN { "Used" }
			    ),
			    KEEPFILTERS( 'All Models' )
			)
		formatString: 0
		lineageTag: 6499d632-9a8b-4842-b4c7-5280369caa9e

	/// Counts model objects that are NOT referenced in any report. These objects exist in the model but no report uses them in any visual, filter, or other element. Good candidates for cleanup or deprecation.
	measure 'Unused Model Objects' =
			CALCULATE(
			    COUNT(
			        'Model Object Hierarchy'[WorkspaceName - ModelName - ObjectType - TableName - ObjectName]
			    ),
			    KEEPFILTERS(
			        'Model Object Hierarchy'[Object Used Flag] IN { "Unused" }
			    ),
			    KEEPFILTERS( 'All Models' )
			)
		lineageTag: 5266c82a-361c-4f02-8e42-04fb012135ec

	/// Percentage of model objects that are used in at least one report. Higher is better — 100% means every object in the model is referenced somewhere in reports.
	measure 'Used Model Objects %' =
			DIVIDE(
			    [Used Model Objects],
			    [Unused Model Objects] + [Used Model Objects]
			)
		formatString: #,##0.0 %
		lineageTag: c7450e30-3156-49ec-a4dc-355819190085

	/// Percentage of model objects that are NOT used in any report. A high percentage suggests the model has many unnecessary objects that could be cleaned up.
	measure 'Unused Model Objects %' =
			DIVIDE(
			    [Unused Model Objects],
			    [Unused Model Objects] + [Used Model Objects]
			)
		formatString: #,##0.0 %
		lineageTag: 87678837-23c7-4f65-969c-5e561bfcaf6d

