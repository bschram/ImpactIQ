		    // We need the general usage flags to be at the Model level, not Workspace & Model. Model ID ensures it's still unique to a specific Model but doesn't incorrectly filter out usage based on Workspace. At the Model level, if an object is used anywhere, regardless of workspace, it is used and will affect reports. Exact usage location is via Report detail.
		    #"Removed Duplicates" = Table.Distinct(#"Cleaned Text", {"WorkspaceName - ModelName - ObjectType - TableName - ObjectName"})
