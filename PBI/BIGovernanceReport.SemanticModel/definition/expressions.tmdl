		    // Rename the cleaned name back to WorkspaceName
		    #"Renamed Columns" = Table.RenameColumns(#"Removed Columns",{{"Clean Name", "WorkspaceName"}}),
		    // Add a sequential index for ordering workspaces
		    #"Added Index" = Table.AddIndexColumn(#"Renamed Columns", "Workspace Index", 1, 1, Int64.Type)
		in
