	partition 'All Model Refresh Schedule' = m
		mode: import
		queryGroup: 'Model Layer'
		source =
				let
				    // Load model refresh schedule data from the base query
				    Source = #"Base Power BI Model Refresh Schedule",
				    // Sanitize workspace name using the Clean Name function
				    #"Invoked Custom Function" = Table.AddColumn(Source, "Clean Name", each #"Clean Name"([WorkspaceName]), type text),
				    // Sanitize model (dataset) name using the Clean Name function
				    #"Invoked Custom Function1" = Table.AddColumn(#"Invoked Custom Function", "Clean Name.1", each #"Clean Name"([DatasetName]), type text),
				    // Remove the original unsanitized workspace and dataset name columns
				    #"Removed Columns" = Table.RemoveColumns(#"Invoked Custom Function1",{"WorkspaceName", "DatasetName"}),
				    // Rename sanitized columns and standardize all field names to user-friendly display names
				    #"Renamed Columns" = Table.RenameColumns(#"Removed Columns",{{"Clean Name", "WorkspaceName"}, {"Clean Name.1", "Model Name"}, {"@odata.context", "Schedule Settings URL"}, {"DatasetRefreshScheduleLocalTimeZoneId", "Dataset Refresh Schedule Local Time Zone"}, {"DatasetRefreshScheduleNotifyOption", "Dataset Refresh Schedule Notify Option"}, {"DatasetRefreshScheduleEnabled", "Dataset Refresh Schedule Enabled"}, {"WorkspaceId", "Workspace ID"}, {"DatasetId", "Model ID"}, {"DatasetRefreshScheduleDay", "Dataset Refresh Schedule Day"}, {"DatasetRefreshScheduleTime", "Dataset Refresh Schedule Time"}}),
				    // Remove original workspace columns (will be resolved via Workspace & Model Mapping)
				    #"Removed Columns1" = Table.RemoveColumns(#"Renamed Columns",{"Workspace ID", "WorkspaceName"}),
				    // Pre-filter Workspace & Model Mapping to home workspace only (prevents fan-out duplication and memory explosion)
				    #"Merged Queries" = Table.NestedJoin(#"Removed Columns1", {"Model ID"}, Table.SelectRows(#"Workspace & Model Mapping", each [Model in Workspace Flag] = "TRUE"), {"Model ID"}, "Workspace & Model Mapping", JoinKind.LeftOuter),
				    // Expand workspace name, ID, and model home workspace from the mapping
				    #"Expanded Workspace & Model Mapping" = Table.ExpandTableColumn(#"Merged Queries", "Workspace & Model Mapping", {"Model in Workspace Flag", "Workspace Name", "Workspace ID", "Model Home Workspace Name"}, {"Model in Workspace Flag", "WorkspaceName", "Workspace ID", "Model Home Workspace Name"}),
				    // Apply proper casing to the Enabled flag (e.g., "true" → "True")
				    #"Cleaned Text" = Table.TransformColumns(#"Expanded Workspace & Model Mapping",{{"Dataset Refresh Schedule Enabled", Text.Proper, type text}}),
				    // Create a composite key combining workspace and model names
				    #"Added Custom" = Table.AddColumn(#"Cleaned Text", "Workspace Name - Model Name", each [WorkspaceName]&" - "&[Model Name], type text),
				    // Create a composite key combining workspace name and model ID
				    #"Added Custom1" = Table.AddColumn(#"Added Custom", "Workspace Name - Model ID", each [WorkspaceName]&" - "&[Model ID], type text),
				    // Create a unique refresh schedule ID combining workspace, model, day, time, and timezone
				    #"Added Custom2" = Table.AddColumn(#"Added Custom1", "UniqueRefreshScheduleID", each [WorkspaceName]&" - "&[Model ID]&" - "&[Dataset Refresh Schedule Day]&" - "& Text.From([Dataset Refresh Schedule Time])&" - "&[Dataset Refresh Schedule Local Time Zone], type text),
				    // Calculate the UTC timezone offset based on the local timezone name
				    #"Added Conditional Column" = Table.AddColumn(#"Added Custom2", "UTC Timezone Offset", each if [Dataset Refresh Schedule Local Time Zone] = "Pacific Standard Time" then -8 else if [Dataset Refresh Schedule Local Time Zone] = "UTC" then 0 else if [Dataset Refresh Schedule Local Time Zone] = "Mountain Standard Time" then -7 else if [Dataset Refresh Schedule Local Time Zone] = "Central Standard Time" then -6 else if [Dataset Refresh Schedule Local Time Zone] = "Eastern Standard Time" then -5 else if [Dataset Refresh Schedule Local Time Zone] = "Pacific Daylight Time" then -7 else if [Dataset Refresh Schedule Local Time Zone] = "Mountain Daylight Time" then -6 else if [Dataset Refresh Schedule Local Time Zone] = "Central Daylight Time" then -5 else if [Dataset Refresh Schedule Local Time Zone] = "Eastern Daylight Time" then -4 else 0, type number),
				    // Convert the local scheduled time to UTC using the timezone offset
				    #"Added Custom3" = Table.AddColumn(
				    #"Added Conditional Column",
				    "UTC Scheduled Time",
				    each [Dataset Refresh Schedule Time] + #duration(0, [UTC Timezone Offset], 0, 0), type time),
				    // Set the CST timezone offset constant (-6 hours from UTC)
				    #"Added Custom4" = Table.AddColumn(#"Added Custom3", "CST Timezone Offset", each -6, type number),
				    // Convert the UTC scheduled time to CST using the CST offset
				    #"Added Custom5" = Table.AddColumn(
				    #"Added Custom4",
				    "CST Scheduled Time",
				    each [UTC Scheduled Time] - #duration(0, [CST Timezone Offset], 0, 0), type time),
				    // Remove the temporary timezone offset columns
				    #"Removed Columns2" = Table.RemoveColumns(#"Added Custom5",{"UTC Timezone Offset", "CST Timezone Offset"}),
				    #"Replaced Value" = Table.ReplaceValue(#"Removed Columns2",null,"TRUE",Replacer.ReplaceValue,{"Model in Workspace Flag"})
				in
				    #"Replaced Value"

