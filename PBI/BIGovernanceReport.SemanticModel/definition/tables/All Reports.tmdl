table 'All Reports'
	lineageTag: 0593a271-895e-4bab-a216-85c82ad1ef55

	/// Counts distinct bookmarks defined across reports. Bookmarks capture a saved state of a report page including filters, slicers, and visual visibility.
	measure 'Bookmark Distinct Count' =
			CALCULATE(
			    DISTINCTCOUNTNOBLANK( 'All Reports'[Bookmark ID] ),
			    KEEPFILTERS( 'All Reports'[Visual Object Category] IN { "Bookmarks" } ),
			    REMOVEFILTERS( 'Report Hierarchy'[Page Hidden Flag] )
			)
		formatString: #,##0
		lineageTag: 4634e546-0fe3-49cc-824e-d12aa5f88a4b

	/// Counts drillthrough filter instances that use measures. Drillthrough pages allow users to navigate to a detail page filtered by a specific context.
	measure 'Drillthrough Measure Count' =
			CALCULATE(
			    [Filter Count],
			    KEEPFILTERS(
			        'All Reports'[Filter Type Group] IN { "Drillthrough Measure" }
			    )
			)
		formatString: #,##0
		lineageTag: f18fd106-098c-440e-85b2-045642329776

	/// Counts distinct measures used in drillthrough filters. Identifies which measures enable drillthrough navigation on report pages.
	measure 'Drillthrough Measure Distinct Count' =
			CALCULATE(
			    [Filter Distinct Count],
			    KEEPFILTERS(
			        'All Reports'[Filter Type Group] IN { "Drillthrough Measure" }
			    )
			)
		formatString: #,##0
		lineageTag: 7cfe25de-24ab-450d-be92-a0e53b8fa19d

	/// Total filter count as of the earliest snapshot date. Used for trend comparison to see how filter usage has changed over time.
	measure 'Filter Count - Earliest Report' =
			VAR EarliestDate =
			    CALCULATE(
			        MIN( 'PBI Snapshot Date'[PBI Snapshot Date] ),
			        REMOVEFILTERS( 'PBI Snapshot Date' )
			    )
			RETURN
			    CALCULATE(
			        [Filter Count],
			        'PBI Snapshot Date'[PBI Snapshot Date] = EarliestDate
			    )
		formatString: #,##0
		lineageTag: 60b2aa52-5487-4d30-bf6b-b80e6b98f18f

	/// Counts page-level filter instances that are actively applied (not just defined). Only counts filters that are currently filtering data on the page.
	measure 'Filter Count - Page Filters (Applied)' =
			CALCULATE(
			    [Filter Count - Page Filters],
			    KEEPFILTERS( 'All Reports'[Applied Filter] IN { "True" } )
			)
		formatString: #,##0
		lineageTag: 5c715b6e-1f11-4471-b655-b54ae611cb66

