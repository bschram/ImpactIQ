				     // Bring back the non-measure Model Detail so all keys are in this table. This enabls us to create a 1-to-1 Bi-Directional Relationship with the Model Object Hierarchy for better interactivity on the Lineage visuals.  If this isn't done, using the Report Hierarchy will filter out all objects except for measures.
				    #"Appended Query" = Table.Combine({#"Added Conditional Column3", NonMeasures}),
