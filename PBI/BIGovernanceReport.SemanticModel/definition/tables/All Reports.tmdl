	/// Counts the distinct visuals (charts, tables, cards, slicers, etc.) that reference a specific object. When a user asks "how many visuals use Total Sales?" or "which visuals would break if I remove Revenue?", filter 'Model Object Hierarchy'[Object Name] to the name the user provided. The Object Name column holds the actual names of measures, columns, calculated columns, hierarchy levels, etc. — do not search for type keywords like "measure" or "column". Only counts visual objects, not filters or bookmarks.
	measure 'Visual Distinct Count (Visual Impact)' =
			CALCULATE(
			    DISTINCTCOUNTNOBLANK('All Reports'[Workspace Name - Report Name - Page Name - Visual ID]),
			    KEEPFILTERS(
			        'All Reports'[Visual Object Category] IN { "Visual Objects" }
			    ))
		formatString: #,##0
		lineageTag: 095455c1-05f0-493b-bdaa-2106f62bee62

	/// Counts total visual objects (the individual fields placed on visuals like axes, values, legends, tooltips). This includes every placement of every object across all visuals. Filter by 'Model Object Hierarchy'[Object Name] to count how many times a specific object appears on visuals.
	measure 'Visual Objects Count' =
			CALCULATE(
			    [Report Objects Count],
			    KEEPFILTERS(
			        'All Reports'[Visual Object Category] IN { "Visual Objects" }
			    )
			)
		formatString: #,##0
		lineageTag: 76d1fa15-fc08-4746-ba2a-0e176bf65960

	/// Counts distinct objects placed on visuals. Each unique object name is counted once regardless of how many visuals use it.
	measure 'Visual Objects Distinct Count' =
			CALCULATE(
			    [Report Objects Distinct Count],
			    KEEPFILTERS(
			        'All Reports'[Visual Object Category] IN { "Visual Objects" }
			    )
			)
		formatString: #,##0
		lineageTag: e7b52202-9aa0-4f08-a5d5-b0678bd0cf70

	/// Total usage count across all currently selected objects. Used as denominator for the per-object percentage breakdown.
	measure 'Report Objects Count - All Selected Objects' =
			CALCULATE(
			    [Report Objects Count],
			    ALLSELECTED( 'Model Object Hierarchy'[Object Name] ), ALLSELECTED('Model Object Hierarchy'[Table Name])
			)
		formatString: #,##0
		lineageTag: cbe71cec-546a-4ea2-b20d-add8eeed0181

	/// Percentage of total usage that the current object represents relative to all selected objects. Helps rank which objects are used the most.
	measure 'Report Objects Count % - Selected Objects' =
			DIVIDE(
			    [Report Objects Count],
			    [Report Objects Count - All Selected Objects]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 5ea4a76f-8adf-4821-a307-c8680c66337b

	/// Total usage count across all objects (ignoring object-level filters). Used as denominator for object-level percentage calculations.
	measure 'Report Objects Count - All Objects' =
			CALCULATE(
			    [Report Objects Count],
			    REMOVEFILTERS(
			        'Model Object Hierarchy'[WorkspaceName - ModelName - ObjectType - TableName - ObjectName]
			    )
			)
		formatString: #,##0
		lineageTag: 9ec21362-2515-478f-b7ca-44cf5e16e491

	/// Total usage count across all currently selected reports. Used as denominator for per-report percentage.
	measure 'Report Objects Count - All Selected Reports' =
			CALCULATE(
			    [Report Objects Count],
			    ALLSELECTED(
			        'Report Hierarchy'[Workspace Name - Report Name]
			    )
			)
		formatString: #,##0
		lineageTag: 0bd93c63-334d-4887-8e1f-c9125d86f042

	/// Total usage count across all currently selected pages. Used as denominator for per-page percentage.
	measure 'Report Objects Count - All Selected Pages' =
			CALCULATE(
			    [Report Objects Count],
			    ALLSELECTED(
			        'Report Hierarchy'[Workspace Name - Report Name - Page Name]
			    )
			)
		formatString: #,##0
		lineageTag: d3e36681-d6f8-4619-8dd0-df568f073dd5

	/// Percentage of total usage that the current page represents relative to all selected pages.
	measure 'Report Objects Count % - Selected Pages' =
			DIVIDE(
			    [Report Objects Count],
			    [Report Objects Count - All Selected Pages]
			)
		formatString: 0%;-0%;0%
		lineageTag: 188ea205-963c-4bd1-a6d7-d0877debc4f6

	/// Percentage of total usage that the current report represents relative to all selected reports.
	measure 'Report Objects Count % - Selected Reports' =
			DIVIDE(
			    [Report Objects Count],
			    [Report Objects Count - All Selected Reports]
			)
		formatString: 0%;-0%;0%
		lineageTag: f1745459-a418-4009-9d62-9a0beedca992

	/// Weighted score that ranks how heavily an object is used across the reporting environment. Factors in: workspace breadth (10x), model spread (8x), report-level filters (6x), report count (5x), page-level filters (4x), page count (3x), visual count (1x), visual filters (0.5x). Higher score = more impactful object. Hidden pages receive a 0.6 multiplier. Filter by 'Model Object Hierarchy'[Object Name] to see a specific object's impact score.
	measure 'Report Object Weighted Usage Score' = ```
			VAR VisualFilters = [Filter Count - Visual Filters] * 0.5
			VAR Visuals = [Visual Distinct Count (Visual Impact)] * 1
			VAR Page = [Page Distinct Count (Visual Impact)] * 3
			VAR PageFilter = [Filter Count - Page Filters] * 4
			VAR Report = [Report Distinct Count (Visual Impact)] * 5
			VAR ReportFilter = [Filter Count - Report Filters] * 6
			VAR ModelsCount = [Model Distinct Count (Visual Impact)] * 8
			VAR Workspace = [Workspace Distinct Count (Visual Impact)] * 10
			VAR RptMeasures = [Report Objects Count - Measure] * 1
			VAR RptCol = [Report Objects Count - Column] * 0.75
			VAR RptAllElse = [Report Objects Count - All Else] * 0.5
			VAR RptObjectsAll = RptMeasures + RptCol + RptAllElse
			VAR HiddenPage = MAX('Report Hierarchy'[Page Hidden Flag])
			VAR InitialScore = 
			    ( VisualFilters + Visuals + Page + PageFilter + Report
			        + ReportFilter
			        + ModelsCount
			        + Workspace )
			        * RptObjectsAll
			VAR AdjustedScore = InitialScore * 0.6
			RETURN
			SWITCH(TRUE(), HiddenPage = "True", AdjustedScore, InitialScore)
			```
		formatString: #,##0
		lineageTag: d6738f99-c951-4b97-aaea-80a4276c54f2

		annotation PBI_FormatHint = {"isCustom":true}

	/// Rank position based on the Weighted Usage Score. Rank 1 = the most heavily used object. Context-aware: ranks within reports when at report level, within pages when at page level, or within objects when at object level.
	measure 'Report Object Weighted Usage Rank' =
			VAR HasWorkspaceContext =
			    ISINSCOPE( 'Report Hierarchy'[Workspace Name] )
			        && ISINSCOPE( 'Report Hierarchy'[Report Name] )
			VAR HasReportContext =
			    ISINSCOPE( 'Report Hierarchy'[Report Name] )
			        && ISINSCOPE( 'Report Hierarchy'[Page Name] )
			VAR HasObjectContext =
			    ISINSCOPE( 'All Reports'[Table Name - Visual Layer] )
			        && ISINSCOPE( 'All Reports'[Object Name - Visual Layer] )
			        && ISINSCOPE( 'All Reports'[Object Type - Visual Layer] )
			VAR WeightedScore = [Report Object Weighted Usage Score]
			VAR RankResult =
			    SWITCH(
			        TRUE( ),
			        HasWorkspaceContext,
			            RANK(
			                SKIP,
			                ALLSELECTED(
			                    'Report Hierarchy'[Workspace Name],
			                    'Report Hierarchy'[Report Name]
			                ),
			                ORDERBY(
			                    IF(
			                        ISBLANK( [Report Objects Count] ),
			                        BLANK( ),
			                        [Report Object Weighted Usage Score]
			                    ),
			                    DESC
			                ),
			                LAST
			            ),
			        HasReportContext,
			            RANK(
			                SKIP,
			                ALLSELECTED(
			                    'Report Hierarchy'[Report Name],
			                    'Report Hierarchy'[Page Name]
			                ),
			                ORDERBY(
			                    IF(
			                        ISBLANK( [Report Objects Count] ),
			                        BLANK( ),
			                        [Report Object Weighted Usage Score]
			                    ),
			                    DESC
			                ),
			                LAST
			            ),
			        HasObjectContext,
			            RANK(
			                SKIP,
			                ALLSELECTED(
			                    'All Reports'[Table Name - Visual Layer],
			                    'All Reports'[Object Name - Visual Layer],
			                    'All Reports'[Object Type - Visual Layer]
			                ),
			                ORDERBY(
			                    IF(
			                        ISBLANK( [Report Objects Count] ),
			                        BLANK( ),
			                        [Report Object Weighted Usage Score]
			                    ),
			                    DESC
			                ),
			                LAST
			            ),
			        BLANK( )  -- Default if none of the contexts are present
			    )
			RETURN
			    SWITCH(
			        TRUE( ),
			        WeightedScore = BLANK( ), BLANK( ),
			        RankResult
			    )
		formatString: #,##0
		lineageTag: 867f9efc-758f-491d-8230-30069b765088

		annotation PBI_FormatHint = {"isCustom":true}

	/// Counts distinct hierarchy levels referenced across reports.
	measure 'Report Objects Distinct Count - Hierarchy Level' =
			CALCULATE(
			    [Report Objects Distinct Count],
			    KEEPFILTERS( 'Model Object Hierarchy'[Object Type] IN { "Hierarchy Level" } )
			)
		formatString: #,##0
		lineageTag: 82e1eb91-d4d2-4e47-9e2c-daef4b940523

	/// Counts distinct tables that have at least one object referenced in reports.
	measure 'Report Objects Distinct Count - Table' =
			DISTINCTCOUNTNOBLANK(
			    'All Reports'[Workspace Name - Model ID - Table Name]
			)
		formatString: #,##0
		lineageTag: 2431b545-dfc7-4336-a086-75b53a1c9af3

	/// Counts only measure-type object usages across reports. Shows how many times measures (not columns or hierarchies) are placed on visuals, used in filters, etc.
	measure 'Report Objects Count - Measure' =
			CALCULATE(
			    [Report Objects Count],
			    KEEPFILTERS(
			        'Model Object Hierarchy'[Object Type] IN { "Measure" }
			    )
			)
		formatString: 0
		lineageTag: 507ca52e-7e2b-4206-9362-de626de297e1

	/// Counts only column-type object usages across reports. Shows how many times columns (not measures or hierarchies) are placed on visuals, used in filters, etc.
	measure 'Report Objects Count - Column' =
			CALCULATE(
			    [Report Objects Count],
			    KEEPFILTERS(
			        'Model Object Hierarchy'[Object Type] IN { "Column" }
			    )
			)
		formatString: 0
		lineageTag: a0e000c9-9c4c-48e3-baa5-89a2b63161c2

	/// Counts object usages that are neither columns nor measures (e.g. hierarchy levels, calculation groups). Used in the weighted usage score calculation.
	measure 'Report Objects Count - All Else' =
			CALCULATE(
			    [Report Objects Count],
			    KEEPFILTERS(
			        'Model Object Hierarchy'[Object Type] <> "Column"
			    ),
			    KEEPFILTERS(
			        'Model Object Hierarchy'[Object Type] <> "Measure"
			    )
			)
		formatString: 0
		lineageTag: 9256a933-2f38-4f0a-bc3f-1afd665f1ccf

	/// Generates an SVG wireframe visualization showing the layout of visuals on a report page. Each visual is rendered as a positioned rectangle matching its actual size and position on the canvas. Used for visual page layout inspection, not for object usage analysis.
	measure 'Visual Wireframe SVG' =
			VAR pageW = ROUND( AVERAGE( 'All Reports'[Page Width] ), 0 )
			VAR pageH = ROUND( AVERAGE( 'All Reports'[Page Height] ), 0 )
			VAR visualCategory =
			    SELECTEDVALUE( 'All Reports'[Visual Object Category] )
			
			/* ────────────── 1️⃣  Special case: Report / Page Filters ────────────── */
			VAR filterPaneSVG =
			    IF(
			        visualCategory IN { "Report Filters", "Page Filter" },
			        "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 "
			            & pageW
			            & " "
			            & pageH
			            & "' preserveAspectRatio='xMidYMid meet' width='100%' height='100%'>"
			            & "<rect x='0' y='0' width='"
			            & pageW
			            & "' height='"
			            & pageH
			            & "' fill='#999999' />"
			            & "<text x='"
			            & ROUND( pageW / 2, 0 )
			            & "' y='"
			            & ROUND( pageH / 2, 0 )
			            & "' text-anchor='middle' dominant-baseline='middle' "
			            & "font-size='"
			            & MIN( 60, MAX( 20, ROUND( pageH * 0.08, 0 ) ) )
			            & "' font-family='Segoe UI' fill='white'>"
			            & IF(
			                visualCategory = "Report Filters",
			                "Report Filter -> Filter Pane",
			                "Page Filter -> Filter Pane"
			            )
			            & "</text></svg>",
			        BLANK( )
			    )
			VAR blankPaneSVG =
			    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 "
			        & pageW
			        & " "
			        & pageH
			        & "' preserveAspectRatio='xMidYMid meet' width='100%' height='100%'>"
			        & "<rect x='0' y='0' width='"
			        & pageW
			        & "' height='"
			        & pageH
			        & "' fill='#999999' />"
			        & "<text x='"
			        & ROUND( pageW / 2, 0 )
			        & "' y='"
			        & ROUND( pageH / 2, 0 )
			        & "' text-anchor='middle' dominant-baseline='middle' "
			        & "font-size='"
			        & MIN( 60, MAX( 20, ROUND( pageH * 0.08, 0 ) ) )
			        & "' font-family='Segoe UI' fill='white'>"
			        & "There is no visual wireframe"
			        & "</text></svg>"
			VAR blankPageselection =
			    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1270 650' preserveAspectRatio='xMidYMid meet' width='100%' height='100%'>"
			        & "<rect x='0' y='0' width='1270' height='650' fill='#999999' />"
			        & "<text x='635' y='325' text-anchor='middle' dominant-baseline='middle' "
			        & "font-size='40' font-family='Segoe UI' fill='white'>"
			        & "Choose a Report and Page to view the Page Layout / Wireframe"
			        & "</text></svg>"
			
			/* ────────────── 2️⃣  Normal visuals (wireframe layout) ────────────── */
			VAR viewBox =
			    IF(
			        HASONEVALUE( 'All Reports'[Page Name] ),
			        "viewBox='0 0 " & pageW & " " & pageH
			            & "' preserveAspectRatio='xMidYMid meet' width='100%' height='100%'",
			        BLANK( )
			    )
			        & ">"
			VAR background =
			    "<rect x='0' y='0' width='" & pageW & "' height='" & pageH
			        & "' fill='#dbdbdb' stroke='black' stroke-width='0.2' vector-effect='non-scaling-stroke' />"
			VAR rectangles =
			    CONCATENATEX(
			        'All Reports',
			        VAR x = ROUND( 'All Reports'[Visual X Position], 0 )
			        VAR y = ROUND( 'All Reports'[Visual Y Position], 0 )
			        VAR w = ROUND( 'All Reports'[Visual Width], 0 )
			        VAR h = ROUND( 'All Reports'[Visual Height], 0 )
			        VAR cat =
			            SELECTEDVALUE( 'All Reports'[Visual Object Category] )
			        VAR fillColor =
			            IF( cat = "Visual Filters", "#E19490", "#A48CDA" )
			        VAR rect =
			            "<rect x='" & x & "' y='" & y & "' width='" & w
			                & "' height='"
			                & h
			                & "' fill='"
			                & fillColor
			                & "' stroke='black' stroke-width='0.2' vector-effect='non-scaling-stroke' />"
			
			        /* 🧠 Dynamically scale font size based on height, clamped to 10–60 */
			        VAR dynFont = MIN( 60, MAX( 10, ROUND( h * 0.40, 0 ) ) )
			        VAR label =
			            IF(
			                cat = "Visual Filters",
			                "<text x='" & ( x + w / 2 ) & "' y='" & ( y + h / 2 )
			                    & "' text-anchor='middle' dominant-baseline='middle' "
			                    & "font-size='"
			                    & dynFont
			                    & "' font-family='Segoe UI' fill='white'>Filter Pane</text>",
			                BLANK( )
			            )
			        RETURN
			            rect & label,
			        "",
			        'All Reports'[Visual Z Position]
			    )
			VAR svgWireframe =
			    IF(
			        LEN( rectangles ) > 0,
			        "<svg xmlns='http://www.w3.org/2000/svg' " & viewBox
			            & background
			            & rectangles
			            & "</svg>",
			        BLANK( )
			    )
			
			/* ────────────── 3️⃣  Final return ────────────── */
			VAR ReportObject = [Report Objects Count]
			VAR PageSelection =
			    SELECTEDVALUE( 'Report Hierarchy'[Page Name] )
			RETURN
			    SWITCH(
			        TRUE( ),
			        ISBLANK( PageSelection ), blankPageselection,
			        visualCategory IN { "Report Filters", "Page Filter" }, filterPaneSVG,
			        ISBLANK( pageW ), blankPaneSVG,
			        svgWireframe
			    )
		lineageTag: e59b4bc8-e55a-48fa-8e4f-294251a487b2

