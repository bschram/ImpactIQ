expression UsedinRLS =
		let
		    // Load the full semantic model detail from the base query
		    Source = #"Base Semantic Models",
		    // Rename columns to standardized field names for consistency
		    #"Renamed Columns" = Table.RenameColumns(Source,{{"Name", "Object Name"}, {"Type", "Object Type"}, {"Table", "Table Name"}, {"IsHidden", "Is Hidden"}, {"DisplayFolder", "Display Folder"}, {"FormatString", "Format String"}}),
		    // Keep only relationship objects
		    #"Filtered Rows" = Table.SelectRows(#"Renamed Columns", each [Object Type] = "RLSFilter"),
		    #"Invoked Custom Function" = Table.AddColumn(#"Filtered Rows", "RLS Expression Parsing", each #"RLS Expression Parsing"([Expression])),
		    #"Expanded RLS Expression Parsing1" = Table.ExpandTableColumn(#"Invoked Custom Function", "RLS Expression Parsing", {"Table", "Column", "Measure"}, {"Table", "Column", "Measure"}),
		    #"Unpivoted Columns" = Table.UnpivotOtherColumns(#"Expanded RLS Expression Parsing1", {"Object Type", "Table Name", "Object Name", "Format String", "Display Folder", "Description", "Is Hidden", "TableStorageMode", "Expression", "ModelAsOfDate", "WorkspaceName", "ModelName", "OriginalModelID", "RelationshipFromTable", "RelationshipFromColumn", "RelationshipToTable", "RelationshipToColumn", "RelationshipStatus", "RelationshipFromCardinality", "RelationshipToCardinality", "RelationshipCrossFilteringBehavior", "ModelID"}, "Attribute", "Value"),
		    #"Changed Type" = Table.TransformColumnTypes(#"Unpivoted Columns",{{"Value", type text}}),
		    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Object Name", "Object Type"}),
		    #"Renamed Columns2" = Table.RenameColumns(#"Removed Columns",{{"Attribute", "Object Type"}, {"Value", "Object Name"}}),
		    #"Removed Other Columns" = Table.SelectColumns(#"Renamed Columns2",{"Table Name", "Object Name", "Object Type", "WorkspaceName", "ModelName", "ModelID"}),
		    // Create a workspace-model-object composite key for cross-workspace lookups
		    #"Added Custom" = Table.AddColumn(#"Removed Other Columns", "WorkspaceName - ModelName - ObjectType - TableName - ObjectName", each [WorkspaceName]&" - "&[ModelName]&" - "&[Object Type]&" - "&[Table Name]&" - "&[Object Name], type text),
		    // Create a model-level composite key using ModelID for unique object identification
		    #"Added Custom1" = Table.AddColumn(#"Added Custom", "ModelID - ObjectType - TableName - ObjectName", each [ModelID]&" - "&[Object Type]&" - "&[Table Name]&" - "&[Object Name], type text),
