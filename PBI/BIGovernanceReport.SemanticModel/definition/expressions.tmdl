		    #"Added Custom1" = Table.AddColumn(#"Renamed Columns", "Category", each "Bookmarks", type text),
		    // Set filter flag to N/A as bookmarks are not filters
		    #"Added Custom2" = Table.AddColumn(#"Added Custom1", "Filter?", each "N/A", type text),
		    // Rename columns to standardized bookmark field names
		    #"Renamed Columns1" = Table.RenameColumns(#"Added Custom2",{{"Id", "BookmarkId"}, {"VisualHiddenFlag", "BookmarkVisualHiddenFlag"}, {"Name", "BookmarkName"}, {"PageId", "PageID"}}),
		    // Create a unique page identifier for page-level joins
		    #"Added Custom3" = Table.AddColumn(#"Renamed Columns1", "UniquePageID", each [WorkspaceName]&" - "&[ReportID]&" - "&[ModelID]&" - "&[PageID], type text),
		    // Create a composite key for page-level navigation
		    #"Added Custom4" = Table.AddColumn(#"Added Custom3", "Workspace Name - Report Name - Page Name", each [WorkspaceName]&" - "&[ReportName]&" - "&[PageName], type text),
		    // Create a composite key for visual-level navigation within pages
		    #"Added Custom5" = Table.AddColumn(#"Added Custom4", "Workspace Name - Report Name - Page Name - Visual ID", each [WorkspaceName]&" - "&[ReportName]&" - "&[PageName]&" - "&[VisualId], type text),
		    // Add a sequential index for row ordering
		    #"Added Index" = Table.AddIndexColumn(#"Added Custom5", "Index", 1, 1, Int64.Type),
		    // Inner join with Pages to keep only bookmarks that belong to valid pages
		    #"Merged Queries" = Table.NestedJoin(#"Added Index", {"UniquePageID"}, Pages, {"UniquePageID"}, "Pages", JoinKind.Inner),
		    // Remove the expanded Pages table column (only used for filtering via inner join)
		    #"Removed Columns1" = Table.RemoveColumns(#"Merged Queries",{"Pages"})
		in
		    #"Removed Columns1"
