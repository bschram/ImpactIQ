				                    extractedText = if startPos <> -1 then 
				                        Text.BetweenDelimiters(Text.Middle(text, startPos), "dataflowId=""", """")
				                    else 
				                        null
				                in
				                    extractedText, type text),
				    // Extract the Dataflow entity (query) name from the partition Expression
