	partition 'All Dataflow Refresh History' = m
		mode: import
		queryGroup: 'Dataflow Layer'
		source = ```
				let
				    // Load dataflow refresh history from the base query
				    Source = #"Base Dataflow Refresh History",
				    // Sanitize workspace name using the Clean Name function
				    #"Invoked Custom Function" = Table.AddColumn(Source, "Clean Name", each #"Clean Name"([WorkspaceName]), type text),
				    // Sanitize dataflow name using the Clean Name function
				    #"Invoked Custom Function1" = Table.AddColumn(#"Invoked Custom Function", "Clean Name.1", each #"Clean Name"([DataflowName]), type text),
				    // Remove the original unsanitized workspace and dataflow name columns
				    #"Removed Columns" = Table.RemoveColumns(#"Invoked Custom Function1",{"WorkspaceName", "DataflowName"}),
				    // Rename the sanitized columns back to their original names
				    #"Renamed Columns" = Table.RenameColumns(#"Removed Columns",{{"Clean Name", "WorkspaceName"}, {"Clean Name.1", "DataflowName"}}),
				    // Keep only the essential refresh history columns
				  #"Removed Other columns" = Table.SelectColumns(#"Renamed Columns", {"WorkspaceName", "WorkspaceId", "DataflowName", "DataflowId", "DataflowRefreshRequestId", "DataflowRefreshId", "DataflowRefreshStartTime", "DataflowRefreshEndTime", "DataflowRefreshType", "DataflowRefreshStatus"}),
				    // Create a composite key combining workspace and dataflow names
				    #"Added Custom" = Table.AddColumn(#"Removed Other columns", "Workspace Name - Dataflow Name", each [WorkspaceName]&" - "&[DataflowName], type text),
				    // Rename all columns to user-friendly display names
				  #"Renamed Columns1" = Table.RenameColumns(#"Added Custom", {{"DataflowId", "Dataflow ID"}, {"DataflowRefreshRequestId", "Refresh Request ID"}, {"DataflowRefreshId", "Refresh ID"}, {"DataflowRefreshStartTime", "Refresh Start Time"}, {"DataflowRefreshEndTime", "Refresh End Time"}, {"DataflowRefreshType", "Refresh Type"}, {"DataflowRefreshStatus", "Refresh Status"}, {"WorkspaceName", "Workspace Name"}, {"DataflowName", "Dataflow Name"}, {"WorkspaceId", "Workspace ID"}}),
				    // Calculate refresh duration in HH:MM:SS format from start and end times
				    #"Added Custom1" = Table.AddColumn(#"Renamed Columns1", "Refresh Duration (HH:MM:SS)", each let
				            Duration = [Refresh End Time] - [Refresh Start Time],
				            TotalSeconds = Duration.TotalSeconds(Duration),
				            Hours = Number.IntegerDivide(TotalSeconds, 3600),
				            Minutes = Number.IntegerDivide(TotalSeconds - (Hours * 3600), 60),
				            Seconds = Number.Round(TotalSeconds - (Hours * 3600) - (Minutes * 60), 0),
				            DurationFormatted = Text.PadStart(Text.From(Hours), 2, "0") & ":" & 
				                                Text.PadStart(Text.From(Minutes), 2, "0") & ":" & 
				                                Text.PadStart(Text.From(Seconds), 2, "0")
				        in
				            DurationFormatted, type text),
				    // Replace status code "22" with human-readable "Failed" label
				    #"Replaced Value" = Table.ReplaceValue(#"Added Custom1","22","Failed",Replacer.ReplaceValue,{"Refresh Status"})
				in
				    #"Replaced Value"
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

