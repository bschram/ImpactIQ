	partition 'Power BI Environment Information' = m
		mode: import
		queryGroup: 'Environment Information'
		source =
				let
				    // Load workspace data from the Power BI Workspaces query
				    Source = #"Power BI Workspaces",
				    // Join with Power BI Datasets to bring in model (dataset) information per workspace
				    #"Merged Queries" = Table.NestedJoin(Source, {"WorkspaceId"}, #"Power BI Datasets", {"WorkspaceId"}, "Power BI Datasets", JoinKind.LeftOuter),
				    // Expand all dataset columns: IDs, names, configuration, storage, and composite keys
				    #"Expanded Power BI Datasets" = Table.ExpandTableColumn(#"Merged Queries", "Power BI Datasets", {"DatasetId", "DatasetName", "DatasetDescription", "DatasetAddRowsAPIEnabled", "DatasetConfiguredBy", "DatasetIsRefreshable", "DatasetIsEffectiveIdentityRequired", "DatasetIsEffectiveIdentityRolesRequired", "DatasetIsOnPremGatewayRequired", "DatasetTargetStorageMode", "DatasetCreatedDate", "DatasetQueryScaleOutSettings", "Dataset Index", "Workspace Name - Model Name"}, {"DatasetId", "DatasetName", "DatasetDescription", "DatasetAddRowsAPIEnabled", "DatasetConfiguredBy", "DatasetIsRefreshable", "DatasetIsEffectiveIdentityRequired", "DatasetIsEffectiveIdentityRolesRequired", "DatasetIsOnPremGatewayRequired", "DatasetTargetStorageMode", "DatasetCreatedDate", "DatasetQueryScaleOutSettings", "Dataset Index", "Workspace Name - Model Name"}),
				    // Join with Power BI Reports to bring in report information per dataset
				    #"Merged Queries1" = Table.NestedJoin(#"Expanded Power BI Datasets", {"DatasetId"}, #"Power BI Reports", {"DatasetId"}, "Power BI Reports", JoinKind.LeftOuter),
				    // Expand report columns: IDs, names, types, ownership, and composite keys
				    #"Expanded Power BI Reports" = Table.ExpandTableColumn(#"Merged Queries1", "Power BI Reports", {"DatasetWorkspaceId", "ReportId", "ReportName", "ReportDescription", "ReportType", "ReportFormat", "ReportIsFromPbix", "ReportIsOwnedByMe", "Workspace - Report Name", "Report Index"}, {"DatasetWorkspaceId", "ReportId", "ReportName", "ReportDescription", "ReportType", "ReportFormat", "ReportIsFromPbix", "ReportIsOwnedByMe", "Workspace - Report Name", "Report Index"}),
				    // Join with Power BI Pages to bring in page-level information per report
				    #"Merged Queries2" = Table.NestedJoin(#"Expanded Power BI Reports", {"ReportId"}, #"Power BI Pages", {"ReportId"}, "Power BI Workspaces", JoinKind.LeftOuter),
				    // Expand page columns: page ID, display name, and order
				    #"Expanded Power BI Pages" = Table.ExpandTableColumn(#"Merged Queries2", "Power BI Workspaces", {"PageId", "PageDisplayName", "PageOrder"}, {"PageId", "PageDisplayName", "PageOrder"}),
				    // Create a 1-based page order index from the 0-based PageOrder value
				    #"Added Custom" = Table.AddColumn(#"Expanded Power BI Pages", "Page Order Index", each [PageOrder]+1, Int64.Type),
				    // Sort by workspace index, then report index, then page order for logical hierarchy
				    #"Sorted Rows" = Table.Sort(#"Added Custom",{{"Workspace Index", Order.Ascending}, {"Report Index", Order.Ascending}, {"Page Order Index", Order.Ascending}}),
				    // Add a sequential index for app sort ordering
				    #"Added Index" = Table.AddIndexColumn(#"Sorted Rows", "App Sort Order", 1, 1, Int64.Type),
				    // Join with Power BI Apps to bring in app information per workspace
				    #"Merged Queries3" = Table.NestedJoin(#"Added Index", {"WorkspaceId"}, #"Power BI Apps", {"AppWorkspaceId"}, "Power BI Apps", JoinKind.LeftOuter),
				    // Expand app columns: description, ID, last update, name, published by, workspace ID
				    #"Expanded Power BI Apps" = Table.ExpandTableColumn(#"Merged Queries3", "Power BI Apps", {"AppDescription", "AppId", "AppLastUpdate", "AppName", "AppPublishedBy", "AppWorkspaceId"}, {"AppDescription", "AppId", "AppLastUpdate", "AppName", "AppPublishedBy", "AppWorkspaceId"}),
				    // Join with Power BI Dataflows to bring in dataflow information per workspace
				    #"Merged Queries4" = Table.NestedJoin(#"Expanded Power BI Apps", {"WorkspaceId"}, #"Power BI Dataflows", {"WorkspaceId"}, "Power BI Dataflows", JoinKind.LeftOuter),
				    // Expand dataflow columns: ID, name, configuration, modification details, and composite key
				    #"Expanded Power BI Dataflows" = Table.ExpandTableColumn(#"Merged Queries4", "Power BI Dataflows", {"DataflowId", "DataflowName", "DataflowConfiguredBy", "DataflowDescription", "DataflowModifiedDateTime", "DataflowModifiedBy", "DataflowGeneration", "Workspace Name - Dataflow Name"}, {"DataflowId", "DataflowName", "DataflowConfiguredBy", "DataflowDescription", "DataflowModifiedDateTime", "DataflowModifiedBy", "DataflowGeneration", "Workspace Name - Dataflow Name"}),
				    // Create a composite key combining report name and page name
				    #"Added Custom1" = Table.AddColumn(#"Expanded Power BI Dataflows", "Report Name - Page Name", each [ReportName]&" - "&[PageDisplayName], type text),
				    // Create a composite key combining workspace, report name, and page name
				    #"Added Custom2" = Table.AddColumn(#"Added Custom1", "Workspace Name - Report Name - Page Name", each [WorkspaceName]&" - "&[ReportName]&" - "&[PageDisplayName], type text),
				    // Create a composite key combining report name and page ID
				    #"Added Custom3" = Table.AddColumn(#"Added Custom2", "Report Name - Page ID", each [ReportName]&" - "&[PageId], type text),
				    // Generate the App Page URL for navigating to a specific page in the published app
				    #"Added Custom4" = Table.AddColumn(#"Added Custom3", "App Page URL", each "https://app.powerbi.com/groups/me/apps/"&[AppId]&"/reports/"&[ReportId]&"/"&[PageId], type text),
				    // Generate the Workspace Page URL for navigating to a specific page in the workspace
				    #"Added Custom5" = Table.AddColumn(#"Added Custom4", "Workspace Page URL", each "https://app.powerbi.com/groups/"&[WorkspaceId]&"/reports/"&[ReportId]&"/"&[PageId], type text),
				    // Generate the App Report URL for navigating to the report in the published app
				    #"Added Custom6" = Table.AddColumn(#"Added Custom5", "App Report URL", each "https://app.powerbi.com/groups/me/apps/"&[AppId]&"/reports/"&[ReportId], type text),
				    // Generate the Workspace Report URL for navigating to the report in the workspace
				    #"Added Custom7" = Table.AddColumn(#"Added Custom6", "Workspace Report URL", each "https://app.powerbi.com/groups/"&[WorkspaceId]&"/reports/"&[ReportId], type text),
				    // Generate the Workspace URL for navigating to the workspace
