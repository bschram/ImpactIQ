expression 'Report Filters' =
		let
		    // Load raw report filter data from the base report detail query
		    Source = #"Base Report Filters",
		    // Create a workspace-report composite key for joining
		    #"Added Custom" = Table.AddColumn(Source, "Workspace Name - Report Name", each [WorkspaceName]&" - "&[ReportName], type text),
		    // Remove rows with null or empty ReportDate (invalid records)
		    #"Removed Errors" = Table.SelectRows(#"Added Custom", each try [ReportDate] <> null and [ReportDate] <> "" otherwise false),
