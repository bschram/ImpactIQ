expression 'Page Filters' =
		let
		    // Load raw page filter data from the base report detail query
		    Source = #"Base Page Filters",
		    // Remove rows with null or empty ReportDate (invalid records)
		    #"Removed Errors" = Table.SelectRows(Source, each try [ReportDate] <> null and [ReportDate] <> "" otherwise false),
		    // Use ReportName as fallback when ReportID is missing or empty
		    #"Added Conditional Column" = Table.AddColumn(#"Removed Errors", "Custom", each if [ReportID] = "" then [ReportName] else if [ReportID] = null then [ReportName] else [ReportID], type text),
		    // Drop the original ReportID column to replace with the resolved version
		    #"Removed Columns" = Table.RemoveColumns(#"Added Conditional Column",{"ReportID"}),
		    // Rename resolved ReportID and standardize filter column names
		    #"Renamed Columns" = Table.RenameColumns(#"Removed Columns",{{"Custom", "ReportID"}, {"AppliedFilterVersion", "AppliedFilter"}, {"PageId", "PageID"}}),
		    // Create a workspace-report composite key for joining
		    #"Added Custom" = Table.AddColumn(#"Renamed Columns", "Workspace Name - Report Name", each [WorkspaceName]&" - "&[ReportName], type text),
		    // Create a workspace-report-page navigation key
		    #"Added Custom1" = Table.AddColumn(#"Added Custom", "Workspace Name - Report Name - Page Name", each [WorkspaceName]&" - "&[ReportName]&" - "&[PageName], type text),
		    // Categorize drillthrough measures separately from regular page filters
		    #"Added Custom2" = Table.AddColumn(#"Added Custom1", "Category", each if [ObjectType] = "Measure" then "Drillthrough Measure" else "Page Filter", type text),
		    // Set filter flag based on whether this is a drillthrough measure or page filter
		    #"Added Conditional Column1" = Table.AddColumn(#"Added Custom2", "Filter?", each if [ObjectType] = "Measure" then "Drillthrough Measure" else "Page Filter", type text),
		    // Convert filter state columns (Applied, Hidden, Locked) to True/False text flags
		    #"Replaced Value" = Table.TransformColumns(
		            #"Added Conditional Column1",
		            {
		                {"AppliedFilter", each if _ <> "" and _ <> null then "True" else "False", type text},
		                {"HiddenFilter", each if _ <> "" and _ <> null then "True" else "False", type text},
		                {"LockedFilter", each if _ <> "" and _ <> null then "True" else "False", type text}
		            }
		        ),
		    // Placeholder filter step (keeps all rows, allows future filtering)
		    #"Filtered Rows" = Table.SelectRows(#"Replaced Value", each true),
		    // Extract hierarchy parent for hierarchy-type objects
		    #"Added Conditional Column2" = Table.AddColumn(#"Filtered Rows", "Object Type Temp", each if [ObjectType] = "Hierarchy" then [ObjectName] else null, type text),
		    // Split the hierarchy path into parent and child parts at the dot delimiter
