	column 'Table Storage Mode'
		dataType: string
		lineageTag: ebcb9933-8c5e-4d86-9661-0425f6a2962f
		summarizeBy: none
		sourceColumn: Table Storage Mode

		annotation SummarizationSetBy = Automatic

	column 'Model Type' =
			VAR DistinctModes =
			    CALCULATE(
			        DISTINCTCOUNT(
			            'Model Object Hierarchy'[Table Storage Mode]
			        ),
			        KEEPFILTERS(
			            'Model Object Hierarchy'[Table Storage Mode] <> ""
			        ),
			        ALLEXCEPT(
			            'Model Object Hierarchy',
			            'Model Object Hierarchy'[Workspace Name - Model Name]
			        )
			    )
			RETURN
			    IF( DistinctModes >= 2, "Composite Model", "Standard Model" )
		lineageTag: 35205fbd-bbb2-4b66-add2-d20dbbfc0953
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

