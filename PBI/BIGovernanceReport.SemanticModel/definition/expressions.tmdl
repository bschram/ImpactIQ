		    #"Removed Other Columns" = Table.SelectColumns(Source,{"Object Type - Visual Layer", "WorkspaceName", "ModelID", "Object Name - Visual Layer", "Table Name - Visual Layer", "ModelName", "WorkspaceName - ModelName - ObjectType - TableName - ObjectName"}),
