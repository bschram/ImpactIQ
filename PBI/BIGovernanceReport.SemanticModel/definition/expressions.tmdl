expression 'Power BI Reports' =
		let
		    // Load raw report data from the base environment query
		    Source = #"Base Power BI Reports",
		    // Sanitize workspace names by removing special characters
		    #"Invoked Custom Function" = Table.AddColumn(Source, "Clean Name", each #"Clean Name"([WorkspaceName]), type text),
		    // Sanitize report names by removing special characters
		    #"Invoked Custom Function1" = Table.AddColumn(#"Invoked Custom Function", "Clean Name.1", each #"Clean Name"([ReportName]), type text),
		    // Sanitize dataset names by removing special characters
		    #"Invoked Custom Function2" = Table.AddColumn(#"Invoked Custom Function1", "Clean Name.2", each #"Clean Name"([DatasetName]), type text),
		    // Drop the original unsanitized name columns
		    #"Removed Columns" = Table.RemoveColumns(#"Invoked Custom Function2",{"WorkspaceName", "ReportName", "DatasetName"}),
		    // Rename the cleaned names back to their standard column names
		    #"Renamed Columns" = Table.RenameColumns(#"Removed Columns",{{"Clean Name", "WorkspaceName"}, {"Clean Name.1", "ReportName"}, {"Clean Name.2", "DatasetName"}, {"format", "ReportFormat"}}),
		    // Keep only the relevant report metadata columns
		    #"Removed Other Columns" = Table.SelectColumns(#"Renamed Columns",{"WorkspaceId", "WorkspaceName", "DatasetId", "DatasetName", "DatasetWorkspaceId", "ReportId", "ReportName", "ReportDescription", "ReportType", "ReportFormat", "ReportWebUrl", "ReportEmbedUrl", "ReportIsFromPbix", "ReportIsOwnedByMe"}),
		    // Add a sequential index for initial report ordering
		    #"Added Index" = Table.AddIndexColumn(#"Removed Other Columns", "Report Index", 1, 1, Int64.Type),
		    // Create a composite key combining workspace and report name for custom sorting
		    #"Added Custom" = Table.AddColumn(#"Added Index", "Workspace - Report Name", each [WorkspaceName]&" - "&[ReportName], type text),
		    // Assign a custom sort order for specific known reports (DG Insights suite); default 999 for all others
		    #"Added Conditional Column" = Table.AddColumn(#"Added Custom", "Custom", each if [#"Workspace - Report Name"] = "DG Insights (Live) - Head Office PMO" then 22 else if [#"Workspace - Report Name"] = "DG Insights (Live) - Professional Job History" then 13 else if [#"Workspace - Report Name"] = "DG Insights (Live) - General Ledger" then 18 else if [#"Workspace - Report Name"] = "DG Insights (Live) - First Year Experience" then 16 else if [#"Workspace - Report Name"] = "DG Insights (Live) - Project Folder Search" then 5 else if [#"Workspace - Report Name"] = "DG Insights (Live) - Competitors" then 15 else if [#"Workspace - Report Name"] = "DG Insights (Live) - DG Vision" then 20 else if [#"Workspace - Report Name"] = "DG Insights (Live) - Customers" then 14 else if [#"Workspace - Report Name"] = "DG Insights (Live) - Engagements" then 2 else if [#"Workspace - Report Name"] = "DG Insights (Live) - Expenses - EMS" then 9 else if [#"Workspace - Report Name"] = "DG Insights (Live) - Finance" then 17 else if [#"Workspace - Report Name"] = "DG Insights (Live) - Guidance" then 19 else if [#"Workspace - Report Name"] = "DG Insights (Live) - India Value Creation" then 6 else if [#"Workspace - Report Name"] = "DG Insights (Live) - People Performance" then 12 else if [#"Workspace - Report Name"] = "DG Insights (Live) - People" then 11 else if [#"Workspace - Report Name"] = "DG Insights (Live) - Project History" then 4 else if [#"Workspace - Report Name"] = "DG Insights (Live) - Project Management" then 3 else if [#"Workspace - Report Name"] = "DG Insights (Live) - Rate Analysis" then 7 else if [#"Workspace - Report Name"] = "DG Insights (Live) - Reports" then 21 else if [#"Workspace - Report Name"] = "DG Insights (Live) - Time - EMS" then 8 else if [#"Workspace - Report Name"] = "DG Insights (Live) - ERP Project" then 23 else if [#"Workspace - Report Name"] = "DG Insights (Live) - Engagement Pipeline" then 1 else if [#"Workspace - Report Name"] = "DG Insights (Live) - Procurement" then 10 else 999, Int64.Type),
		    // Sort reports by the custom order, then by original index within each group
		    #"Sorted Rows" = Table.Sort(#"Added Conditional Column",{{"Custom", Order.Ascending}, {"Report Index", Order.Ascending}}),
		    // Re-index reports after custom sorting to establish final display order
		    #"Added Index1" = Table.AddIndexColumn(#"Sorted Rows", "Index", 1, 1, Int64.Type),
		    // Remove the temporary sorting columns
		    #"Removed Columns1" = Table.RemoveColumns(#"Added Index1",{"Report Index", "Custom"}),
		    // Rename the new index to "Report Index" as the final ordering column
		    #"Renamed Columns1" = Table.RenameColumns(#"Removed Columns1",{{"Index", "Report Index"}})
		in
		    #"Renamed Columns1"
