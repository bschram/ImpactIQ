expression 'Base Directory' = ```
		let
		    // Determine the base file directory: SharePoint URL if UseWeb is true, otherwise a local file path
		    BaseDirectory = 
		        if UseWeb 
		        then "https://contoso.sharepoint.com/sites/Finance/Shared%20Documents/"
		        else "C:\Power BI Backups"
		in
		    BaseDirectory
