expression 'Report Level Measures' =
		let
		    // Load raw report-level measure data from the base report detail query
		    Source = #"Base Report Level Measures",
		    // Create a workspace-report composite key for joining
		    #"Added Custom" = Table.AddColumn(Source, "Workspace Name - Report Name", each [WorkspaceName]&" - "&[ReportName], type text),
		    // Use ReportName as fallback when ReportID is missing or empty
		    #"Added Conditional Column" = Table.AddColumn(#"Added Custom", "Custom", each if [ReportID] = "" then [ReportName] else if [ReportID] = null then [ReportName] else [ReportID], type text),
		    // Drop the original ReportID column to replace with the resolved version
		    #"Removed Columns" = Table.RemoveColumns(#"Added Conditional Column",{"ReportID"}),
		    // Rename resolved ReportID and standardize column names to match the semantic model schema
		    #"Renamed Columns" = Table.RenameColumns(#"Removed Columns",{{"Custom", "ReportID"}, {"ReportName", "Report Name"}, {"TableName", "Table Name"}, {"ObjectName", "Object Name"}, {"ObjectType", "Object Type"}, {"HiddenFlag", "Is Hidden"}, {"FormatString", "Format String"}, {"ReportDate", "ModelAsOfDate"}}),
		    // Create a workspace-model ID composite key for joining with model mapping
		    #"Added Custom1" = Table.AddColumn(#"Renamed Columns", "Workspace Name - Model ID", each [#"WorkspaceName"]&" - "&[ModelID], type text),
		    // Left join with Workspace & Model Mapping to resolve the model name
		    #"Merged Queries" = Table.NestedJoin(#"Added Custom1", {"Workspace Name - Model ID"}, #"Workspace & Model Mapping", {"Workspace Name - Model ID"}, "Workspace & Model Mapping", JoinKind.LeftOuter),
		    // Expand the model name from the mapping table
		    #"Expanded Workspace & Model Mapping" = Table.ExpandTableColumn(#"Merged Queries", "Workspace & Model Mapping", {"Model Name", "Model Home Workspace Name"}, {"Model Name", "Model Home Workspace Name"}),
		    // Use Model Name from mapping, falling back to Report Name if no model mapping exists
		    #"Added Conditional Column1" = Table.AddColumn(#"Expanded Workspace & Model Mapping", "ModelName", each if [Model Name] = null then [Report Name] else [Model Name], type text),
		    // Create a workspace-model-report composite key for lineage tracking
		    #"Added Custom2" = Table.AddColumn(#"Added Conditional Column1", "Report Workspace Name - Model ID - Report ID", each [WorkspaceName]&" - "&[ModelID]&" - "&[ReportID], type text),
		    // Remove temporary columns used for model name resolution
		    #"Removed Columns1" = Table.RemoveColumns(#"Added Custom2",{"Model Name", "Report Name", "ReportID", "Workspace Name - Report Name", "Workspace Name - Model ID", "WorkspaceName"}),
		    // Flag these measures as report-level (not model-level) for distinction in downstream logic
		    #"Added Custom3" = Table.AddColumn(#"Removed Columns1", "Report Level Measure Flag", each "True", type text),
		    // Standardize the Is Hidden field casing to "False" (from "false")
		    #"Replaced Value" = Table.ReplaceValue(#"Added Custom3","false","False",Replacer.ReplaceValue,{"Is Hidden"}),
		    #"Renamed Columns1" = Table.RenameColumns(#"Replaced Value",{{"Model Home Workspace Name", "WorkspaceName"}})
		in
		    #"Renamed Columns1"
