	/// Shows the percentage of total report object usage that the current page represents relative to all pages in the same report. Helps identify which pages are the heaviest consumers of model objects.
	measure 'Report Objects Count % - Pages' =
			DIVIDE(
			    [Report Objects Count],
			    [Report Objects Count - All Pages]
			)
		formatString: 0%;-0%;0%
		lineageTag: ca3a7d8b-0d32-4ddd-bf0b-1fb4786bb0c1

	/// Shows the percentage of total report object usage that the current report represents relative to all reports. Helps identify which reports are the heaviest consumers of model objects.
	measure 'Report Objects Count % - Reports' =
			VAR A =
			    DIVIDE(
			        [Report Objects Count],
			        [Report Objects Count - All Reports]
			    )
			RETURN
			    IF(
			        ISINSCOPE( 'Report Hierarchy'[Report Name] )
			            && NOT ( ISINSCOPE( 'Report Hierarchy'[Page Name] ) ),
			        A,
			        BLANK( )
			    )
		formatString: 0%;-0%;0%
		lineageTag: 8b9376b9-380f-4f2f-9bf6-5f84c26bf210

	/// Total report object usage count across all pages in the current report. Used as the denominator for the page-level percentage calculation.
	measure 'Report Objects Count - All Pages' =
			VAR A =
			    CALCULATE(
			        [Report Objects Count],
			        REMOVEFILTERS(
			            'Report Hierarchy'[Workspace Name - Report Name - Page Name]
			        )
			    )
			RETURN
			    SWITCH(
			        TRUE( ),
			        ISINSCOPE( 'Report Hierarchy'[Page Name] ), A
			    )
		formatString: #,##0
		lineageTag: 9cd93919-cc75-4e8e-9a99-de6b9f028ebb

	/// Total report object usage count across all reports. Used as the denominator for the report-level percentage calculation.
	measure 'Report Objects Count - All Reports' =
