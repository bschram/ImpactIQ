	/// Shows the percentage of distinct report objects for the current report relative to all reports. Helps compare object diversity across reports.
	measure 'Report Objects Distinct Count % - Reports' =
			VAR A =
			    DIVIDE(
			        [Report Objects Distinct Count],
			        [Report Objects Distinct Count - All Reports]
			    )
			RETURN
			    IF(
			        ISINSCOPE( 'Report Hierarchy'[Report Name] )
