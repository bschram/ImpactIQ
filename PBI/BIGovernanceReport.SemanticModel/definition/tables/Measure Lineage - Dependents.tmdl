	partition 'Measure Lineage - Dependents' = m
		mode: import
		queryGroup: 'Measure Lineage'
		source =
				let
				    // --- Inner Query: Build MeasureDependencies lookup with only measure-type dependencies ---
				    MeasureDependencies=let
				    // --- Inner Query: Build MeasureDependencieMeasuresOnly with workspace-qualified measure keys ---
				    MeasureDependencieMeasuresOnly=let
				    // Load the base measure dependency data
				    Source = #"Base Measure Dependencies",
				    // Filter to only dependencies where the dependent object is a Measure
				    #"Filtered Rows" = Table.SelectRows(Source, each ([DependsOnType] = "Measure")),
				    // Remove the raw WorkspaceName column (will be replaced via mapping)
				    #"Added Custom6" = Table.AddColumn(#"Filtered Rows", "Workspace Name - Model ID", each [WorkspaceName]&" - "&[ModelID], type text),
				    // Join with Workspace & Model Mapping to resolve the correct workspace context
				    #"Merged Queries1" = Table.NestedJoin(#"Added Custom6", {"Workspace Name - Model ID"}, #"Workspace & Model Mapping", {"Workspace Name - Model ID"}, "Workspace & Model Mapping", JoinKind.LeftOuter),
				    #"Removed Columns" = Table.RemoveColumns(#"Merged Queries1",{"WorkspaceName", "Workspace Name - Model ID"}),
				    // Expand model-in-workspace flag, workspace ID, and workspace name from the mapping
				    #"Expanded Workspace & Model Mapping" = Table.ExpandTableColumn(#"Removed Columns", "Workspace & Model Mapping", {"Model in Workspace Flag", "Workspace Name"}, {"Model in Workspace Flag", "WorkspaceName"}),
				    // Remove opening brackets from the DependsOn column
				    #"Replaced Value" = Table.ReplaceValue(#"Expanded Workspace & Model Mapping","[","",Replacer.ReplaceText,{"DependsOn"}),
				    // Remove closing brackets from the DependsOn column
				    #"Replaced Value1" = Table.ReplaceValue(#"Replaced Value","]","",Replacer.ReplaceText,{"DependsOn"}),
				    // Create a workspace-qualified Measure Name key
				    #"Added Custom" = Table.AddColumn(#"Replaced Value1", "Measure Name", each [WorkspaceName]&" - "&[ModelName]&" - "&[MeasureName], type text),
				    // Create a workspace-qualified Depends On key
				    #"Added Custom1" = Table.AddColumn(#"Added Custom", "Depends On", each [WorkspaceName]&" - "&[ModelName]&" - "&[DependsOn], type text)
				in
				    #"Added Custom1",
				    // Load the base measure dependency data for the full dependency set
				    Source = #"Base Measure Dependencies",
				    // Remove the raw WorkspaceName column (will be replaced via mapping)
				    #"Added Custom6" = Table.AddColumn(Source, "Workspace Name - Model ID", each [WorkspaceName]&" - "&[ModelID], type text),
				    // Join with Workspace & Model Mapping to resolve the correct workspace context
				    #"Merged Queries1" = Table.NestedJoin(#"Added Custom6", {"Workspace Name - Model ID"}, #"Workspace & Model Mapping", {"Workspace Name - Model ID"}, "Workspace & Model Mapping", JoinKind.LeftOuter),
				    #"Removed Columns" = Table.RemoveColumns(#"Merged Queries1",{"WorkspaceName", "Workspace Name - Model ID"}),
				    // Expand model-in-workspace flag, workspace ID, and workspace name from the mapping
				    #"Expanded Workspace & Model Mapping" = Table.ExpandTableColumn(#"Removed Columns", "Workspace & Model Mapping", {"Workspace Name - Model ID", "Workspace Name"}, {"Workspace Name - Model ID", "WorkspaceName"}),
				    // Create a workspace-qualified Measure Name key
				    #"Added Custom" = Table.AddColumn(#"Expanded Workspace & Model Mapping", "Measure Name", each [WorkspaceName]&" - "&[ModelName]&" - "&[MeasureName], type text),
				    // Select only the Measure Name column for distinct measure list
				    #"Removed Other Columns" = Table.SelectColumns(#"Added Custom",{"Measure Name"}),
				    // Get distinct measure names to avoid duplicate joins
				    #"Removed Duplicates" = Table.Distinct(#"Removed Other Columns"),
				    // Join with MeasureDependencieMeasuresOnly to get measure-only dependencies
				    #"Merged Queries" = Table.NestedJoin(#"Removed Duplicates", {"Measure Name"}, MeasureDependencieMeasuresOnly, {"Measure Name"}, "dependencies_with_types", JoinKind.LeftOuter),
				    // Expand the Depends On column from the measures-only dependency lookup
				    #"Expanded dependencies_with_types" = Table.ExpandTableColumn(#"Merged Queries", "dependencies_with_types", {"Depends On"}, {"Depends On"})
				in
				    #"Expanded dependencies_with_types",
				    // --- Inner Query: Build ModelDetailMeasuresOnly with detailed measure metadata ---
				    ModelDetailMeasuresOnly=let
				    // Load base semantic model metadata
				    Source = #"Base Semantic Models",
				    // Rename columns to user-friendly names
				    #"Renamed Columns" = Table.RenameColumns(Source,{{"Name", "Object Name"}, {"Type", "Object Type"}, {"Table", "Table Name"}, {"IsHidden", "Is Hidden"}, {"DisplayFolder", "Display Folder"}, {"FormatString", "Format String"}}),
				    // Remove the raw WorkspaceName column
				    #"Added Custom7" = Table.AddColumn(#"Renamed Columns", "Workspace Name - Model ID", each [WorkspaceName]&" - "&[ModelID], type text),
				    // Join with Workspace & Model Mapping to resolve the correct workspace context
				    #"Merged Queries" = Table.NestedJoin(#"Added Custom7", {"Workspace Name - Model ID"}, #"Workspace & Model Mapping", {"Workspace Name - Model ID"}, "Workspace & Model Mapping", JoinKind.LeftOuter),
				    #"Removed Columns" = Table.RemoveColumns(#"Merged Queries",{"WorkspaceName", "Workspace Name - Model ID"}),
				    // Expand model-in-workspace flag, workspace ID, and workspace name from the mapping
				    #"Expanded Workspace & Model Mapping" = Table.ExpandTableColumn(#"Removed Columns", "Workspace & Model Mapping", {"Model in Workspace Flag", "Workspace Name"}, {"Model in Workspace Flag", "WorkspaceName"}),
				    // Filter to only Measure object types
				    #"Filtered Rows" = Table.SelectRows(#"Expanded Workspace & Model Mapping", each ([Object Type] = "Measure")),
				    // Create composite key: Model - ObjectType - Table - ObjectName
				    #"Added Custom" = Table.AddColumn(#"Filtered Rows", "ModelName - ObjectType - TableName - ObjectName", each [ModelName]&" - "&[Object Type]&" - "&[Table Name]&" - "&[Object Name], type text),
				    // Create composite key: Workspace - Model - ObjectType - Table - ObjectName
				    #"Added Custom1" = Table.AddColumn(#"Added Custom", "WorkspaceName - ModelName - ObjectType - TableName - ObjectName", each [WorkspaceName]&" - "&[ModelName]&" - "&[Object Type]&" - "&[Table Name]&" - "&[Object Name], type text),
				    // Create composite key: Workspace Name - Model Name
				    #"Added Custom2" = Table.AddColumn(#"Added Custom1", "Workspace Name - Model Name", each [WorkspaceName]&" - "&[ModelName], type text),
				    // Create composite key: Workspace - Model Name - Object Name
				    #"Added Custom3" = Table.AddColumn(#"Added Custom2", "Workspace Name - Model Name - Object Name", each [WorkspaceName]&" - "&[ModelName]&" - "&[Object Name], type text),
				    // Create composite key: Model ID - Object Name
				    #"Added Custom4" = Table.AddColumn(#"Added Custom3", "Model ID - Object Name", each [ModelID]&" - "&[Object Name], type text),
				    // Create composite key: Workspace Name - Model ID
				    #"Added Custom5" = Table.AddColumn(#"Added Custom4", "Workspace Name - Model ID", each [WorkspaceName]&" - "&[ModelID], type text),
				    // Create composite key: Workspace Name - Model ID - Object Name
				    #"Added Custom6" = Table.AddColumn(#"Added Custom5", "Workspace Name - Model ID - Object Name", each [WorkspaceName]&" - "&[ModelID]&" - "&[Object Name], type text),
				    // Deduplicate by Workspace Name - Model ID - Object Name to get unique measures
				    #"Removed Duplicates" = Table.Distinct(#"Added Custom6", {"Workspace Name - Model ID - Object Name"}),
				    // Select only the columns needed for the measures-only output
				    #"Removed Other Columns" = Table.SelectColumns(#"Removed Duplicates",{"Object Type", "Table Name", "Object Name", "Format String", "Display Folder", "Description", "Is Hidden", "Expression", "ModelAsOfDate", "WorkspaceName", "ModelName", "ModelID", "ModelName - ObjectType - TableName - ObjectName", "WorkspaceName - ModelName - ObjectType - TableName - ObjectName", "Workspace Name - Model Name", "Workspace Name - Model Name - Object Name", "Model ID - Object Name", "Workspace Name - Model ID - Object Name"})
				in
				    #"Removed Other Columns",
				    // --- Outer Query: Build the full dependent measure lineage with 12 levels of dependency chaining ---
				    // Load base semantic model metadata for measures
				    Source = #"Base Semantic Models",
				    // Rename columns to user-friendly names
				    #"Renamed Columns" = Table.RenameColumns(Source,{{"Name", "Object Name"}, {"Type", "Object Type"}, {"Table", "Table Name"}, {"IsHidden", "Is Hidden"}, {"DisplayFolder", "Display Folder"}, {"FormatString", "Format String"}}),
				    #"Added Custom5" = Table.AddColumn(#"Renamed Columns", "Workspace Name - Model ID", each [WorkspaceName]&" - "&[ModelID], type text),
				    // Join with Workspace & Model Mapping to resolve workspace context
				    #"Merged Queries14" = Table.NestedJoin(#"Added Custom5", {"Workspace Name - Model ID"}, #"Workspace & Model Mapping", {"Workspace Name - Model ID"}, "Workspace & Model Mapping", JoinKind.LeftOuter),
				    #"Removed Columns1" = Table.RemoveColumns(#"Merged Queries14",{"WorkspaceName", "Workspace Name - Model ID"}),
				    // Expand workspace flag and workspace name from the mapping
				    #"Expanded Workspace & Model Mapping" = Table.ExpandTableColumn(#"Removed Columns1", "Workspace & Model Mapping", {"Workspace Name"}, {"WorkspaceName"}),
				    // Filter to only Measure object types
				    #"Filtered Rows" = Table.SelectRows(#"Expanded Workspace & Model Mapping", each ([Object Type] = "Measure")),
				    // Create composite key: Model - ObjectType - Table - ObjectName
				    #"Added Custom" = Table.AddColumn(#"Filtered Rows", "ModelName - ObjectType - TableName - ObjectName", each [ModelName]&" - "&[Object Type]&" - "&[Table Name]&" - "&[Object Name], type text),
				    // Create composite key: Workspace - Model - ObjectType - Table - ObjectName
				    #"Added Custom1" = Table.AddColumn(#"Added Custom", "WorkspaceName - ModelName - ObjectType - TableName - ObjectName", each [WorkspaceName]&" - "&[ModelName]&" - "&[Object Type]&" - "&[Table Name]&" - "&[Object Name], type text),
				    // Create workspace-qualified measure name key for dependency lookups
				    #"Added Custom2" = Table.AddColumn(#"Added Custom1", "Measure Name", each [WorkspaceName]&" - "&[ModelName]&" - "&[Object Name], type text),
				    // Create composite key: Workspace Name - Model Name
				    #"Added Custom3" = Table.AddColumn(#"Added Custom2", "Workspace Name - Model Name", each [WorkspaceName]&" - "&[ModelName], type text),
				    // Create composite key: Workspace Name - Model ID
				    #"Added Custom4" = Table.AddColumn(#"Added Custom3", "Workspace Name - Model ID", each [WorkspaceName]&" - "&[ModelID], type text),
				    // Rename Object Name to ObjectName for internal processing
				    #"Renamed Columns6" = Table.RenameColumns(#"Added Custom4",{{"Object Name", "ObjectName"}}),
				    // Rename Measure Name to Object Name for dependency join key
				    #"Renamed Columns1" = Table.RenameColumns(#"Renamed Columns6",{{"Measure Name", "Object Name"}}),
				    // Remove relationship columns not relevant to measure lineage
				    #"Removed Columns2" = Table.RemoveColumns(#"Renamed Columns1",{"RelationshipFromTable", "RelationshipFromColumn", "RelationshipToTable", "RelationshipToColumn", "RelationshipStatus", "RelationshipFromCardinality", "RelationshipToCardinality", "RelationshipCrossFilteringBehavior"}),
				    // Level 01: Join with MeasureDependencies to get first-level dependencies
				    #"Merged Queries" = Table.NestedJoin(#"Removed Columns2", {"Object Name"}, MeasureDependencies, {"Measure Name"}, "dependencies_with_types (2)", JoinKind.LeftOuter),
				    #"Expanded dependencies_with_types (2)" = Table.ExpandTableColumn(#"Merged Queries", "dependencies_with_types (2)", {"Depends On"}, {"Depends On"}),
				    // Level 02: Chain to second-level dependencies
				    #"Merged Queries1" = Table.NestedJoin(#"Expanded dependencies_with_types (2)", {"Depends On"}, MeasureDependencies, {"Measure Name"}, "dependencies_with_types (2)", JoinKind.LeftOuter),
				    #"Expanded dependencies_with_types (2)1" = Table.ExpandTableColumn(#"Merged Queries1", "dependencies_with_types (2)", {"Depends On"}, {"Depends On.1"}),
				    // Level 03: Chain to third-level dependencies
				    #"Merged Queries2" = Table.NestedJoin(#"Expanded dependencies_with_types (2)1", {"Depends On.1"}, MeasureDependencies, {"Measure Name"}, "dependencies_with_types (2)", JoinKind.LeftOuter),
				    #"Expanded dependencies_with_types (2)2" = Table.ExpandTableColumn(#"Merged Queries2", "dependencies_with_types (2)", {"Depends On"}, {"Depends On.2"}),
				    // Level 04: Chain to fourth-level dependencies
				    #"Merged Queries3" = Table.NestedJoin(#"Expanded dependencies_with_types (2)2", {"Depends On.2"}, MeasureDependencies, {"Measure Name"}, "dependencies_with_types (2)", JoinKind.LeftOuter),
				    #"Expanded dependencies_with_types (2)3" = Table.ExpandTableColumn(#"Merged Queries3", "dependencies_with_types (2)", {"Depends On"}, {"Depends On.3"}),
				    // Level 05: Chain to fifth-level dependencies
				    #"Merged Queries4" = Table.NestedJoin(#"Expanded dependencies_with_types (2)3", {"Depends On.3"}, MeasureDependencies, {"Measure Name"}, "dependencies_with_types (2)", JoinKind.LeftOuter),
				    #"Expanded dependencies_with_types (2)4" = Table.ExpandTableColumn(#"Merged Queries4", "dependencies_with_types (2)", {"Depends On"}, {"Depends On.4"}),
				    // Level 06: Chain to sixth-level dependencies
