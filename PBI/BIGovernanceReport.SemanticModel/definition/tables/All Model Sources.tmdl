table 'All Model Sources'
	lineageTag: ffaddcc3-4123-4243-8f8f-0b609cb9b924

	/// Counts the distinct semantic models that have data source connection information. Filter by 'Model Object Hierarchy'[Object Name] is not applicable here — this counts models in the data source inventory, not object usage.
	measure 'Model Distinct Count (Model Sources)' = DISTINCTCOUNT('All Model Sources'[Workspace Name - Model ID])
		formatString: 0
		lineageTag: 56adf808-cb56-4e3e-ac8b-5594221d91a7

	/// Total row count of data source connections across all models. Each row represents one data source connection for a model. Not related to object usage — this is for understanding the data source landscape.
	measure 'Model Source Count - All Rows' = COUNT('All Model Sources'[Workspace Name - Model Name - Connection Detail])
		formatString: #,0
		lineageTag: c2080ec3-0882-4e6c-b00e-db60d5394d75

	column ModelID
		dataType: string
		isHidden
		lineageTag: fd966083-17d2-4300-97e0-72b6cb50a4f1
		summarizeBy: none
		sourceColumn: ModelID

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

