	partition 'All Model Sources' = m
		mode: import
		queryGroup: 'Model Layer'
		source =
				let
				    // Load model data source information from the base query
				    Source = #"Base Power BI Model Sources",
				    // Sanitize workspace name using the Clean Name function
				    #"Invoked Custom Function" = Table.AddColumn(Source, "Clean Name", each #"Clean Name"([WorkspaceName]), type text),
				    // Sanitize model (dataset) name using the Clean Name function
				    #"Invoked Custom Function1" = Table.AddColumn(#"Invoked Custom Function", "Clean Name.1", each #"Clean Name"([DatasetName]), type text),
				    // Remove the original unsanitized workspace and dataset name columns
				    #"Removed Columns" = Table.RemoveColumns(#"Invoked Custom Function1",{"WorkspaceName", "DatasetName"}),
				    // Rename the sanitized columns back to their original names
				    #"Renamed Columns" = Table.RenameColumns(#"Removed Columns",{{"Clean Name", "WorkspaceName"}, {"Clean Name.1", "DatasetName"}}),
				    // Remove the original workspace columns (will be resolved via Workspace & Model Mapping)
				    #"Removed Columns1" = Table.RemoveColumns(#"Renamed Columns",{"WorkspaceId", "WorkspaceName"}),
				    // Pre-filter Workspace & Model Mapping to home workspace only (prevents fan-out duplication and memory explosion)
				    #"Merged Queries" = Table.NestedJoin(#"Removed Columns1", {"DatasetId"}, Table.SelectRows(#"Workspace & Model Mapping", each [Model in Workspace Flag] = "TRUE"), {"Model ID"}, "Workspace & Model Mapping", JoinKind.LeftOuter),
				    // Expand workspace name, ID, and model home workspace from the mapping
				    #"Expanded Workspace & Model Mapping" = Table.ExpandTableColumn(#"Merged Queries", "Workspace & Model Mapping", {"Model in Workspace Flag", "Workspace Name", "Workspace ID", "Model Home Workspace Name"}, {"Model in Workspace Flag", "WorkspaceName", "Workspace ID", "Model Home Workspace Name"}),
				    // Reclassify "Extension" datasource types based on connection details (UsageMetrics, Dataflows Legacy, Dataflows, DocumentDB)
				    #"Added Conditional Column" = Table.AddColumn(#"Expanded Workspace & Model Mapping", "Custom", each let details = if [DatasetDatasourceConnectionDetails] = null then "" else [DatasetDatasourceConnectionDetails] in if [DatasetDatasourceType] <> "Extension" then [DatasetDatasourceType] else if Text.Contains(details, "Usage") then "UsageMetricsConnector" else if Text.Contains(details, "PowerBI") then "Dataflows (Legacy)" else if Text.Contains(details, "Dataflows") then "Dataflows" else if Text.Contains(details, "DocumentDB") then "DocumentDB" else [DatasetDatasourceType], type text),
				    // Remove the original datasource type column (replaced by the reclassified version)
				    #"Removed Columns2" = Table.RemoveColumns(#"Added Conditional Column",{"DatasetDatasourceType"}),
				    // Rename all columns to user-friendly display names
				    #"Renamed Columns1" = Table.RenameColumns(#"Removed Columns2",{{"Custom", "Datasource Type"}, {"DatasetDatasourceId", "Datasource ID"}, {"DatasetDatasourceGatewayId", "DatasetDatasource Gateway ID"}, {"DatasetDatasourceConnectionDetails", "Datasource Connection Details"}, {"DatasetId", "ModelID"}, {"DatasetName", "ModelName"}}),
				    // Create a composite key combining datasource type and connection details
				    #"Added Custom" = Table.AddColumn(#"Renamed Columns1", "Datasource Type - Connection Detail", each [Datasource Type]&" - "&[Datasource Connection Details], type text),
				    // Create a composite key combining workspace and model names
				    #"Added Custom1" = Table.AddColumn(#"Added Custom", "Workspace Name - Model Name", each [WorkspaceName]&" - "&[ModelName], type text),
				    // Create a composite key combining workspace, model, and connection details
				    #"Added Custom2" = Table.AddColumn(#"Added Custom1", "Workspace Name - Model Name - Connection Detail", each [WorkspaceName]&" - "&[ModelName]&" - "&[Datasource Connection Details], type text),
				    // Create a composite key combining workspace name and model ID
				    #"Added Custom3" = Table.AddColumn(#"Added Custom2", "Workspace Name - Model ID", each [WorkspaceName]&" - "&[ModelID], type text),
				    #"Replaced Value" = Table.ReplaceValue(#"Added Custom3",null,"TRUE",Replacer.ReplaceValue,{"Model in Workspace Flag"})
				in
				    #"Replaced Value"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

