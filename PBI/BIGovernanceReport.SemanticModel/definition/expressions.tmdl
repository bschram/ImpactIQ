expression 'Workspace, Model, Report, & Page Mapping' = ```
		let
		    // Load report page data from the Base Pages query
		    Source = #"Base Pages",
		    // Retain only the key workspace, report, and page identifier columns
		    #"Removed Other Columns" = Table.SelectColumns(Source,{"WorkspaceName", "ReportName", "ReportID", "Id", 
		"Name", "Number", "ReportDate"}),
		    // Standardize column names: Id→PageId, Name→PageName, Number→PageNumber
		    #"Renamed Columns" = Table.RenameColumns(#"Removed Other Columns",{{"Name", "PageName"}, {"Id", "PageId"}, {"Number", "PageNumber"}}),
		    // Filter out rows where ReportDate is null or empty (invalid snapshots)
		    #"Removed Errors" = Table.SelectRows(#"Renamed Columns", each try [ReportDate] <> null and [ReportDate] <> "" otherwise false),
		    // Fallback: use ReportName as ReportID when the ReportID is missing or blank
		    #"Added Conditional Column" = Table.AddColumn(#"Removed Errors", "Custom", each if [ReportID] = "" then [ReportName] else if [ReportID] = null then [ReportName] else [ReportID], type text),
		    // Drop original ReportID in preparation for renaming the fallback column
		    #"Removed Columns" = Table.RemoveColumns(#"Added Conditional Column",{"ReportID"}),
		    // Rename the fallback column to ReportID
		    #"Renamed Columns1" = Table.RenameColumns(#"Removed Columns",{{"Custom", "ReportID"}}),
		    // Sort by newest snapshot date first, then by page number ascending
		    #"Sorted Rows" = Table.Sort(#"Renamed Columns1",{{"ReportDate", Order.Descending}, {"PageNumber", Order.Ascending}}),
		    // Replace null page names with "Undefined" for consistency
		    #"Replaced Value" = Table.ReplaceValue(#"Sorted Rows",null,"Undefined",Replacer.ReplaceValue,{"PageName"}),
		    // Add a sequential index for row ordering
		    #"Added Index" = Table.AddIndexColumn(#"Replaced Value", "Index", 1, 1, Int64.Type),
		    // Create a composite key combining workspace and report name
		    #"Added Custom1" = Table.AddColumn(#"Added Index", "Workspace Name - Report Name", each [WorkspaceName]&" - "&[ReportName], type text),
		    // Join with Power BI Reports to pull in the report description
		    #"Merged Queries" = Table.NestedJoin(#"Added Custom1", {"ReportID"}, #"Power BI Reports", {"ReportId"}, "Power BI Reports", JoinKind.LeftOuter),
		    // Expand the ReportDescription column from the merged reports table
		    #"Expanded Power BI Reports" = Table.ExpandTableColumn(#"Merged Queries", "Power BI Reports", {"ReportDescription"}, {"ReportDescription"}),
		    // Rename page/report columns to indicate these are "First Page" values and standardize names
		    #"Renamed Columns2" = Table.RenameColumns(#"Expanded Power BI Reports",{{"PageId", "FirstPageId"}, {"PageName", "FirstPageName"}, {"ReportName", "Report Name"}, {"PageNumber", "FirstPageNumber"}, {"WorkspaceName", "Workspace Name"}}),
		    // Deduplicate on ReportID to keep only the first page record per report
		    #"Removed Duplicates" = Table.Distinct(#"Renamed Columns2", {"ReportID"}),
		    // Join with Report & Model Mapping to bring in associated model details
		    #"Merged Queries1" = Table.NestedJoin(#"Removed Duplicates", {"ReportID"}, #"Report & Model Mapping", {"ReportID"}, "Report & Model Mapping", JoinKind.LeftOuter),
		    // Expand model mapping fields: availability flag, ModelID, ModelName, and composite keys
		    #"Expanded Report & Model Mapping" = Table.ExpandTableColumn(#"Merged Queries1", "Report & Model Mapping", {"Model Detail Available?", "ModelID", "ModelName", "Workspace Name - Model ID", "Workspace Name - Model Name - Report Name", "WorkspaceId"}, {"Model Detail Available?", "ModelID", "ModelName", "Workspace Name - Model ID", "Workspace Name - Model Name - Report Name", "WorkspaceId"}),
		    // Create a composite key for workspace-report-page navigation
		    #"Added Custom2" = Table.AddColumn(#"Expanded Report & Model Mapping", "Workspace Name - Report Name - Page Name", each [Workspace Name]&" - "&[Report Name]&" - "&[FirstPageName], type text),
		    // Flag all rows to indicate the first page should be excluded from page-level analysis
		    #"Added Custom3" = Table.AddColumn(#"Added Custom2", "Exclude First Page Flag", each "Yes", type text)
		in
		    #"Added Custom3"
		```
