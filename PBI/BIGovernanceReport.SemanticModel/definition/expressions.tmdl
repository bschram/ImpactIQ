expression UsedinRelationships =
		let
		    // Load the full semantic model detail from the base query
		    Source = #"Base Semantic Models",
		    // Rename columns to standardized field names for consistency
		    #"Renamed Columns" = Table.RenameColumns(Source,{{"Name", "Object Name"}, {"Type", "Object Type"}, {"Table", "Table Name"}, {"IsHidden", "Is Hidden"}, {"DisplayFolder", "Display Folder"}, {"FormatString", "Format String"}}),
		    // Keep only relationship objects
		    #"Filtered Rows" = Table.SelectRows(#"Renamed Columns", each ([Object Type] = "Relationship")),
		    // Select only the columns needed for relationship lineage analysis
		    #"Removed Other Columns" = Table.SelectColumns(#"Filtered Rows",{"Object Type", "Table Name", "Object Name", "RelationshipToTable", "RelationshipToColumn", "WorkspaceName", "ModelName", "ModelID"}),
		    // Unpivot Table Name and RelationshipToTable to get both sides of the relationship as rows
		    #"Unpivoted Columns" = Table.UnpivotOtherColumns(#"Removed Other Columns", {"Object Type", "Object Name", "RelationshipToColumn", "WorkspaceName", "ModelName", "ModelID"}, "Attribute", "Value"),
		    // Unpivot Object Name and RelationshipToColumn to get both column references as rows
		    #"Unpivoted Columns1" = Table.UnpivotOtherColumns(#"Unpivoted Columns", {"Object Type", "WorkspaceName", "ModelName", "ModelID", "Attribute", "Value"}, "Attribute.1", "Value.1"),
		    // Rename the unpivoted values to Table Name and Object Name
		    #"Renamed Columns1" = Table.RenameColumns(#"Unpivoted Columns1",{{"Value", "Table Name"}, {"Value.1", "Object Name"}}),
		    // Remove the intermediate attribute columns from unpivoting
		    #"Removed Columns" = Table.RemoveColumns(#"Renamed Columns1",{"Attribute", "Attribute.1"}),
		    // Duplicate Object Type to create both "Relationship" and "Column" type entries
		    #"Duplicated Column" = Table.DuplicateColumn(#"Removed Columns", "Object Type", "Object Type - Copy"),
		    // Replace "Relationship" with "Column" in the copy to track column-level usage
		    #"Replaced Value" = Table.ReplaceValue(#"Duplicated Column","Relationship","Column",Replacer.ReplaceValue,{"Object Type - Copy"}),
		    // Unpivot the original and copy to create separate rows for each object type
		    #"Unpivoted Only Selected Columns" = Table.Unpivot(#"Replaced Value", {"Object Type - Copy", "Object Type"}, "Attribute", "Value"),
		    // Remove the intermediate attribute column from the final unpivot
		    #"Removed Columns1" = Table.RemoveColumns(#"Unpivoted Only Selected Columns",{"Attribute"}),
		    // Rename the unpivoted value back to Object Type
		    #"Renamed Columns2" = Table.RenameColumns(#"Removed Columns1",{{"Value", "Object Type"}}),
		    // Create a workspace-model-object composite key for cross-workspace lookups
		    #"Added Custom" = Table.AddColumn(#"Renamed Columns2", "WorkspaceName - ModelName - ObjectType - TableName - ObjectName", each [WorkspaceName]&" - "&[ModelName]&" - "&[Object Type]&" - "&[Table Name]&" - "&[Object Name], type text),
		    // Create a model-level composite key using ModelID for unique object identification
		    #"Added Custom1" = Table.AddColumn(#"Added Custom", "ModelID - ObjectType - TableName - ObjectName", each [ModelID]&" - "&[Object Type]&" - "&[Table Name]&" - "&[Object Name], type text),
		    // Tag the usage source as "Relationships"
		    #"Added Custom2" = Table.AddColumn(#"Added Custom1", "Object Used In", each "Relationships", type text),
		    // Trim whitespace from the deduplication key
		    #"Trimmed Text" = Table.TransformColumns(#"Added Custom2",{{"WorkspaceName - ModelName - ObjectType - TableName - ObjectName", Text.Trim, type text}}),
		    // Normalize case for consistent deduplication
		    #"Cleaned Text" = Table.TransformColumns(#"Trimmed Text",{{"WorkspaceName - ModelName - ObjectType - TableName - ObjectName", Text.Proper, type text}}),
		    // We need the general usage flags to be at the Model level, not Workspace & Model. Model ID ensures it's still unique to a specific Model but doesn't incorrectly filter out usage based on Workspace. At the Model level, if an object is used anywhere, regardless of workspace, it is used and will affect reports. Exact usage location is via Report detail.
		    #"Removed Duplicates" = Table.Distinct(#"Cleaned Text", {"WorkspaceName - ModelName - ObjectType - TableName - ObjectName"})
		in
		    #"Removed Duplicates"
	lineageTag: c486f7cb-97b5-4bed-b434-ec880ecd32ad
