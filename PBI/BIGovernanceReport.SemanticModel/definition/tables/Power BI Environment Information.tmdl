table 'Power BI Environment Information'
	lineageTag: 182ae03e-5210-4b84-b3cc-afedd6783395

	measure 'Workspace Distinct Count (Environment)' = DISTINCTCOUNTNOBLANK('Power BI Environment Information'[WorkspaceName])
		formatString: #,0
		lineageTag: aa9172dd-f463-4700-8d84-cdfdc3e3b0fd

	measure 'Model Distinct Count (Environment)' = DISTINCTCOUNTNOBLANK('Power BI Environment Information'[Workspace Name - Model Name])
		formatString: #,0
		lineageTag: c933cee7-d072-4cf1-8ebd-c6d6437af9d4

	measure 'Dataflow Distinct Count (Environment)' =
			VAR A = DISTINCTCOUNTNOBLANK('Power BI Environment Information'[Workspace Name - Dataflow Name])
			VAR B = CALCULATE(DISTINCTCOUNTNOBLANK('Fabric Item Information'[Fabric Item ID]), KEEPFILTERS('Fabric Item Information'[Fabric Item Type] IN {"Dataflow"}))
			RETURN
			A + B
		formatString: #,0
		lineageTag: 04bacd96-6329-4025-8e04-c1f52243d780

	measure 'Org App Distinct Count (Environment)' = DISTINCTCOUNTNOBLANK('Power BI Environment Information'[App ID])
		formatString: #,0
		lineageTag: 2167cae4-eadc-44a8-b384-e0fe88982440

	measure 'Report Distinct Count (Environment)' = DISTINCTCOUNTNOBLANK('Power BI Environment Information'[Workspace - Report Name])
		formatString: #,0
		lineageTag: bf3c075d-7010-4f44-adab-6cd48a13cd19

