	/// Counts distinct objects (measures, columns, hierarchy levels, etc.) referenced in reports. Filter by 'Model Object Hierarchy'[Object Name] to see if a specific object name is used anywhere. This is the core measure for answering 'is this object used in any report?'
	measure 'Report Objects Distinct Count' =
			DISTINCTCOUNTNOBLANK(
			    'All Reports'[Report Object Unique Key]
			)
		formatString: #,##0
