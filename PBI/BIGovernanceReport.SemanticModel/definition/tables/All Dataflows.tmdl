	partition 'All Dataflows' = m
		mode: import
		queryGroup: 'Dataflow Layer'
		source =
				let
				    // Load all dataflow data from the base query
				    Source = #"Base Dataflows",
				    // Filter out system-generated queries (DataDestination, Transform, Staging, etc.)
				    #"Filtered Rows" = Table.SelectRows(Source, each not Text.Contains([Query Name], "_DataDestination") and not Text.Contains([Query Name], "_TransformForWriteToDataDestination") and not Text.Contains([Query Name], "_WriteToDataDestination") and [Query Name] <> "DefaultDestination" and [Query Name] <> "DefaultStaging"),
				    // Keep only the essential dataflow identification columns
				    #"Removed Other Columns" = Table.SelectColumns(#"Filtered Rows",{"Dataflow ID", "Dataflow Name", "Query Name", "Query", "Report Date", "Workspace Name - Dataflow Name"}),
				    // Rename query columns to dataflow-specific names
				    #"Renamed Columns" = Table.RenameColumns(#"Removed Other Columns",{{"Query Name", "Dataflow Query Name"}, {"Query", "Dataflow Query Expression"}}),
				    // Create a composite key combining Dataflow ID and query name
				    #"Added Custom" = Table.AddColumn(#"Renamed Columns", "Dataflow ID - Query Name", each [Dataflow ID]&" - "&[Dataflow Query Name], type text),
				    // Split the tilde-delimited workspace~dataflow name into separate columns
				    #"Split Column by Delimiter" = Table.SplitColumn(#"Added Custom", "Workspace Name - Dataflow Name", Splitter.SplitTextByEachDelimiter({"~"}, QuoteStyle.Csv, false), {"Workspace Name - Dataflow Name.1", "Workspace Name - Dataflow Name.2"}),
				    // Trim whitespace from the split workspace and dataflow name values
				    #"Trimmed Text" = Table.TransformColumns(#"Split Column by Delimiter",{{"Workspace Name - Dataflow Name.1", Text.Trim, type text}, {"Workspace Name - Dataflow Name.2", Text.Trim, type text}}),
				    // Rename the split columns to Workspace Name and DataflowName
				    #"Renamed Columns1" = Table.RenameColumns(#"Trimmed Text",{{"Workspace Name - Dataflow Name.1", "Workspace Name"}, {"Workspace Name - Dataflow Name.2", "DataflowName"}}),
				    // Recreate the workspace-dataflow composite key with cleaned values
				    #"Added Custom1" = Table.AddColumn(#"Renamed Columns1", "Workspace Name - Dataflow Name", each [Workspace Name]&" - "&[DataflowName], type text),
				    // Remove the temporary DataflowName column (already captured in composite key and Dataflow Name)
				    #"Removed Columns" = Table.RemoveColumns(#"Added Custom1",{"DataflowName"}),
				    // Join with Power BI Workspaces to resolve the Workspace ID
				    #"Merged Queries" = Table.NestedJoin(#"Removed Columns", {"Workspace Name"}, #"Power BI Workspaces", {"WorkspaceName"}, "Power BI Workspaces", JoinKind.LeftOuter),
				    // Expand the Workspace ID from the joined workspaces table
				    #"Expanded Power BI Workspaces" = Table.ExpandTableColumn(#"Merged Queries", "Power BI Workspaces", {"WorkspaceId"}, {"Workspace ID"}),
				    // Create a composite key combining workspace, dataflow name, and query name
				    #"Added Custom2" = Table.AddColumn(#"Expanded Power BI Workspaces", "Workspace Name - Dataflow Name - Query Name", each [Workspace Name]&" - "&[Dataflow Name]&" - "&[Dataflow Query Name], type text)
				in
				    #"Added Custom2"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

