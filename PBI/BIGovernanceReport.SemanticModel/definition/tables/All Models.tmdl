				    // Create composite key: Model - ObjectType - Table - ObjectName
				    #"Added Custom4" = Table.AddColumn(#"Replaced Value2", "ModelName - ObjectType - TableName - ObjectName", each [Model Name]&" - "&[Object Type]&" - "&[Table Name]&" - "&[Object Name], type text),
				    // Create composite key: Workspace - Model - ObjectType - Table - ObjectName
				    #"Added Custom5" = Table.AddColumn(#"Added Custom4", "WorkspaceName - ModelName - ObjectType - TableName - ObjectName", each [Workspace Name]&" - "&[Model Name]&" - "&[Object Type]&" - "&[Table Name]&" - "&[Object Name], type text),
				    // Rename DatasetDescription to Model Description for clarity
				    #"Renamed Columns2" = Table.RenameColumns(#"Added Custom5",{{"DatasetDescription", "Model Description"}}),
				    // Replace null dataflow-related values with N/A
				    #"Replaced Value3" = Table.ReplaceValue(#"Renamed Columns2",null,"N/A",Replacer.ReplaceValue,{"Dataflow ID used in Partition", "Dataflow Query Name", "Dataflow ID - Query Name", "Dataflow Name", "Dataflow Query Expression"}),
				    // Default null Report Level Measure Flag to False
				    #"Replaced Value4" = Table.ReplaceValue(#"Replaced Value3",null,"False",Replacer.ReplaceValue,{"Report Level Measure Flag"}),
				    // Add numeric sort order based on Object Type for hierarchical display
				    #"Added Conditional Column1" = Table.AddColumn(#"Replaced Value4", "Object Type Sort Order", each if [Object Type] = "Table" then 3 else if [Object Type] = "Column" then 4 else if [Object Type] = "CalculatedColumn" then 5 else if [Object Type] = "Measure" then 9 else if [Object Type] = "Hierarchy" then 6 else if [Object Type] = "Level" then 7 else if [Object Type] = "Partition" then 1 else if [Object Type] = "Relationship" then 2 else if [Object Type] = "CalculationGroup" then 8 else null, type number),
				    // Create composite key: Dataflow Name - Query Name
				    #"Added Custom6" = Table.AddColumn(#"Added Conditional Column1", "Dataflow Name - Query Name", each [Dataflow Name]&" - "&[Dataflow Query Name], type text),
				    // Create composite key: Workspace Name - Dataflow Name
				    #"Added Custom7" = Table.AddColumn(#"Added Custom6", "Workspace Name - Dataflow Name", each [Workspace Name]&" - "&[Dataflow Name], type text),
				    // Create composite key: Workspace - Dataflow - Model Name
				    #"Added Custom8" = Table.AddColumn(#"Added Custom7", "Workspace Name - Datafow Name - Model Name", each [Workspace Name]&" - "&[Dataflow Name]&" - "&[Model Name], type text),
				    // Create temporary composite key: Workspace - ModelID - Table Name
				    #"Added Custom9" = Table.AddColumn(#"Added Custom8", "Temp Workspace Name - Model ID - Table Name", each [Workspace Name]&" - "&[Model ID]&" - "&[Table Name], type text),
				    // Conditionally set Workspace-ModelID-Table key only for applicable object types
				    #"Added Conditional Column2" = Table.AddColumn(#"Added Custom9", "Workspace Name - Model ID - Table Name", each if [Object Type] = "Relationship" then [#"Temp Workspace Name - Model ID - Table Name"] else if [Object Type] = "Measure" then [#"Temp Workspace Name - Model ID - Table Name"] else if [Object Type] = "Column" then [#"Temp Workspace Name - Model ID - Table Name"] else if [Object Type] = "Level" then [#"Temp Workspace Name - Model ID - Table Name"] else null, type text),
