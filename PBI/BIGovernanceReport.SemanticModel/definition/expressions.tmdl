expression 'Visual Objects' =
		let
		    // Load raw visual object data from the base report query
		    Source = #"Base Visuals Objects",
		    // Create a composite key combining workspace and report name
		    #"Added Custom" = Table.AddColumn(Source, "Workspace Name - Report Name", each [WorkspaceName]&" - "&[ReportName], type text),
		    // Filter out rows where ReportDate is null or empty (invalid snapshots)
		    #"Removed Errors" = Table.SelectRows(#"Added Custom", each try [ReportDate] <> null and [ReportDate] <> "" otherwise false),
		    // Fallback: use ReportName as ReportID when ReportID is missing or blank
		    #"Added Conditional Column" = Table.AddColumn(#"Removed Errors", "Custom", each if [ReportID] = "" then [ReportName] else if [ReportID] = null then [ReportName] else [ReportID], type text),
		    // Drop the original ReportID column to replace with the resolved version
		    #"Removed Columns" = Table.RemoveColumns(#"Added Conditional Column",{"ReportID"}),
		    // Rename the resolved column back to ReportID
		    #"Renamed Columns" = Table.RenameColumns(#"Removed Columns",{{"Custom", "ReportID"}}),
		    // Tag all rows with the "Visual Objects" category for downstream filtering
		    #"Added Custom1" = Table.AddColumn(#"Renamed Columns", "Category", each "Visual Objects", type text),
		    // Extract the hierarchy parent table name for hierarchy-type objects (Table.Field format)
		    #"Added Conditional Column1" = Table.AddColumn(#"Added Custom1", "Object Type Temp", each if [ObjectType] = "Hierarchy" then [ObjectName] else null, type text),
		    // Split the hierarchy "Table.Field" name into parent and child parts
		    #"Split Column by Delimiter" = Table.SplitColumn(#"Added Conditional Column1", "Object Type Temp", Splitter.SplitTextByEachDelimiter({"."}, QuoteStyle.Csv, false), {"Object Type Temp.1", "Object Type Temp.2"}),
		    // Use the hierarchy child name as the display name; keep original for non-hierarchies
		    #"Added Conditional Column2" = Table.AddColumn(#"Split Column by Delimiter", "Object Name", each if [Object Type Temp.2] = null then [ObjectName] else [Object Type Temp.2], type text),
		    // Preserve the original ObjectName before renaming for reference
		    #"Duplicated Column" = Table.DuplicateColumn(#"Added Conditional Column2", "ObjectName", "Original ObjectName"),
		    // Preserve the original ObjectType before reclassifying hierarchies
		    #"Duplicated Column1" = Table.DuplicateColumn(#"Duplicated Column", "ObjectType", "Original ObjectType"),
		    // Reclassify "Hierarchy" objects as "Level" to reflect their actual usage
		    #"Replaced Value" = Table.ReplaceValue(#"Duplicated Column1","Hierarchy","Level",Replacer.ReplaceValue,{"ObjectType"}),
		    // Remove intermediate columns and keep the cleaned object name
		    #"Removed Columns1" = Table.RemoveColumns(#"Replaced Value",{"ObjectName", "Object Type Temp.1", "Object Type Temp.2"}),
		    // Standardize column names: Object Name → ObjectName, AppliedFilterVersion → AppliedFilter, PageId → PageID
		    #"Renamed Columns1" = Table.RenameColumns(#"Removed Columns1",{{"Object Name", "ObjectName"}, {"AppliedFilterVersion", "AppliedFilter"}, {"PageId", "PageID"}}),
		    // Convert the AppliedFilter field to a readable True/False flag
		  #"Replaced Value1" = Table.TransformColumns(
		        #"Renamed Columns1",
		        {
		            {"AppliedFilter", each if _ <> "" and _ <> null then "True" else "False", type text}
		        }
		    ),
		    // Determine if the visual acts as a slicer filter based on the applied filter flag
		  #"Added Conditional Column3" = Table.AddColumn(#"Replaced Value1", "Filter?", each if [AppliedFilter] = "True" then "Slicer Filter" else "N/A", type text),
		    // Set the filter type to "Categorical" for slicer-filtered visuals, "N/A" otherwise
		  #"Added Conditional Column4" = Table.AddColumn(#"Added Conditional Column3", "FilterType", each if [#"Filter?"] <> "N/A" then "Categorical" else "N/A", type text),
		    // Rename Source to ObjectSource to avoid conflicts with the Power Query Source keyword
		    #"Renamed Columns2" = Table.RenameColumns(#"Added Conditional Column4",{{"Source", "ObjectSource"}}),
		    // Create a workspace-report-page composite key for page-level joins
		    #"Added Custom2" = Table.AddColumn(#"Renamed Columns2", "Workspace Name - Report Name - Page Name", each [WorkspaceName]&" - "&[ReportName]&" - "&[PageName], type text),
		    // Create a workspace-report-page-visual composite key for visual-level joins
		    #"Added Custom3" = Table.AddColumn(#"Added Custom2", "Workspace Name - Report Name - Page Name - Visual ID", each [WorkspaceName]&" - "&[ReportName]&" - "&[PageName]&" - "&[VisualId], type text),
		    // Create an alternate page key using IDs instead of names for reliable matching
		    #"Added Custom4" = Table.AddColumn(#"Added Custom3", "Workspace Name - ReportID - ModelID - PageName", each [WorkspaceName]&" - "&[ReportID]&" - "&[ModelID]&" - "&[PageName], type text),
		    // Add a sequential index for row ordering
		    #"Added Index" = Table.AddIndexColumn(#"Added Custom4", "Index", 1, 1, Int64.Type),
		    // Create a unique page identifier for page-level lookups
		    #"Added Custom5" = Table.AddColumn(#"Added Index", "UniquePageID", each [WorkspaceName]&" - "&[ReportID]&" - "&[ModelID]&" - "&[PageID], type text),
		    // Join with Visuals to get visual layout properties (position, size, visibility)
		    #"Merged Queries" = Table.NestedJoin(#"Added Custom5", {"Workspace Name - Report Name - Page Name - Visual ID"}, Visuals, {"Workspace Name - Report Name - Page Name - Visual ID"}, "Visuals", JoinKind.LeftOuter),
		    // Expand the visual layout fields from the joined Visuals table
		    #"Expanded Visuals" = Table.ExpandTableColumn(#"Merged Queries", "Visuals", {"VisualHiddenFlag", "Visual Y Position", "Visual Z Position", "Visual Height", "Visual Width", "Visual X Position"}, {"VisualHiddenFlag", "Visual Y Position", "Visual Z Position", "Visual Height", "Visual Width", "Visual X Position"}),
		    // Join with Pages to get page dimensions for layout analysis
		    #"Merged Queries1" = Table.NestedJoin(#"Expanded Visuals", {"UniquePageID"}, Pages, {"UniquePageID"}, "Pages", JoinKind.LeftOuter),
		    // Expand page width and height from the joined Pages table
		    #"Expanded Pages" = Table.ExpandTableColumn(#"Merged Queries1", "Pages", {"PageWidth", "PageHeight"}, {"PageWidth", "PageHeight"})
		in
		    #"Expanded Pages"
