expression ColumnsUsedinCalculatedColumns =
		let
		    // Load the calculated column dependency data from the base query
		    Source = #"Base Calculated Column Dependencies",
		    // Keep only dependencies where a calculated column references a column
		    #"Filtered Rows" = Table.SelectRows(Source, each ([DependsOnType] = "Column")),
		    // Split the DependsOn reference at the first single quote to extract table name
		    #"Split Column by Delimiter1" = Table.SplitColumn(#"Filtered Rows", "DependsOn", Splitter.SplitTextByEachDelimiter({"'"}, QuoteStyle.Csv, false), {"DependsOn.1", "DependsOn.2"}),
		    // Split again at the closing single quote to separate table name from column name
		    #"Split Column by Delimiter2" = Table.SplitColumn(#"Split Column by Delimiter1", "DependsOn.2", Splitter.SplitTextByEachDelimiter({"'"}, QuoteStyle.Csv, false), {"DependsOn.2.1", "DependsOn.2.2"}),
		    // Remove the opening bracket from the column name reference
		    #"Replaced Value" = Table.ReplaceValue(#"Split Column by Delimiter2","[","",Replacer.ReplaceText,{"DependsOn.2.2"}),
		    // Remove the closing bracket from the column name reference
		    #"Replaced Value1" = Table.ReplaceValue(#"Replaced Value","]","",Replacer.ReplaceText,{"DependsOn.2.2"}),
		    // Rename parsed columns to standardized names
		    #"Renamed Columns" = Table.RenameColumns(#"Replaced Value1",{{"DependsOn.2.1", "Table Name"}, {"DependsOn.2.2", "Object Name"}, {"DependsOnType", "Object Type"}}),
		    // Keep only the columns needed for usage tracking
		    #"Removed Other Columns" = Table.SelectColumns(#"Renamed Columns",{"Table Name", "Object Name", "Object Type", "WorkspaceName", "ModelName", "ModelID"}),
		    // Create a workspace-model-object composite key for cross-workspace lookups
		    #"Added Custom" = Table.AddColumn(#"Removed Other Columns", "WorkspaceName - ModelName - ObjectType - TableName - ObjectName", each [WorkspaceName]&" - "&[ModelName]&" - "&[Object Type]&" - "&[Table Name]&" - "&[Object Name], type text),
		    // Create a model-level composite key using ModelID for unique object identification
		    #"Added Custom1" = Table.AddColumn(#"Added Custom", "ModelID - ObjectType - TableName - ObjectName", each [ModelID]&" - "&[Object Type]&" - "&[Table Name]&" - "&[Object Name], type text),
		    // Tag the usage source as "Calculated Columns"
		    #"Added Custom2" = Table.AddColumn(#"Added Custom1", "Object Used In", each "Calculated Columns", type text),
		    // Trim whitespace from the deduplication key
		    #"Trimmed Text1" = Table.TransformColumns(#"Added Custom2",{{"WorkspaceName - ModelName - ObjectType - TableName - ObjectName", Text.Trim, type text}}),
		    // Normalize case for consistent deduplication
		    #"Cleaned Text" = Table.TransformColumns(#"Trimmed Text1",{{"WorkspaceName - ModelName - ObjectType - TableName - ObjectName", Text.Proper, type text}}),
		    // We need the general usage flags to be at the Model level, not Workspace & Model. Model ID ensures it's still unique to a specific Model but doesn't incorrectly filter out usage based on Workspace. At the Model level, if an object is used anywhere, regardless of workspace, it is used and will affect reports. Exact usage location is via Report detail.
		    #"Removed Duplicates" = Table.Distinct(#"Cleaned Text", {"WorkspaceName - ModelName - ObjectType - TableName - ObjectName"})
		in
		    #"Removed Duplicates"
