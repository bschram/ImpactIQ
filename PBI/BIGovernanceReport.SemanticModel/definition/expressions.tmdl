	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression 'RLS Expression Parsing' =
		let
		    Source = (expression as nullable text) as table =>
		let
		    Source =
		        if expression = null
		        then ""
		        else expression,
		
		    // ========================================================
		    // QUOTED TABLE REFERENCES
		    //
		    // Handles:
		    // 'Hello Table'
		    // 'Hello Table'[Column]
		    // ========================================================
		
		    SplitByQuote =
		        Text.Split(Source, "'"),
		
		    IndexedQuoteParts =
		        Table.AddIndexColumn(
		            Table.FromList(
		                SplitByQuote,
		                Splitter.SplitByNothing(),
		                {"Text"}
		            ),
		            "Index",
		            0,
		            1,
		            Int64.Type
		        ),
		
		    QuotedTableParts =
		        Table.SelectRows(
		            IndexedQuoteParts,
		            each Number.Mod([Index], 2) = 1
		        ),
		
		    AddFollowingText =
		        Table.AddColumn(
		            QuotedTableParts,
		            "FollowingText",
		            each
		                try SplitByQuote{[Index] + 1}
		                otherwise "",
		            type text
		        ),
		
		    AddQuotedColumn =
		        Table.AddColumn(
		            AddFollowingText,
		            "Column",
		            each
		                let
		                    FollowingText =
		                        Text.TrimStart([FollowingText])
		                in
		                    if Text.StartsWith(FollowingText, "[")
		                    then
		                        try
		                            Text.BetweenDelimiters(
		                                FollowingText,
		                                "[",
		                                "]"
		                            )
		                        otherwise
		                            null
		                    else
		                        null,
		            type nullable text
		        ),
		
		    RenameQuotedTable =
		        Table.RenameColumns(
		            AddQuotedColumn,
		            {{"Text", "Table"}}
		        ),
		
		    AddQuotedMeasure =
		        Table.AddColumn(
		            RenameQuotedTable,
		            "Measure",
		            each null,
		            type nullable text
		        ),
		
		    SelectQuotedColumns =
		        Table.SelectColumns(
		            AddQuotedMeasure,
		            {
		                "Table",
		                "Column",
		                "Measure"
		            }
		        ),
		
		    RemoveInvalidQuotedTables =
		        Table.SelectRows(
		            SelectQuotedColumns,
		            each
		                [Table] <> null
		                and Text.Trim([Table]) <> ""
		        ),
		
		    // ========================================================
		    // REMOVE QUOTED TABLE REFERENCES
		    //
		    // Also removes the qualified column following a quoted
		    // table so it is not mistaken for a measure.
		    // ========================================================
		
		    QuotePartIndexes =
		        List.Positions(SplitByQuote),
		
		    CleanedQuoteParts =
		        List.Transform(
		            QuotePartIndexes,
		            (CurrentIndex) =>
		                if Number.Mod(CurrentIndex, 2) = 1
		                then
		                    ""
		                else
		                    let
		                        CurrentText =
		                            SplitByQuote{CurrentIndex},
		
		                        FollowsQuotedTable =
		                            CurrentIndex > 0
		                            and Number.Mod(CurrentIndex - 1, 2) = 1,
		
		                        TrimmedText =
		                            Text.TrimStart(CurrentText),
		
		                        StartsWithColumn =
		                            FollowsQuotedTable
		                            and Text.StartsWith(
		                                TrimmedText,
		                                "["
		                            ),
		
		                        RemainingText =
		                            if StartsWithColumn
		                            then
		                                try
		                                    Text.AfterDelimiter(
		                                        TrimmedText,
		                                        "]"
		                                    )
		                                otherwise
		                                    ""
		                            else
		                                CurrentText
		                    in
		                        RemainingText
		        ),
		
		    UnquotedExpression =
		        Text.Combine(CleanedQuoteParts, " "),
		
		    // ========================================================
		    // FIND BRACKET REFERENCES
		    //
		    // Handles:
		    // Hello[Column]
		    // [Measure]
		    // ========================================================
		
		    CharacterPositions =
		        List.Positions(
		            Text.ToList(UnquotedExpression)
		        ),
		
		    OpeningBracketPositions =
		        List.Select(
		            CharacterPositions,
		            each
		                Text.Middle(
		                    UnquotedExpression,
		                    _,
		                    1
		                ) = "["
		        ),
		
		    BracketReferenceRecords =
		        List.RemoveNulls(
		            List.Transform(
		                OpeningBracketPositions,
		                (OpeningPosition) =>
		                    let
		                        TextAfterOpening =
		                            Text.Range(
		                                UnquotedExpression,
		                                OpeningPosition + 1
		                            ),
		
		                        ClosingOffset =
		                            Text.PositionOf(
		                                TextAfterOpening,
		                                "]"
		                            ),
		
		                        ObjectName =
		                            if ClosingOffset >= 0
		                            then
		                                Text.Start(
		                                    TextAfterOpening,
		                                    ClosingOffset
		                                )
		                            else
		                                null,
		
		                        TextBeforeOpening =
		                            Text.Start(
		                                UnquotedExpression,
		                                OpeningPosition
		                            ),
		
		                        TrimmedBeforeOpening =
		                            Text.TrimEnd(TextBeforeOpening),
		
		                        PreviousCharacter =
		                            if Text.Length(TrimmedBeforeOpening) > 0
		                            then
		                                Text.End(
		                                    TrimmedBeforeOpening,
		                                    1
		                                )
		                            else
		                                "",
		
		                        IsLetter =
		                            PreviousCharacter <> ""
		                            and Text.Contains(
		                                "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz",
		                                PreviousCharacter
		                            ),
		
		                        IsNumber =
		                            PreviousCharacter <> ""
		                            and Text.Contains(
		                                "0123456789",
		                                PreviousCharacter
		                            ),
		
		                        HasUnquotedTable =
		                            IsLetter
		                            or IsNumber
		                            or PreviousCharacter = "_",
		
		                        ReverseBeforeOpening =
		                            Text.Reverse(
		                                TrimmedBeforeOpening
		                            ),
		
		                        TableDelimiterPosition =
		                            Text.PositionOfAny(
		                                ReverseBeforeOpening,
		                                {
		                                    " ",
		                                    "(",
		                                    ")",
		                                    ",",
		                                    "=",
		                                    "+",
		                                    "-",
		                                    "*",
		                                    "/",
		                                    "<",
		                                    ">",
		                                    "&",
		                                    "|"
		                                }
		                            ),
		
		                        TableNameLength =
		                            if TableDelimiterPosition = -1
		                            then Text.Length(ReverseBeforeOpening)
		                            else TableDelimiterPosition,
		
		                        UnquotedTableName =
		                            if HasUnquotedTable
		                            then
		                                Text.Reverse(
		                                    Text.Start(
		                                        ReverseBeforeOpening,
		                                        TableNameLength
		                                    )
		                                )
		                            else
		                                null
		                    in
		                        if ObjectName = null
		                            or Text.Trim(ObjectName) = ""
		                        then
		                            null
		                        else if HasUnquotedTable
		                        then
		                            [
		                                Table =
		                                    Text.Trim(UnquotedTableName),
		                                Column =
		                                    Text.Trim(ObjectName),
		                                Measure = null
		                            ]
		                        else
		                            [
		                                Table = null,
		                                Column = null,
		                                Measure =
		                                    Text.Trim(ObjectName)
		                            ]
		            )
		        ),
		
		    BracketReferences =
		        if List.IsEmpty(BracketReferenceRecords)
		        then
		            #table(
		                type table [
		                    Table = nullable text,
		                    Column = nullable text,
		                    Measure = nullable text
		                ],
		                {}
		            )
		        else
		            Table.FromRecords(
		                BracketReferenceRecords,
		                type table [
		                    Table = nullable text,
		                    Column = nullable text,
		                    Measure = nullable text
		                ]
		            ),
		
		    Combined =
		        Table.Combine(
		            {
		                RemoveInvalidQuotedTables,
		                BracketReferences
		            }
		        ),
		
		    RemoveInvalid =
		        Table.SelectRows(
		            Combined,
		            each
		                [Table] <> null
		                or [Column] <> null
		                or [Measure] <> null
		        ),
		
		    RemoveDuplicates =
		        Table.Distinct(RemoveInvalid)
		in
		    RemoveDuplicates
		in
		    Source
	lineageTag: c6f81033-3ce7-40d5-8da7-ac66f4d433b3
