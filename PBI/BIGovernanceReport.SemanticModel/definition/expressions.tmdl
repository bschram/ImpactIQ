		    // Create a composite key combining workspace and dataflow name for lookups
		    #"Added Custom" = Table.TransformColumnTypes(Table.AddColumn(#"Removed Other columns", "Workspace Name - Dataflow Name", each [WorkspaceName] & " - " & [DataflowName]), {{"Workspace Name - Dataflow Name", type text}})
