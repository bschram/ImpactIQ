expression 'Visual Filters' =
		let
		    // INNER QUERY: Build a supplemental visual filter table from visual objects not already in the base visual filters
		    VisualObjectFilters=let
		    // SUB-QUERY: Load the original visual filters to identify which objects already have explicit filters
		    OriginalVisualFilters=let
		    // Load raw visual filter data from the base report detail query
		    Source = #"Base Visual Filters",
		    // Create a workspace-report composite key for joining
		    #"Added Custom" = Table.AddColumn(Source, "Workspace Name - Report Name", each [WorkspaceName]&" - "&[ReportName], type text),
		    // Standardize the PageId column name to PageID
		    #"Renamed Columns" = Table.RenameColumns(#"Added Custom",{{"PageId", "PageID"}}),
		    // Create a composite key uniquely identifying each visual-object-filter combination
		    #"Added Custom1" = Table.AddColumn(#"Renamed Columns", "WorkspaceName - ReportName - PageName - VisualId - TableName - ObjectName - Obje", each [WorkspaceName]&" - "&[ReportName]&" - "&[PageName]&" - "&[VisualId]&" - "&[TableName]&" - "&[ObjectName]&" - "&[ObjectType], type text),
		    #"Trimmed Text" = Table.TransformColumns(#"Added Custom1",{{"WorkspaceName - ReportName - PageName - VisualId - TableName - ObjectName - Obje", Text.Trim, type text}}),
		    #"Cleaned Text" = Table.TransformColumns(#"Trimmed Text",{{"WorkspaceName - ReportName - PageName - VisualId - TableName - ObjectName - Obje", Text.Proper, type text}})
		in
		    #"Cleaned Text",
		    // Load the visual objects (fields used in visuals) to find implicit filters
		    Source = #"Base Visuals Objects",
		    // Create a workspace-report composite key for joining
		    #"Added Custom" = Table.AddColumn(Source, "Workspace Name - Report Name", each [WorkspaceName]&" - "&[ReportName], type text),
		    // Create the same composite key as OriginalVisualFilters for matching
		    #"Added Custom1" = Table.AddColumn(#"Added Custom", "WorkspaceName - ReportName - PageName - VisualId - TableName - ObjectName - Obje", each [WorkspaceName]&" - "&[ReportName]&" - "&[PageName]&" - "&[VisualId]&" - "&[TableName]&" - "&[ObjectName]&" - "&[ObjectType], type text),
		    // Standardize the PageId column name to PageID
		    #"Renamed Columns" = Table.RenameColumns(#"Added Custom1",{{"PageId", "PageID"}}),
		    // Keep only Column, Hierarchy, and Measure objects (filter-eligible types)
		    #"Filtered Rows" = Table.SelectRows(#"Renamed Columns", each ([ObjectType] = "Column" or [ObjectType] = "Hierarchy" or [ObjectType] = "Measure")),
		    // Select only the columns needed for the anti-join comparison
		    #"Removed Other Columns" = Table.SelectColumns(#"Filtered Rows",{"WorkspaceName", "ReportName", "ReportID", "ModelID", "PageName", "PageID", "VisualId", "TableName", "ObjectType", "ObjectName", "DisplayName", "WorkspaceName - ReportName - PageName - VisualId - TableName - ObjectName - Obje", "Workspace Name - Report Name", "ReportDate"}),
		    #"Trimmed Text" = Table.TransformColumns(#"Removed Other Columns",{{"WorkspaceName - ReportName - PageName - VisualId - TableName - ObjectName - Obje", Text.Trim, type text}}),
		    #"Cleaned Text" = Table.TransformColumns(#"Trimmed Text",{{"WorkspaceName - ReportName - PageName - VisualId - TableName - ObjectName - Obje", Text.Proper, type text}}),
		    // Left anti-join: find visual objects that do NOT already have an explicit visual filter
		    #"Merged Queries" = Table.NestedJoin(#"Cleaned Text", {"WorkspaceName - ReportName - PageName - VisualId - TableName - ObjectName - Obje"}, OriginalVisualFilters, {"WorkspaceName - ReportName - PageName - VisualId - TableName - ObjectName - Obje"}, "Visual Filters (2)", JoinKind.LeftOuter),
		    // Expand the match key to check for null (unmatched = no existing filter)
		    #"Expanded Visual Filters" = Table.ExpandTableColumn(#"Merged Queries", "Visual Filters (2)", {"WorkspaceName - ReportName - PageName - VisualId - TableName - ObjectName - Obje"}, {"WorkspaceName - ReportName - PageName - VisualId - TableName - ObjectName - Ob.1"}),
		    // Keep only rows where no matching explicit filter was found (anti-join result)
		    #"Filtered Rows1" = Table.SelectRows(#"Expanded Visual Filters", each [#"WorkspaceName - ReportName - PageName - VisualId - TableName - ObjectName - Ob.1"] = null),
		    // Assign default filter types based on object type (Categorical for columns/hierarchies, Advanced for measures)
		    #"Added Conditional Column" = Table.AddColumn(#"Filtered Rows1", "FilterType", each if [ObjectType] = "Column" then "Categorical" else if [ObjectType] = "Measure" then "Advanced" else if [ObjectType] = "Hierarchy" then "Categorical" else "N/A", type text),
		    // Set HiddenFilter to False (implicit filters are not hidden)
		    #"Added Custom2" = Table.AddColumn(#"Added Conditional Column", "HiddenFilter", each "False", type text),
		    // Set LockedFilter to empty (implicit filters are not locked)
		    #"Added Custom3" = Table.AddColumn(#"Added Custom2", "LockedFilter", each "", type text),
		    // Set AppliedFilterVersion to empty (no explicit filter applied)
		    #"Added Custom4" = Table.AddColumn(#"Added Custom3", "AppliedFilterVersion", each "", type text),
		    // Remove the temporary composite key columns used for matching
		    #"Removed Columns" = Table.RemoveColumns(#"Added Custom4",{"WorkspaceName - ReportName - PageName - VisualId - TableName - ObjectName - Obje", "WorkspaceName - ReportName - PageName - VisualId - TableName - ObjectName - Ob.1"})
		in
		    #"Removed Columns",
		    // MAIN QUERY: Combine explicit visual filters with the supplemental implicit filters
		    // Load the original base visual filters
		    Source = #"Base Visual Filters",
		    // Create a workspace-report composite key for joining
		    #"Added Custom" = Table.AddColumn(Source, "Workspace Name - Report Name", each [WorkspaceName]&" - "&[ReportName], type text),
		    // Standardize the PageId column name to PageID
		    #"Renamed Columns" = Table.RenameColumns(#"Added Custom",{{"PageId", "PageID"}}),
		    // Remove Include/Exclude filter types (handled elsewhere)
		    #"Filtered Rows" = Table.SelectRows(#"Renamed Columns", each ([FilterType] <> "Include" and [FilterType] <> "Exclude")),
		    // Append the implicit visual object filters to the explicit filters
		    #"Appended Query" = Table.Combine({#"Filtered Rows", VisualObjectFilters}),
		    // Remove rows with null or empty ReportDate (invalid records)
		    #"Removed Errors" = Table.SelectRows(#"Appended Query", each try [ReportDate] <> null and [ReportDate] <> "" otherwise false),
		    // Use ReportName as fallback when ReportID is missing or empty
		    #"Added Conditional Column" = Table.AddColumn(#"Removed Errors", "Custom", each if [ReportID] = "" then [ReportName] else if [ReportID] = null then [ReportName] else [ReportID], type text),
		    // Drop the original ReportID column to replace with the resolved version
		    #"Removed Columns" = Table.RemoveColumns(#"Added Conditional Column",{"ReportID"}),
		    // Rename resolved ReportID and standardize the AppliedFilter column name
		    #"Renamed Columns1" = Table.RenameColumns(#"Removed Columns",{{"Custom", "ReportID"}, {"AppliedFilterVersion", "AppliedFilter"}}),
		    // Tag all rows with the "Visual Filters" category for downstream filtering
		    #"Added Custom1" = Table.AddColumn(#"Renamed Columns1", "Category", each "Visual Filters", type text),
		    // Set filter flag to "Visual Filter" for all rows
		    #"Added Custom2" = Table.AddColumn(#"Added Custom1", "Filter?", each "Visual Filter", type text),
		    // Convert filter state columns (Applied, Hidden, Locked) to True/False text flags
		    #"Replaced Value" = Table.TransformColumns(
		            #"Added Custom2",
		            {
		                {"AppliedFilter", each if _ <> "" and _ <> null then "True" else "False", type text},
		                {"HiddenFilter", each if _ <> "" and _ <> null then "True" else "False", type text},
		                {"LockedFilter", each if _ <> "" and _ <> null then "True" else "False", type text}
		            }
		        ),
		    // Extract hierarchy parent for hierarchy-type objects
		    #"Added Conditional Column1" = Table.AddColumn(#"Replaced Value", "Object Type Temp", each if [ObjectType] = "Hierarchy" then [ObjectName] else null, type text),
		    // Split the hierarchy path into parent and child parts at the dot delimiter
		    #"Split Column by Delimiter" = Table.SplitColumn(#"Added Conditional Column1", "Object Type Temp", Splitter.SplitTextByEachDelimiter({"."}, QuoteStyle.Csv, false), {"Object Type Temp.1", "Object Type Temp.2"}),
		    // Resolve the object name: use the child part for hierarchies, original name otherwise
		    #"Added Conditional Column2" = Table.AddColumn(#"Split Column by Delimiter", "Object Name", each if [Object Type Temp.2] = null then [ObjectName] else [Object Type Temp.2], type text),
		    // Preserve the original ObjectName before renaming for lineage tracking
		    #"Duplicated Column" = Table.DuplicateColumn(#"Added Conditional Column2", "ObjectName", "Original ObjectName"),
		    // Preserve the original ObjectType before renaming for lineage tracking
		    #"Duplicated Column1" = Table.DuplicateColumn(#"Duplicated Column", "ObjectType", "Original ObjectType"),
		    // Reclassify Hierarchy objects as Column for consistent model object matching
		    #"Replaced Value1" = Table.ReplaceValue(#"Duplicated Column1","Hierarchy","Column",Replacer.ReplaceValue,{"ObjectType"}),
		    // Remove the temporary hierarchy split columns and original ObjectName
		    #"Removed Columns1" = Table.RemoveColumns(#"Replaced Value1",{"ObjectName", "Object Type Temp.1", "Object Type Temp.2"}),
		    // Rename the resolved Object Name column to ObjectName
		    #"Renamed Columns2" = Table.RenameColumns(#"Removed Columns1",{{"Object Name", "ObjectName"}}),
		    // Replace empty-string ObjectType values with null for consistent handling
		    #"Replaced Value2" = Table.ReplaceValue(#"Renamed Columns2","""""",null,Replacer.ReplaceValue,{"ObjectType"}),
		    // Create a workspace-report-page navigation key
		    #"Added Custom3" = Table.AddColumn(#"Replaced Value2", "Workspace Name - Report Name - Page Name", each [WorkspaceName]&" - "&[ReportName]&" - "&[PageName], type text),
		    // Create a composite key using IDs for precise page matching
		    #"Added Custom4" = Table.AddColumn(#"Added Custom3", "Workspace Name - ReportID - ModelID - PageName", each [WorkspaceName]&" - "&[ReportID]&" - "&[ModelID]&" - "&[PageName], type text),
		    // Create a workspace-report-page-visual composite key for visual-level joins
		    #"Added Custom5" = Table.AddColumn(#"Added Custom4", "Workspace Name - Report Name - Page Name - Visual ID", each [WorkspaceName]&" - "&[ReportName]&" - "&[PageName]&" - "&[VisualId], type text),
		    // Add a sequential index for row ordering
		    #"Added Index" = Table.AddIndexColumn(#"Added Custom5", "Index", 1, 1, Int64.Type),
		    // Create a unique page identifier for page-level joins
		    #"Added Custom6" = Table.AddColumn(#"Added Index", "UniquePageID", each [WorkspaceName]&" - "&[ReportID]&" - "&[ModelID]&" - "&[PageID], type text),
		    // Left join with Visuals to get visual position and visibility metadata
		    #"Merged Queries" = Table.NestedJoin(#"Added Custom6", {"Workspace Name - Report Name - Page Name - Visual ID"}, Visuals, {"Workspace Name - Report Name - Page Name - Visual ID"}, "Visuals", JoinKind.LeftOuter),
		    // Expand the visual's hidden flag and position/dimension fields
		    #"Expanded Visuals" = Table.ExpandTableColumn(#"Merged Queries", "Visuals", {"VisualHiddenFlag", "Visual Y Position", "Visual Z Position", "Visual Height", "Visual Width", "Visual X Position"}, {"VisualHiddenFlag", "Visual Y Position", "Visual Z Position", "Visual Height", "Visual Width", "Visual X Position"}),
		    // Left join with Pages to get page dimensions for layout calculations
