# Copy this file to ImpactIQ.Notify.env and replace values.
# This file is loaded by ImpactIQ.bat before launching the PowerShell script.

# Notification method:
# SMTP    = sends directly via SMTP settings below
# OUTLOOK = sends using your signed-in Outlook desktop profile (no SMTP password needed)
IMPACTIQ_NOTIFY_METHOD=SMTP

# Required for notifications
IMPACTIQ_NOTIFY_SMTP_SERVER=smtp.office365.com
IMPACTIQ_NOTIFY_SMTP_PORT=587
IMPACTIQ_NOTIFY_SMTP_USE_SSL=true
IMPACTIQ_NOTIFY_FROM=impactiq-alerts@yourdomain.gov

# SMTP credentials (if required by your SMTP server)
# For Microsoft 365, use an app password if MFA is enabled on the mailbox.
IMPACTIQ_NOTIFY_SMTP_USERNAME=impactiq-alerts@yourdomain.gov
IMPACTIQ_NOTIFY_SMTP_PASSWORD=REPLACE_WITH_APP_PASSWORD

# Recipients
# Normal email recipients (comma or semicolon separated)
IMPACTIQ_NOTIFY_TO=you@yourdomain.gov

# SMS recipients via email-to-SMS gateway (comma or semicolon separated)
# Verizon:   7015551234@vtext.com
# T-Mobile:  7015551234@tmomail.net
# AT&T:      7015551234@txt.att.net
# US Cellular: 7015551234@email.uscc.net
IMPACTIQ_NOTIFY_SMS_TO=7015551234@vtext.com

# Optional
IMPACTIQ_NOTIFY_SUBJECT=[ImpactIQ] Re-authentication required
IMPACTIQ_NOTIFY_RENOTIFY_MINUTES=15

# Verification toggles
# true = send a test notification at script startup
IMPACTIQ_NOTIFY_TEST_ON_START=false
# true = send test notification and exit before full extraction run
IMPACTIQ_NOTIFY_TEST_ONLY=false
