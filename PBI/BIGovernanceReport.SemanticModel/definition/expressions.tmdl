expression 'Report & Model Mapping' =
		let
		    // --- Inner query: ModelDetailCheck ---
		    // Determines which models have full detail available from the Model Detail extract
		    ModelDetailCheck=let
		    // Load the full semantic model metadata
		    Source = #"Base Semantic Models",
		    // Keep only workspace, model name, and model ID columns
		    #"Removed Other Columns" = Table.SelectColumns(Source,{"WorkspaceName", "ModelName", "ModelID"}),
		    // Ensure ModelID is typed as text for reliable joins
		    #"Changed Type" = Table.TransformColumnTypes(#"Removed Other Columns",{{"ModelID", type text}}),
		    //For Pro Workspaces, the Model ID cannot be extracted from the model itself and has "Workspace Name - Model Name" as its Model ID. This merge is used to pull the TRUE Model ID and use for later steps.
		    #"Merged Queries" = Table.NestedJoin(#"Changed Type", {"ModelID"}, #"Power BI Datasets", {"ModelID"}, "Power BI Datasets", JoinKind.LeftOuter),
		    // Expand the true DatasetId from the datasets table
		    #"Expanded Power BI Datasets" = Table.ExpandTableColumn(#"Merged Queries", "Power BI Datasets", {"DatasetId"}, {"DatasetId"}),
		    // Use DatasetId when available; fall back to original ModelID otherwise
		    #"Added Conditional Column" = Table.AddColumn(#"Expanded Power BI Datasets", "Custom", each if [DatasetId] = null then [ModelID] else [DatasetId], type text),
		    // Drop old ModelID and DatasetId columns
		    #"Removed Columns" = Table.RemoveColumns(#"Added Conditional Column",{"ModelID", "DatasetId"}),
		    // Rename the resolved ID to ModelID
		    #"Renamed Columns1" = Table.RenameColumns(#"Removed Columns",{{"Custom", "ModelID"}}),
		    // Create a workspace-model ID composite key for lookups
		    #"Added Custom" = Table.AddColumn(#"Renamed Columns1", "Workspace Name - Model ID", each [WorkspaceName]&" - "&[ModelID], type text),
		    // Create a workspace-model name composite key for deduplication
		    #"Added Custom1" = Table.AddColumn(#"Added Custom", "Workspace Name - Model Name", each [WorkspaceName]&" - "&[ModelName], type text),
		    // Deduplicate on workspace-model name to get one row per model
		    #"Removed Duplicates" = Table.Distinct(#"Added Custom1", {"Workspace Name - Model Name"}),
		    // Mark these models as having full detail available
		    #"Added Custom2" = Table.AddColumn(#"Removed Duplicates", "Model Detail Available?", each "TRUE", type text)
		
		in
		    #"Added Custom2",
		    // --- Main query: Build the Report-to-Model mapping ---
		    // Load report connection data to link reports to their underlying models
		    Source = #"Base Connections",
		    // Keep only the key identifier columns
		    #"Removed Other Columns" = Table.SelectColumns(Source,{"WorkspaceName", "ReportName", "ReportID", "ModelID"}),
		    // Fallback: use ReportName as ReportID when ReportID is missing or blank
		    #"Added Conditional Column" = Table.AddColumn(#"Removed Other Columns", "Custom", each if [ReportID] = "" then [ReportName] else if [ReportID] = null then [ReportName] else [ReportID], type text),
		    // Drop original ReportID before renaming
		    #"Removed Columns" = Table.RemoveColumns(#"Added Conditional Column",{"ReportID"}),
		    // Rename the fallback column to ReportID
		    #"Renamed Columns" = Table.RenameColumns(#"Removed Columns",{{"Custom", "ReportID"}}),
		    // Create a composite key for workspace-model ID lookups
		    #"Added Custom" = Table.AddColumn(#"Renamed Columns", "Workspace Name - Model ID", each [WorkspaceName]&" - "&[ModelID], type text),
		    //At the Report Level, the Model ID listed is the TRUE Model the Report is connected to. This merge is used to pull other details, such as the Model Name.
		    #"Merged Queries" = Table.NestedJoin(#"Added Custom", {"ModelID"}, ModelDetailCheck, {"ModelID"}, "Power BI Datasets", JoinKind.LeftOuter),
		    // Expand the model detail availability flag
		    #"Expanded ModelDetailCheck" = Table.ExpandTableColumn(#"Merged Queries", "Power BI Datasets", {"Model Detail Available?"}, {"Model Detail Available?"}),
		    // Default to FALSE when no model detail is found
		    #"Replaced Value" = Table.ReplaceValue(#"Expanded ModelDetailCheck",null,"FALSE",Replacer.ReplaceValue,{"Model Detail Available?"}),
		    // At the Report Level, the Model ID listed is the TRUE Model the Report is connected to. This merge is used to pull other details, such as the Model Name.
		    #"Merged Queries1" = Table.NestedJoin(#"Replaced Value", {"ModelID"}, #"Power BI Datasets", {"DatasetId"}, "Power BI Datasets", JoinKind.LeftOuter),
		    // Expand WorkspaceId and DatasetName (used as ModelName)
		    #"Expanded Power BI Datasets" = Table.ExpandTableColumn(#"Merged Queries1", "Power BI Datasets", {"WorkspaceId", "DatasetName", "WorkspaceName"}, {"WorkspaceId", "ModelName", "Model Workspace Name"}),
		    // Default null WorkspaceIds to a placeholder for traceability
		    #"Replaced Value1" = Table.ReplaceValue(#"Expanded Power BI Datasets",null,"Unknown Workspace ID",Replacer.ReplaceValue,{"WorkspaceId"}),
		    // Create a "Partial Model" label prefix for reports without full model detail
		    #"Added Custom1" = Table.AddColumn(#"Replaced Value1", "Custom", each "Partial Model"&" - "&[ReportName], type text),
		    // If there is no match to the Power BI Datasets, it means the model detail is not available. We add "Partial Model" before the name of the Report and use the report-level details to extact info that the report uses for the Model detail.
		    #"Added Conditional Column1" = Table.AddColumn(#"Added Custom1", "ModelName.1", each if [#"Model Detail Available?"] = "FALSE" then [Custom] else [ModelName], type text),
		    // Clean up temporary columns
		    #"Removed Columns1" = Table.RemoveColumns(#"Added Conditional Column1",{"ModelName", "Custom"}),
