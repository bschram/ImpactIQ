table 'All Models'
	lineageTag: 34cff100-e172-4927-b6ee-c95708c6992f

	/// Percentage difference between the number of columns defined in a model versus the number of columns actually used in reports. A high percentage means many columns exist in the model but are never referenced in any report. Helps identify unused columns that could be removed.
	measure 'Count Variance % - Column' = DIVIDE([Count Variance], [Model Object Distinct Count])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: b6db3dfe-7182-40a3-9cb0-8a4244184b41

	/// Percentage difference between the number of measures defined in a model versus the number of measures actually used in reports. A high percentage means many measures exist in the model but are never referenced in any report. Helps identify unused measures that could be removed.
	measure 'Count Variance % - Measure' = DIVIDE([Count Variance], [Model Object Distinct Count])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: a99c61e5-9c2d-432d-988c-c6723e60f445

	/// Percentage difference between total model objects defined versus total model objects actually used in reports. A high percentage indicates significant unused model objects. Combines all object types (measures, columns, hierarchies, etc.).
	measure 'Count Variance %' = DIVIDE([Count Variance], [Model Object Distinct Count])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: bbda47eb-c836-4d73-8f2c-c2f50b4d8188

	/// Numeric difference between columns defined in the model and columns used in reports. A positive number means that many columns exist but are not referenced in any report visual, filter, or other report element.
	measure 'Count Variance - Column' =
			[Model Object Distinct Count - Column]
			    - [Report Objects Distinct Count - Column]
		formatString: #,0
		lineageTag: ca7ea167-4378-4e30-9269-ca8e51d817a0

	/// Numeric difference between measures defined in the model and measures used in reports. A positive number means that many measures exist but are not referenced in any report visual, filter, or other report element.
	measure 'Count Variance - Measure' =
			[Model Object Distinct Count - Measure]
			    - [Report Objects Distinct Count - Measure]
		formatString: #,0
		lineageTag: 93699acd-80e1-40e5-b128-a26b5455e70e

	/// Numeric difference between total model objects defined and total objects used in reports. A positive number means that many objects exist but are not referenced in any report. Combines all object types.
	measure 'Count Variance' = [Model Object Distinct Count]-[Report Objects Distinct Count]
		formatString: #,0
		lineageTag: 536e0f1f-6d53-48ad-9899-9c90e8d7a207

	measure 'Model Dataflow Distinct Count' =
			CALCULATE(
			    DISTINCTCOUNTNOBLANK( 'All Models'[Dataflow Name] ),
			    KEEPFILTERS( 'All Models'[Dataflow Name] <> "N/A" )
			)
		formatString: #,0
		lineageTag: 0e4866db-d078-416d-98dd-d512cbec34dd

	measure 'Model Dataflow Query Distinct Count' =
			CALCULATE(
			    DISTINCTCOUNTNOBLANK( 'All Models'[Dataflow Name - Query Name] ),
			    KEEPFILTERS(
			        'All Models'[Dataflow Name - Query Name] <> "N/A - N/A"
			    )
			)
		formatString: #,0
		lineageTag: 603136df-c444-4f81-963c-a9786bee7063

	/// Counts distinct calculated columns across all models in the current filter context. Calculated columns are DAX expressions that add a column to a table at refresh time. Filter by 'Model Object Hierarchy'[Object Name] to find a specific calculated column.
	measure 'Model Object Distinct Count - Calculated Column' =
			CALCULATE(
			    [Model Object Distinct Count],
			    KEEPFILTERS(
			        'Model Object Hierarchy'[Calculated Column Flag] IN { "True" }
			    )
			)
		formatString: #,0
		lineageTag: 61941b1f-6cc1-4c43-99b3-fa861b6e4346

	/// Counts distinct calculation groups across all models. Calculation groups are special tables that apply reusable DAX logic to measures (e.g. time intelligence patterns).
	measure 'Model Object Distinct Count - Calculation Group' =
			CALCULATE(
			    [Model Object Distinct Count],
			    KEEPFILTERS(
			        'Model Object Hierarchy'[Object Type] IN { "CalculationGroup" }
			    )
			)
		formatString: #,0
		lineageTag: 278cd8b9-c2c5-43cb-95d7-5aab8a355023

	/// Counts distinct columns defined across all models in the current filter context. These are the data columns available in the model. Compare with 'Report Objects Distinct Count - Column' to see how many are actually used in reports.
	measure 'Model Object Distinct Count - Column' =
			CALCULATE(
			    [Model Object Distinct Count],
			    KEEPFILTERS(
			        'Model Object Hierarchy'[Object Type] IN { "Column" }
			    )
			)
		formatString: #,0
		lineageTag: 73dd75f2-6527-4996-b233-6398532134a3

	/// Counts distinct hierarchy levels defined across all models. Hierarchy levels are the individual tiers within a user-defined hierarchy (e.g. Year > Quarter > Month).
	measure 'Model Object Distinct Count - Hierarchy Level' =
			CALCULATE(
			    [Model Object Distinct Count],
			    KEEPFILTERS( 'Model Object Hierarchy'[Object Type] IN { "Level" } )
			)
		formatString: #,0
		lineageTag: bee042fc-9035-4198-943d-a5d3dbe36e3b

	/// Counts distinct user-defined hierarchies across all models. Hierarchies group related columns for drill-down navigation (e.g. a Date hierarchy with Year, Quarter, Month levels).
	measure 'Model Object Distinct Count - Hierarchy' =
			CALCULATE(
			    [Model Object Distinct Count],
			    KEEPFILTERS(
			        'Model Object Hierarchy'[Object Type] IN { "Hierarchy" }
			    )
			)
		formatString: #,0
		lineageTag: 59e57d1a-509d-4994-a3c9-c28b02924295

	/// Counts distinct measures (DAX calculations) defined across all models in the current filter context. Compare with 'Report Objects Distinct Count - Measure' to see how many are actually used in reports.
	measure 'Model Object Distinct Count - Measure' =
			CALCULATE(
			    [Model Object Distinct Count],
			    KEEPFILTERS( 'Model Object Hierarchy'[Object Type] IN { "Measure" } )
			)
		formatString: #,0
		lineageTag: 5ab3a6d9-84c9-46dc-81cd-1fe6f89c402b

	/// Counts distinct partitions (Power Query queries/data sources) across all models. Each partition represents a data loading query that populates a table.
	measure 'Model Object Distinct Count - Query' =
			CALCULATE(
			    [Model Object Distinct Count],
			    KEEPFILTERS(
			        'Model Object Hierarchy'[Object Type] IN { "Partition" }
			    )
			)
		formatString: #,0
		lineageTag: a849f5bc-f233-4dff-b4cf-8a7a06e6a782

	/// Counts distinct relationships defined across all models. Relationships connect tables in the model and determine how filters propagate between tables.
	measure 'Model Object Distinct Count - Relationship' =
			CALCULATE(
			    [Model Object Distinct Count],
			    KEEPFILTERS(
			        'Model Object Hierarchy'[Object Type] IN { "Relationship" }
			    )
			)
		formatString: #,0
		lineageTag: b9959174-c1d8-4d68-9f03-67a81e1667f7

	/// Counts distinct tables across all models in the current filter context. When the 'Object Used Flag' slicer is applied, counts tables that have at least one used (or unused) object. Answers: 'How many tables are in this model?' or 'How many tables have objects that are actually used in reports?'
	measure 'Model Object Distinct Count - Table' =
			VAR SelectedFlag =
			    SELECTEDVALUE( 'Model Object Hierarchy'[Object Used Flag] )
			VAR TableFlagSummary =
			    ADDCOLUMNS(
			        SUMMARIZE(
			            'All Models',
			            'All Models'[Workspace Name - Model ID - Table Name]
			        ),
			        "HasUsed",
			            CALCULATE(
			                COUNTROWS( 'All Models' ),
			                'Model Object Hierarchy'[Object Used Flag] = "Used"
			            ),
			        "HasUnused",
			            CALCULATE(
			                COUNTROWS( 'All Models' ),
			                'Model Object Hierarchy'[Object Used Flag] = "Unused"
			            )
			    )
			VAR FilteredUsedOnly =
			    FILTER( TableFlagSummary, [HasUsed] > 0 )
			VAR FilteredUnusedOnly =
			    FILTER( TableFlagSummary, [HasUsed] = 0 && [HasUnused] > 0 )
			RETURN
			    SWITCH(
			        TRUE( ),
			        SelectedFlag = "Used", COUNTROWS( FilteredUsedOnly ),
			        SelectedFlag = "Unused", COUNTROWS( FilteredUnusedOnly ),
			        -- Fallback: no flag selected or multiple selected
			        DISTINCTCOUNTNOBLANK(
			            'All Models'[Workspace Name - Model ID - Table Name]
			        )
			    )
		formatString: #,0
		lineageTag: dde0e4c0-cb22-42b2-becf-51f8fda99721

	/// Counts all distinct model objects (columns, measures, hierarchies, etc.) defined across models, excluding report-level measures. This is the total inventory of objects available in the model. Compare with 'Report Objects Distinct Count' to see the gap between what exists and what is actually used.
	measure 'Model Object Distinct Count' =
			CALCULATE(
			    [Model Object Distinct Count - Base],
			    KEEPFILTERS(
			        'Model Object Hierarchy'[Report Level Measure Flag] IN { "False" }
			    )
			)
		formatString: #,0
		lineageTag: 7691c61e-a26a-4cf0-b563-c6e92367f087

	/// Total row count from the All Models fact table. Each row represents one model object instance. Unlike distinct counts, this may include duplicates when the same object appears in multiple contexts.
	measure 'Model Objects Count - All Rows' =
			COUNT(
			    'All Models'[WorkspaceName - ModelName - ObjectType - TableName - ObjectName]
			)
		formatString: #,0
		lineageTag: 6a26a929-3745-483c-bc55-7f8355b12fe6

	/// Counts distinct composite models (models with mixed storage modes like Import + DirectQuery). Composite models connect to multiple data sources with different storage strategies.
	measure 'Composite Model Distinct Count' =
			CALCULATE(
			    [Model Distinct Count],
			    KEEPFILTERS(
			        'Model Object Hierarchy'[Model Type] IN { "Composite Model" }
			    )
			)
		formatString: #,0
		lineageTag: c96f9f89-28c9-4136-8aff-64d374128646

	/// Counts distinct standard models (single storage mode, typically all Import). As opposed to composite models which mix storage modes.
	measure 'Standard Model Distinct Count' =
			CALCULATE(
			    [Model Distinct Count],
			    KEEPFILTERS(
			        'Model Object Hierarchy'[Model Type] IN { "Standard Model" }
			    )
			)
		formatString: #,0
		lineageTag: f15dbd07-25c3-4637-b4f1-cd4b3a73129d

	/// Counts the total distinct semantic models in the current filter context. Each model is identified by its workspace and model ID combination. Use this to answer: 'How many models are in scope?'
	measure 'Model Distinct Count' = DISTINCTCOUNTNOBLANK('All Models'[Workspace Name - Model ID])
		formatString: 0
		lineageTag: d55d29a5-22f6-4fad-85c0-c5916c4dbba9

	/// Counts measures that are defined at the report level (report-level measures live inside a .pbix report, not in the shared semantic model). These measures are only available in that specific report and are not shared across other reports connected to the same model.
	measure 'Report Level Measure Count' =
			CALCULATE(
			    [Model Object Distinct Count - Base],
			    KEEPFILTERS(
			        'Model Object Hierarchy'[Report Level Measure Flag] = "True"
			    ),
			    KEEPFILTERS('Report Hierarchy'[Workspace Name - Report Name] <> BLANK()),
			    USERELATIONSHIP( 'Report Hierarchy'[Workspace Name - Model ID - Report ID], 'All Models'[Report Workspace Name - Model ID - Report ID] )
			)
		formatString: #,0
		lineageTag: 0f02acce-ab16-4617-b34e-10f9c5f1e5ab

	/// Base distinct count of all model objects without any report-level measure filtering. This is the foundation measure used by other 'Model Object Distinct Count' variants that apply additional filters for specific object types.
	measure 'Model Object Distinct Count - Base' =
			DISTINCTCOUNTNOBLANK(
			    'All Models'[WorkspaceName - ModelName - ObjectType - TableName - ObjectName]
			)
		formatString: 0
		lineageTag: 59874911-8d74-4ec9-9fc5-86ec26f8363e

	/// Counts the distinct reports connected to a given model. Answers: 'How many reports use this model?' Filter by 'Model Object Hierarchy'[Model Name] or [Workspace Name] to scope to a specific model.
	measure 'Connected Report Count' = CALCULATE([Report Distinct Count (Visual Impact)], KEEPFILTERS('Model Object Hierarchy'[WorkspaceName - ModelName - ObjectType - TableName - ObjectName] <> BLANK()))
		formatString: 0
		lineageTag: bf385070-62b7-40fd-84f0-d8b5c64cb3f8

