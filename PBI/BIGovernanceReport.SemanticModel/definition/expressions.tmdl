expression 'Workspace, Model, & Report Mapping' =
		let
		    // Start from the Workspace & Model Mapping to get model-workspace associations
		    Source = #"Workspace & Model Mapping",
		    // Join with the page-level mapping to bring in report details for each model
		    #"Merged Queries" = Table.NestedJoin(Source, {"Workspace Name - Model ID"}, #"Workspace, Model, Report, & Page Mapping", {"Workspace Name - Model ID"}, "Workspace, Model, Report, & Page Mapping", JoinKind.LeftOuter),
		    // Expand report-level fields: Report Name, ReportID, description, and model detail flag
		    #"Expanded Workspace, Model, Report, & Page Mapping" = Table.ExpandTableColumn(#"Merged Queries", "Workspace, Model, Report, & Page Mapping", {"Report Name", "ReportID", "ReportDescription", "Model Detail Available?"}, {"Report Name", "ReportID", "ReportDescription", "Model Detail Available?"}),
		    // Default "Model Detail Available?" to TRUE when no match is found
		    #"Replaced Value" = Table.ReplaceValue(#"Expanded Workspace, Model, Report, & Page Mapping",null,"TRUE",Replacer.ReplaceValue,{"Model Detail Available?"}),
		    // Default null ReportIDs to "Unknown Report ID" for orphaned models
		    #"Replaced Value1" = Table.ReplaceValue(#"Replaced Value",null,"Unknown Report ID",Replacer.ReplaceValue,{"ReportID"}),
		    // Standardize the Report Name column name
		    #"Renamed Columns" = Table.RenameColumns(#"Replaced Value1",{{"Report Name", "ReportName"}}),
		    // Fallback: use Model Name as Report Name when no report is linked
		    #"Added Conditional Column" = Table.AddColumn(#"Renamed Columns", "Report Name", each if [ReportName] = null then [Model Name] else [ReportName], type text),
		    // Create a composite key: Workspace - Model - Report for unique identification
		    #"Added Custom" = Table.AddColumn(#"Added Conditional Column", "Workspace Name - Model Name - Report Name", each [Workspace Name]&" - "&[Model Name]&" - "&[Report Name], type text),
		    // Create a composite key: Workspace - Report for report-level lookups
		    #"Added Custom1" = Table.AddColumn(#"Added Custom", "Workspace Name - Report Name", each [Workspace Name]&" - "&[Report Name], type text),
		    // Create a composite key: Workspace - ModelID - ReportID for precise joins
		    #"Added Custom2" = Table.AddColumn(#"Added Custom1", "Workspace Name - Model ID - Report ID", each [Workspace Name]&" - "&[Model ID]&" - "&[ReportID], type text),
		    // Keep only the final mapping columns needed downstream
		    #"Removed Other Columns" = Table.SelectColumns(#"Added Custom2",{"Workspace Name - Model ID", "Model in Workspace Flag", "Model Home Workspace Name", "Model Detail Available?", "Workspace Name", "Workspace ID", "Model Name", "Model ID", "Report Name", "ReportID", "ReportDescription", "Workspace Name - Model Name - Report Name", "Workspace Name - Report Name", "Workspace Name - Model ID - Report ID"})
		in
		    #"Removed Other Columns"
