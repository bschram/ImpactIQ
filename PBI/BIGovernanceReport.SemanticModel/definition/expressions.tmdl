expression MeasuresUsedinCalculatedColumns =
		let
		    // --- Inner query: Build a measures-only lookup table from the full semantic model detail ---
		    ModelDetailMeasuresOnly=let
		    // Load the full semantic model detail from the base query
		    Source = #"Base Semantic Models",
		    // Rename columns to standardized field names
		    #"Renamed Columns" = Table.RenameColumns(Source,{{"Name", "Object Name"}, {"Type", "Object Type"}, {"Table", "Table Name"}, {"IsHidden", "Is Hidden"}, {"DisplayFolder", "Display Folder"}, {"FormatString", "Format String"}}),
		    // Keep only measure objects for the lookup table
		    #"Filtered Rows" = Table.SelectRows(#"Renamed Columns", each ([Object Type] = "Measure")),
		    // Create model-name-based composite key
		    #"Added Custom" = Table.AddColumn(#"Filtered Rows", "ModelName - ObjectType - TableName - ObjectName", each [ModelName]&" - "&[Object Type]&" - "&[Table Name]&" - "&[Object Name], type text),
		    // Create workspace-model-object composite key
		    #"Added Custom1" = Table.AddColumn(#"Added Custom", "WorkspaceName - ModelName - ObjectType - TableName - ObjectName", each [WorkspaceName]&" - "&[ModelName]&" - "&[Object Type]&" - "&[Table Name]&" - "&[Object Name], type text),
		    // Create workspace-model name key for grouping
		    #"Added Custom2" = Table.AddColumn(#"Added Custom1", "Workspace Name - Model Name", each [WorkspaceName]&" - "&[ModelName], type text),
		    // Create workspace-model-object name key for join matching
		    #"Added Custom3" = Table.AddColumn(#"Added Custom2", "Workspace Name - Model Name - Object Name", each [WorkspaceName]&" - "&[ModelName]&" - "&[Object Name], type text),
		    // Create ModelID-based object key
		    #"Added Custom4" = Table.AddColumn(#"Added Custom3", "Model ID - Object Name", each [ModelID]&" - "&[Object Name], type text),
		    // Create workspace-ModelID key
		    #"Added Custom5" = Table.AddColumn(#"Added Custom4", "Workspace Name - Model ID", each [WorkspaceName]&" - "&[ModelID], type text),
		    // Create workspace-ModelID-object key for deduplication and join
		    #"Added Custom6" = Table.AddColumn(#"Added Custom5", "Workspace Name - Model ID - Object Name", each [WorkspaceName]&" - "&[ModelID]&" - "&[Object Name], type text),
		    // Deduplicate measures at the workspace-ModelID-object level
		    #"Removed Duplicates" = Table.Distinct(#"Added Custom6", {"Workspace Name - Model ID - Object Name"}),
		    // Keep only the columns needed for the lookup join
		    #"Removed Other Columns" = Table.SelectColumns(#"Removed Duplicates",{"Object Type", "Table Name", "Object Name", "Format String", "Display Folder", "Description", "Is Hidden", "Expression", "ModelAsOfDate", "WorkspaceName", "ModelName", "ModelID", "ModelName - ObjectType - TableName - ObjectName", "WorkspaceName - ModelName - ObjectType - TableName - ObjectName", "Workspace Name - Model Name", "Workspace Name - Model Name - Object Name", "Model ID - Object Name", "Workspace Name - Model ID - Object Name"})
		in
		    #"Removed Other Columns",
		    // --- Outer query: Parse calculated column dependency references and resolve via lookup join ---
		    // Load the calculated column dependency data
		    Source = #"Base Calculated Column Dependencies",
		    // Keep only dependencies where a calculated column references a measure
		    #"Filtered Rows" = Table.SelectRows(Source, each ([DependsOnType] = "Measure")),
		    // Remove the original CalculatedColumn name - we want the referenced measure
		    #"Removed Columns" = Table.RemoveColumns(#"Filtered Rows",{"CalculatedColumn"}),
		    // Rename DependsOn to MeasureName - this is the measure being referenced
		    #"Renamed Columns" = Table.RenameColumns(#"Removed Columns",{{"DependsOn", "MeasureName"}}),
		    // Remove opening bracket from the measure reference syntax [MeasureName]
		    #"Replaced Value" = Table.ReplaceValue(#"Renamed Columns","[","",Replacer.ReplaceText,{"MeasureName"}),
		    // Remove closing bracket from the measure reference syntax
		    #"Replaced Value1" = Table.ReplaceValue(#"Replaced Value","]","",Replacer.ReplaceText,{"MeasureName"}),
		    // Create workspace-model name key for grouping
		    #"Added Custom" = Table.AddColumn(#"Replaced Value1", "Workspace Name - Model Name", each [WorkspaceName]&" - "&[ModelName], type text),
		    // Create workspace-model-measure key for join matching
		    #"Added Custom1" = Table.AddColumn(#"Added Custom", "Workspace Name - Model Name - Object Name", each [WorkspaceName]&" - "&[ModelName]&" - "&[MeasureName], type text),
		    // Create ModelID-measure key
		    #"Added Custom2" = Table.AddColumn(#"Added Custom1", "Model ID - Object Name", each [ModelID]&" - "&[MeasureName], type text),
		    // Create workspace-ModelID key
		    #"Added Custom3" = Table.AddColumn(#"Added Custom2", "Workspace Name - Model ID", each [WorkspaceName]&" - "&[ModelID], type text),
		    // Create workspace-ModelID-measure key for the lookup join
		    #"Added Custom4" = Table.AddColumn(#"Added Custom3", "Workspace Name - Model ID - Object Name", each [WorkspaceName]&" - "&[ModelID]&" - "&[MeasureName], type text),
		    // Left outer join with the measures-only lookup to resolve table name and object type for each referenced measure
		    #"Merged Queries" = Table.NestedJoin(#"Added Custom4", {"Workspace Name - Model ID - Object Name"}, ModelDetailMeasuresOnly, {"Workspace Name - Model ID - Object Name"}, "Measures Only", JoinKind.LeftOuter),
		    // Expand the joined measure detail columns
		    #"Expanded Measures Only" = Table.ExpandTableColumn(#"Merged Queries", "Measures Only", {"Object Type", "Table Name", "Object Name", "WorkspaceName - ModelName - ObjectType - TableName - ObjectName"}, {"Object Type", "Table Name", "Object Name", "WorkspaceName - ModelName - ObjectType - TableName - ObjectName"}),
		    // Keep only the columns needed for usage tracking output
		    #"Removed Other Columns" = Table.SelectColumns(#"Expanded Measures Only",{"Table Name", "Object Name", "Object Type", "WorkspaceName", "ModelName", "ModelID", "WorkspaceName - ModelName - ObjectType - TableName - ObjectName"}),
		    // Create model-level composite key using ModelID for unique object identification
		    #"Added Custom5" = Table.AddColumn(#"Removed Other Columns", "ModelID - ObjectType - TableName - ObjectName", each [ModelID]&" - "&[Object Type]&" - "&[Table Name]&" - "&[Object Name], type text),
		    // Tag the usage source as "Calculated Columns" to track measure usage from calc columns
		    #"Added Custom6" = Table.AddColumn(#"Added Custom5", "Object Used In", each "Calculated Columns", type text),
		    // Trim whitespace from the deduplication key
		    #"Trimmed Text" = Table.TransformColumns(#"Added Custom6",{{"WorkspaceName - ModelName - ObjectType - TableName - ObjectName", Text.Trim, type text}}),
		    // Normalize case for consistent deduplication
		    #"Cleaned Text" = Table.TransformColumns(#"Trimmed Text",{{"WorkspaceName - ModelName - ObjectType - TableName - ObjectName", Text.Proper, type text}}),
		    // We need the general usage flags to be at the Model level, not Workspace & Model. Model ID ensures it's still unique to a specific Model but doesn't incorrectly filter out usage based on Workspace. At the Model level, if an object is used anywhere, regardless of workspace, it is used and will affect reports. Exact usage location is via Report detail.
		    #"Removed Duplicates" = Table.Distinct(#"Cleaned Text", {"WorkspaceName - ModelName - ObjectType - TableName - ObjectName"})
		in
		    #"Removed Duplicates"
