table 'All Dataflows'
	lineageTag: 55d1e4e3-c9be-4bea-bf72-5ff51093c1f6

	measure 'Dataflow Related Models Concatenate' = ```
			VAR CurrentDataflow = SELECTEDVALUE('All Dataflows'[Dataflow ID])
			RETURN 
			CONCATENATEX(
			    DISTINCT(
			        SELECTCOLUMNS(
			            FILTER(
			                'All Models',
			                'All Models'[Dataflow ID used in Partition] = CurrentDataflow
			            ),
			            "Model", 'All Models'[Workspace Name - Model Name]
			        )
			    ),
			    [Model], 
			            UNICHAR(10),  // New line delimiter
			[Model],  // Order by Object Name alphabetically
			            ASC  // Sort in ascending order
			)
			```
		lineageTag: 538dcc3b-ce6f-4985-9579-632d62236347

	measure 'Dataflow Related Models Distinct Count' = ```
			VAR CurrentDataflow = SELECTEDVALUE('All Dataflows'[Dataflow ID])
			VAR Presln = 
			COUNTROWS(
			    DISTINCT(
			        SELECTCOLUMNS(
			            FILTER(
			                'All Models',
			                'All Models'[Dataflow ID used in Partition] = CurrentDataflow
			            ),
			            "Model", 'All Models'[Workspace Name - Model ID]
			        )
			    )
			)
			RETURN
			Presln
			```
		formatString: 0
		lineageTag: ba22bca7-96e9-41d6-856c-fb09c534d1d5

