expression 'Workspace & Model Mapping' = ```
		let
		    // Load detailed model metadata from the Base Semantic Models query
		    Source = #"Base Semantic Models",
		    // Keep only workspace, model name, and model ID columns
		    #"Removed Other Columns" = Table.SelectColumns(Source,{"WorkspaceName", "ModelName", "OriginalModelID", "ModelID"}),
		    //For Pro Workspaces, the Model ID cannot be extracted from the model itself and has "Workspace Name - Model Name" as its Model ID. This merge is used to pull the TRUE Model ID and use for later steps.
		    #"Merged Queries" = Table.NestedJoin(#"Removed Other Columns", {"ModelID"}, #"Power BI Datasets", {"DatasetId"}, "Power BI Datasets", JoinKind.LeftOuter),
		    // Expand WorkspaceId and DatasetDescription from the datasets table
		    #"Expanded Power BI Datasets" = Table.ExpandTableColumn(#"Merged Queries", "Power BI Datasets", {"WorkspaceId", "DatasetDescription"}, {"WorkspaceId", "DatasetDescription"}),
		    // Remove rows where no workspace match was found (orphaned model entries)
		    #"Filtered Rows" = Table.SelectRows(#"Expanded Power BI Datasets", each [WorkspaceId] <> null and [WorkspaceId] <> ""),
		    // Rename WorkspaceName to the standardized "Workspace Name" format
		    #"Renamed Columns" = Table.RenameColumns(#"Filtered Rows",{{"WorkspaceName", "Workspace Name"}}),
		    // Create a composite key for workspace-model ID lookups
		    #"Added Custom" = Table.AddColumn(#"Renamed Columns", "Workspace Name - Model ID", each [Workspace Name]&" - "&[ModelID], type text),
		    // Flag these rows as models that exist within their listed workspace
		    #"Added Custom1" = Table.AddColumn(#"Added Custom", "Model in Workspace Flag", each "TRUE", type text),
		    //Brings in the Model info from the Report Detail extract. The purpose being that if there is any Model that doesn't have a matching Workspace Name - Model ID, it means the Model sits in a different workspace than the Reports connecting to it. 
		    #"Appended Query" = Table.Combine({#"Added Custom1", #"Workspace, Model, Report, & Page Mapping"}),
		    // Keep only the mapping-relevant columns after the append
		    #"Removed Other Columns1" = Table.SelectColumns(#"Appended Query",{"Workspace Name - Model ID", "Model in Workspace Flag", "Workspace Name", "ModelName", "ModelID", "WorkspaceId", "OriginalModelID", "DatasetDescription"}),
		    // Default the workspace flag to FALSE for models from the report-level extract
		    #"Replaced Value" = Table.ReplaceValue(#"Removed Other Columns1",null,"FALSE",Replacer.ReplaceValue,{"Model in Workspace Flag"}),
		    // Replace null ModelIDs with placeholder text for traceability
		    #"Replaced Value1" = Table.ReplaceValue(#"Replaced Value",null,"Unknown Model ID",Replacer.ReplaceValue,{"ModelID", "OriginalModelID"}),
		    // Standardize column names: ModelName→Model Name, WorkspaceId→Workspace ID, ModelID→Model ID
		    #"Renamed Columns1" = Table.RenameColumns(#"Replaced Value1",{{"ModelName", "Model Name"}, {"WorkspaceId", "Workspace ID"}, {"ModelID", "Model ID"}}),
		    // Create a composite key for workspace-model name lookups
		    #"Added Custom2" = Table.AddColumn(#"Renamed Columns1", "Workspace Name - Model Name", each [Workspace Name]&" - "&[Model Name], type text),
		    // Deduplicate on the workspace-model ID composite key
		    #"Removed Duplicates" = Table.Distinct(#"Added Custom2", {"Workspace Name - Model ID"}),
		    // Look up the model's true home workspace name from Power BI Datasets
		    #"Merged Model Home" = Table.NestedJoin(#"Removed Duplicates", {"Model ID"}, #"Power BI Datasets", {"DatasetId"}, "ModelHomeLookup", JoinKind.LeftOuter),
		    #"Expanded Model Home" = Table.ExpandTableColumn(#"Merged Model Home", "ModelHomeLookup", {"WorkspaceName"}, {"Model Home Workspace Name"}),
		    // Default null Model Home Workspace Name (unresolvable models) to current Workspace Name
		    #"Replaced Model Home Null" = Table.ReplaceValue(#"Expanded Model Home",null,each [Workspace Name],Replacer.ReplaceValue,{"Model Home Workspace Name"}),
		    #"Changed Type" = Table.TransformColumnTypes(#"Replaced Model Home Null",{{"Model Home Workspace Name", type text}})
		in
		    #"Changed Type"
		```
