table 'All Model Refresh Schedule'
	lineageTag: fe64becc-6670-4c21-afa7-24d2681d79a2

	measure 'Model Refresh Scheduled Status' = MAX('All Model Refresh Schedule'[Dataset Refresh Schedule Enabled])
		lineageTag: 1e7621d3-5792-4499-998c-0b525b0d357b

	measure 'Failure Notification Status' = MAX('All Model Refresh Schedule'[Dataset Refresh Schedule Notify Option])
		lineageTag: 90333ad5-dabf-4df8-9fee-f5206cd75b54

	measure 'Scheduled Refresh Distinct Count' = DISTINCTCOUNTNOBLANK('All Model Refresh Schedule'[UniqueRefreshScheduleID])
		formatString: 0
		lineageTag: 5ed6943d-5267-4312-9095-38f6ea0139f8

	measure 'Scheduled Refresh Distinct Count - Models' = DISTINCTCOUNTNOBLANK('All Model Refresh Schedule'[Model ID])
		formatString: 0
		lineageTag: aa737cca-16f9-4d1f-bdb1-6fa8f793a0bf

	measure 'Scheduled Refreshes per Day' = CALCULATE(DIVIDE([Scheduled Refresh Distinct Count], 7), KEEPFILTERS('All Model Refresh Schedule'[Dataset Refresh Schedule Enabled] IN {"True"}))
		formatString: #,0
		lineageTag: 70df1213-4fae-46c5-b710-3703a61fe230

	measure 'Scheduled Refreshes per Week' = CALCULATE([Scheduled Refresh Distinct Count], KEEPFILTERS('All Model Refresh Schedule'[Dataset Refresh Schedule Enabled] IN {"True"}))
		lineageTag: 99f34764-7832-4977-a202-eb280ac61a32

		annotation PBI_FormatHint = {"isGeneralNumber":true}

