table 'All Model Refresh History'
	lineageTag: f6792d07-2b79-43c9-ba89-52cd65746ac9

	measure 'Model Refresh Count' = COUNT('All Model Refresh History'[Refresh ID])
		formatString: 0
		lineageTag: e005227a-5ad8-465a-a708-dbcbbfcce838

	measure 'Model Refresh Count - Fail' = CALCULATE([Model Refresh Count], KEEPFILTERS('All Model Refresh History'[Refresh Status] IN {"Failed"}))
		formatString: 0
		lineageTag: aaa0633f-374b-4418-8da5-ac8cf0bc691a

	measure 'Model Refresh Count - Success' =
			CALCULATE(
			    [Model Refresh Count],
			    KEEPFILTERS(
			        'All Model Refresh History'[Refresh Status] IN { "Completed" }
			    )
			)
		formatString: 0
		lineageTag: ada718c4-4955-46f6-9432-cd8cf0c445ba

	measure 'Model Refresh Duration' =
			VAR Hours = INT([Model Refresh Duration (Hours)])
			VAR Minutes = INT([Model Refresh Duration (Minutes)])
			VAR Seconds = MOD([Model Refresh Duration (Seconds)], 60)
			RETURN
			SWITCH(TRUE(), Seconds=blank(), BLANK(),  FORMAT(Hours, "00") & ":" & FORMAT(Minutes, "00") & ":" & FORMAT(Seconds, "00"))
		lineageTag: 065af0d7-ff90-4e1b-bc53-1bb40997cc98

	measure 'Model Refresh Duration - Success' =
			CALCULATE(
			    [Model Refresh Duration],
			    KEEPFILTERS(
			        'All Model Refresh History'[Refresh Status] IN { "Completed" }
			    )
			)
		lineageTag: 093f0599-0e41-4f9d-ae10-d35b8fb2be5e

	measure 'Model Refresh Duration (Hours - Success)' =
			CALCULATE(
			    [Model Refresh Duration (Hours)],
			    KEEPFILTERS(
			        'All Model Refresh History'[Refresh Status] IN { "Completed" }
			    )
			)
		lineageTag: 8c758136-0cc9-40d1-970a-492cc97da05d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Model Refresh Duration (Hours)' = DIVIDE([Model Refresh Duration (Seconds)], 3600)
		lineageTag: f7d2ecb3-fff5-4058-9570-b4101a2a348a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Model Refresh Duration (Minutes - Success)' =
			CALCULATE(
			    [Model Refresh Duration (Minutes)],
			    KEEPFILTERS(
			        'All Model Refresh History'[Refresh Status] IN { "Completed" }
			    )
			)
		lineageTag: fa346f3e-0516-4175-b66a-3a79e3eae7b3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Model Refresh Duration (Minutes)' = DIVIDE([Model Refresh Duration (Seconds)], 60)
		lineageTag: d35ee7d5-0ba8-4cf1-8329-5bbc8a1fa18c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Model Refresh Duration (Seconds - Success)' =
			CALCULATE(
			    [Model Refresh Duration (Seconds)],
			    KEEPFILTERS(
			        'All Model Refresh History'[Refresh Status] IN { "Completed" }
			    )
			)
		formatString: 0
		lineageTag: 386b1164-fcb1-48d8-b60a-783719619432

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Model Refresh Duration (Seconds)' = DATEDIFF([Model Refresh Start Time], [Model Refresh End Time], SECOND)
		formatString: 0
		lineageTag: fdd223dc-8219-4db2-8745-a3a4b9f6f430

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Model Refresh Duration Average' = ```
			VAR TotalSeconds = [Model Refresh Duration Average (Seconds - Success)]
			VAR Hours = INT(TotalSeconds / 3600)
			VAR Minutes = INT(MOD(TotalSeconds, 3600) / 60)
			VAR Seconds = MOD(TotalSeconds, 60)
			
			RETURN
			SWITCH(
			    TRUE(), 
			    ISBLANK(TotalSeconds), BLANK(), 
			    FORMAT(Hours, "00") & ":" & FORMAT(Minutes, "00") & ":" & FORMAT(Seconds, "00")
			)
			```
		lineageTag: 944ad26f-c5fc-4551-b885-82f062ca6ff0

	measure 'Model Refresh Duration Average (Hours - Success)' =
			DIVIDE(
			    [Model Refresh Duration Total (Hours - Success)],
			    [Model Refresh Count - Success]
			)
		formatString: 0
		lineageTag: 6811860d-82e9-466f-b35b-b3ea996d060f

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Model Refresh Duration Average (Minutes - Success)' =
			DIVIDE(
			    [Model Refresh Duration Total (Minutes - Success)],
			    [Model Refresh Count - Success]
			)
		formatString: 0
		lineageTag: 3dcb6aaf-9fe4-4bbd-947d-374ee6c70b2b

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Model Refresh Duration Average (Seconds - Success)' =
			DIVIDE(
			    [Model Refresh Duration Total (Seconds - Success)],
			    [Model Refresh Count - Success]
			)
		formatString: 0
		lineageTag: f2eea783-6691-41a0-896c-312a0877fbea

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Model Refresh Duration Total (Hours - Success)' = SUMX('All Model Refresh History', [Model Refresh Duration (Hours - Success)])
		formatString: 0
		lineageTag: 8803c8be-b09e-4f77-aa43-f3532d89e8bb

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Model Refresh Duration Total (Minutes - Success)' = SUMX('All Model Refresh History', [Model Refresh Duration (Minutes - Success)])
		formatString: 0
		lineageTag: 04cb799e-e90b-49dd-85d0-bfff83ec5a24

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Model Refresh Duration Total (Seconds - Success)' = SUMX('All Model Refresh History', [Model Refresh Duration (Seconds - Success)])
		formatString: 0
		lineageTag: 3255ecd1-1ddc-43f7-89f8-a4a52e6807fc

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Model Refresh End Time' = MAX('All Model Refresh History'[Refresh End Time])
		formatString: General Date
		lineageTag: d51453c7-9c56-431c-8b1e-3086beeaf810

	measure 'Model Refresh Start Time' = MAX('All Model Refresh History'[Refresh Start Time])
		formatString: General Date
		lineageTag: be052c91-e049-4bcc-945a-06762cc1ccab

	measure 'Model Refresh Success Rate' = DIVIDE([Model Refresh Count - Success], [Model Refresh Count])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 485c4022-7397-4639-80f1-e74990a0b19e

