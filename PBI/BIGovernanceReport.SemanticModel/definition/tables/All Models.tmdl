				    // Conditionally set full composite key only for applicable object types
				    #"Added Conditional Column3" = Table.AddColumn(#"Added Custom10", "Workspace Name - Model ID - Object Type - Table Name - Object Name", each if [Object Type] = "Relationship" then [#"Temp Workspace Name - Model ID - Object Type - Table Name - Object Name"] else if [Object Type] = "Measure" then [#"Temp Workspace Name - Model ID - Object Type - Table Name - Object Name"] else if [Object Type] = "Column" then [#"Temp Workspace Name - Model ID - Object Type - Table Name - Object Name"] else if [Object Type] = "Level" then [#"Temp Workspace Name - Model ID - Object Type - Table Name - Object Name"] else null, type text),
