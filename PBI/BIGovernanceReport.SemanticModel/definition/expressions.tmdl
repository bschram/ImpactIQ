		        {
		            {"AppliedFilter", each if _ <> "" and _ <> null then "True" else "False", type text},
		            {"HiddenFilter", each if _ <> "" and _ <> null then "True" else "False", type text},
		            {"LockedFilter", each if _ <> "" and _ <> null then "True" else "False", type text}
		        }
		            ),
		    // Left join with the page mapping to get the first page for each report
		    #"Merged Queries" = Table.NestedJoin(#"Replaced Value", {"ReportID"}, #"Workspace, Model, Report, & Page Mapping", {"ReportID"}, "Report Name", JoinKind.LeftOuter),
		    // Expand the first page ID, navigation key, and exclusion flag from the mapping
