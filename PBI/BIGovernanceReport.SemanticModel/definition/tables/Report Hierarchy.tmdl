	partition 'Report Hierarchy' = m
		mode: import
		queryGroup: Dimensions
		source =
				let
				    // Load report page data from the Pages query
				    Source = #"Pages",
				    // Keep only the essential page and report identifier columns
				    #"Removed Other Columns" = Table.SelectColumns(Source,{"WorkspaceName", "ReportName", "ReportID", "ModelID", "PageName", "PageID", "PageNumber", "PageWidth", "PageHeight", "PageHiddenFlag", "PageDimensionsType", "UniquePageID", "Report Name - Page Name","Workspace Name - Report Name", "Workspace Name - Model ID - Report ID", "Workspace Name - Report Name - Page Name", "Workspace Name - Report ID - Page ID"}),
				    // Rename columns to user-friendly display names with spaces
				    #"Renamed Columns" = Table.RenameColumns(#"Removed Other Columns",{{"PageName", "Page Name"}, {"PageNumber", "Page Number"}, {"PageWidth", "Page Width"}, {"PageHeight", "Page Height"}, {"PageHiddenFlag", "Page Hidden Flag"}, {"PageDimensionsType", "Page Dimensions Type"}, {"ReportName", "Report Name"}, {"WorkspaceName", "Workspace Name"}, {"ModelID", "Model ID"}}),
				    // Sort pages in ascending order by page number
				    #"Sorted Rows" = Table.Sort(#"Renamed Columns",{{"Page Number", Order.Ascending}}),
				    // Add a sequential index column for row ordering
				    #"Added Index" = Table.AddIndexColumn(#"Sorted Rows", "Index", 1, 1, Int64.Type),
				    // Flag pages whose name contains "isting" (e.g., "Listing") as listing pages
				    #"Added Conditional Column" = Table.AddColumn(#"Added Index", "Listing Page?", each if Text.Contains(if [Page Name] = null then "" else [Page Name], "isting") then "true" else "false", type text),
				    // Add a Page Metrics Flag defaulting to "True" for all pages
				    #"Added Custom" = Table.AddColumn(#"Added Conditional Column", "Page Metrics Flag", each "True", type text),
				    // Join with Workspace, Model, & Report Mapping to resolve model context
				    #"Merged Queries" = Table.NestedJoin(#"Added Custom", {"Workspace Name - Model ID - Report ID"}, #"Workspace, Model, & Report Mapping", {"Workspace Name - Model ID - Report ID"}, "Workspace, Model, & Report Mapping", JoinKind.LeftOuter),
				    // Expand model-in-workspace flag, model home workspace, model detail availability, and model name
				    #"Expanded Workspace, Model, & Report Mapping" = Table.ExpandTableColumn(#"Merged Queries", "Workspace, Model, & Report Mapping", {"Model Home Workspace Name", "Model Detail Available?", "Model Name"}, {"Model Home Workspace Name", "Model Detail Available?", "Model Name"}),
				    // Create a composite key combining workspace name and model ID
				    #"Added Custom1" = Table.AddColumn(#"Expanded Workspace, Model, & Report Mapping", "Workspace Name - Model ID", each [Workspace Name]&" - "&[Model ID], type text),
				    // Replace null model names with "Unknown Model" for unresolved models
				    #"Replaced Value1" = Table.ReplaceValue(#"Added Custom1",null,"Unknown Model",Replacer.ReplaceValue,{"Model Name"}),
				    // Join with Power BI Environment Information to get workspace and app IDs
				    #"Merged Queries1" = Table.NestedJoin(#"Replaced Value1", {"Workspace Name"}, #"Power BI Environment Information", {"WorkspaceName"}, "Power BI Environment Information", JoinKind.LeftOuter),
				    // Expand WorkspaceId and AppID from the environment info
				    #"Expanded Power BI Environment Information" = Table.ExpandTableColumn(#"Merged Queries1", "Power BI Environment Information", {"WorkspaceId", "App ID"}, {"WorkspaceID", "AppID"}),
				    // Create a composite key combining workspace ID, report ID, and page ID
				    #"Added Custom2" = Table.AddColumn(#"Expanded Power BI Environment Information", "Workspace ID - Report ID - Page ID", each [WorkspaceID]&" - "&[ReportID]&" - "&[PageID], type text),
				    // Create a composite key combining workspace name and report ID
				    #"Added Custom3" = Table.AddColumn(#"Added Custom2", "Workspace Name - Report ID", each [Workspace Name]&" - "&[ReportID], type text),
				    // Generate the App Page URL for navigating to a specific page in the published app
				    #"Added Custom4" = Table.AddColumn(#"Added Custom3", "App Page URL", each "https://app.powerbi.com/groups/me/apps/"&[AppID]&"/reports/"&[ReportID]&"/"&[PageID], type text),
				    // Generate the Workspace Page URL for navigating to a specific page in the workspace
				    #"Added Custom5" = Table.AddColumn(#"Added Custom4", "Workspace Page URL", each "https://app.powerbi.com/groups/"&[WorkspaceID]&"/reports/"&[ReportID]&"/"&[PageID], type text),
				    // Generate the App Report URL for navigating to the report in the published app
				    #"Added Custom6" = Table.AddColumn(#"Added Custom5", "App Report URL", each "https://app.powerbi.com/groups/me/apps/"&[AppID]&"/reports/"&[ReportID], type text),
				    // Generate the Workspace Report URL for navigating to the report in the workspace
				    #"Added Custom7" = Table.AddColumn(#"Added Custom6", "Workspace Report URL", each "https://app.powerbi.com/groups/"&[WorkspaceID]&"/reports/"&[ReportID], type text),
				    // Generate the Workspace URL for navigating to the workspace
				    #"Added Custom8" = Table.AddColumn(#"Added Custom7", "Workspace URL", each "https://app.powerbi.com/groups/"&[WorkspaceID], type text),
				    // Generate the App URL for navigating to the published app
				    #"Added Custom9" = Table.AddColumn(#"Added Custom8", "App URL", each "https://app.powerbi.com/groups/me/apps/"&[AppID], type text),
				    // Append Model Only Check rows for models with no associated reports
				    #"Appended Query" = Table.Combine({#"Added Custom9", #"Model Only Check"}),
				    // Duplicate the UniquePageID column for deduplication processing
				    #"Duplicated Column" = Table.DuplicateColumn(#"Appended Query", "UniquePageID", "UniquePageID - Copy"),
				    // Trim whitespace from the duplicated UniquePageID for consistent matching
				    #"Trimmed Text" = Table.TransformColumns(#"Duplicated Column",{{"UniquePageID - Copy", Text.Trim, type text}}),
				    // Apply proper casing to the duplicated UniquePageID for standardized comparison
				    #"Cleaned Text" = Table.TransformColumns(#"Trimmed Text",{{"UniquePageID - Copy", Text.Proper, type text}}),
				    // Remove duplicate rows based on the standardized UniquePageID copy
				    #"Removed Duplicates" = Table.Distinct(#"Cleaned Text", {"UniquePageID - Copy"}),
				    // Remove the temporary UniquePageID copy column used for deduplication
				    #"Removed Columns" = Table.RemoveColumns(#"Removed Duplicates",{"UniquePageID - Copy", "Model in Workspace Flag"}),
				    #"Added Custom10" = Table.AddColumn(#"Removed Columns", "Model Workspace Name - Model ID", each [Model Home Workspace Name]&" - "&[Model ID], type text),
				    #"Added Custom11" = Table.AddColumn(#"Added Custom10", "Model Name - Model ID", each [Model Name]&" - "&[Model ID], type text),
				    #"Filtered Rows" = Table.SelectRows(#"Added Custom11", each [UniquePageID] <> null and [UniquePageID] <> ""),
				    #"Merged Queries2" = Table.NestedJoin(#"Filtered Rows", {"ReportID"}, #"Power BI Reports", {"ReportId"}, "Power BI Reports", JoinKind.LeftOuter),
				    #"Expanded Power BI Reports" = Table.ExpandTableColumn(#"Merged Queries2", "Power BI Reports", {"ReportDescription", "ReportFormat"}, {"Report Description", "Report Format"})
				in
				    #"Expanded Power BI Reports"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

