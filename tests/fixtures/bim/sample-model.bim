          }
        ],
        "partitions": [
          {
            "name": "Sales",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(\"srv\", \"db\"),",
                "    dbo_Sales = Source{[Schema=\"dbo\",Item=\"Sales\"]}[Data]",
                "in",
                "    dbo_Sales"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Sales",
            "expression": "SUM(Sales[Amount])",
            "formatString": "#,0.00",
            "displayFolder": "KPIs",
            "description": "Sum of amount",
            "lineageTag": "4d0b7f1a-1111-4a2b-9c3d-000000000008"
          },
          {
            "name": "Total Cost",
            "expression": [
              "",
              "SUM ( Sales[Cost] )"
            ],
            "formatString": "#,0.00",
            "displayFolder": "KPIs",
            "lineageTag": "4d0b7f1a-1111-4a2b-9c3d-000000000009"
          },
          {
            "name": "Margin",
            "expression": [
              "/* margin = sales - cost; ignore \"[Not A Measure]\" and 'Fake Table' here */",
              "VAR sales = [Total Sales]",
              "VAR cost = [Total Cost] -- 'Fake Table'[Fake Column] in a line comment",
              "RETURN",
              "    IF ( sales > 0, DIVIDE ( sales - cost, sales ), \"[Another Fake]\" )"
            ],
            "formatString": "0.0%",
            "isHidden": false,
            "lineageTag": "4d0b7f1a-1111-4a2b-9c3d-000000000010"
          }
        ],
