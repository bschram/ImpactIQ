	/// Shows the percentage of total report object usage for the current page relative to all pages in the selection. Useful in matrix visuals to show relative usage distribution.
	measure 'Report Objects Distinct Count % - Pages' =
			VAR A =
			    DIVIDE(
			        [Report Objects Distinct Count],
			        [Report Objects Distinct Count - All Pages]
			    )
			RETURN
			    SWITCH( TRUE( ), ISINSCOPE( 'Report Hierarchy'[Page Name] ), A )
