expression 'Power BI Datasets' =
		let
		    // Load raw dataset/model data from the base environment query
		    Source = #"Base Power BI Datasets",
		    // Sanitize workspace names by removing special characters
		    #"Invoked Custom Function" = Table.AddColumn(Source, "Clean Name", each #"Clean Name"([WorkspaceName]), type text),
		    // Sanitize dataset names by removing special characters
		    #"Invoked Custom Function1" = Table.AddColumn(#"Invoked Custom Function", "Clean Name.1", each #"Clean Name"([DatasetName]), type text),
		    // Drop the original unsanitized name columns
		    #"Removed Columns" = Table.RemoveColumns(#"Invoked Custom Function1",{"WorkspaceName", "DatasetName"}),
		    // Rename the cleaned name columns back to their standard names
		    #"Renamed Columns" = Table.RenameColumns(#"Removed Columns",{{"Clean Name", "WorkspaceName"}, {"Clean Name.1", "DatasetName"}}),
		    // Keep only the relevant dataset metadata columns
		    #"Removed Other Columns" = Table.SelectColumns(#"Renamed Columns",{"WorkspaceId", "WorkspaceName", "DatasetId", "DatasetName", "DatasetDescription", "DatasetWebUrl", "DatasetAddRowsAPIEnabled", "DatasetConfiguredBy", "DatasetIsRefreshable", "DatasetIsEffectiveIdentityRequired", "DatasetIsEffectiveIdentityRolesRequired", "DatasetIsOnPremGatewayRequired", "DatasetTargetStorageMode", "DatasetCreatedDate", "createReportEmbedURL", "qnaEmbedURL", "DatasetQueryScaleOutSettings"}),
		    // Add a sequential index for dataset ordering
		    #"Added Index" = Table.AddIndexColumn(#"Removed Other Columns", "Dataset Index", 1, 1, Int64.Type),
		    // Join with Power BI Workspaces to determine if the workspace is on dedicated capacity
		    #"Merged Queries" = Table.NestedJoin(#"Added Index", {"WorkspaceId"}, #"Power BI Workspaces", {"WorkspaceId"}, "Power BI Workspaces", JoinKind.LeftOuter),
		    // Expand the dedicated capacity flag from the workspace merge
		    #"Expanded Power BI Workspaces" = Table.ExpandTableColumn(#"Merged Queries", "Power BI Workspaces", {"WorkspaceIsOnDedicatedCapacity"}, {"WorkspaceIsOnDedicatedCapacity"}),
		    // Create ModelID-1: the true DatasetId (used for Premium/dedicated capacity workspaces)
		    #"Added Custom" = Table.AddColumn(#"Expanded Power BI Workspaces", "ModelID-1", each [DatasetId], type text),
		    // Create ModelID-2: a composite "WorkspaceName ~ DatasetName" key (used for Pro workspaces)
		    #"Added Custom1" = Table.AddColumn(#"Added Custom", "ModelID-2", each [WorkspaceName]&" ~ "&[DatasetName]),
		    //For Pro Workspaces, the Model ID cannot be extracted from the model itself and has "Workspace Name - Model Name" as its Model ID. This steps mimics that process and allows later queris to pull the true Model ID info.
		    #"Added Conditional Column" = Table.AddColumn(#"Added Custom1", "ModelID", each if [WorkspaceIsOnDedicatedCapacity] = "false" then [#"ModelID-2"] else [#"ModelID-1"], type text),
		    // Create a composite key for workspace-model name lookups
		    #"Added Custom2" = Table.AddColumn(#"Added Conditional Column", "Workspace Name - Model Name", each [WorkspaceName]&" - "&[DatasetName], type text),
		    // Create a composite key for workspace-model ID lookups
		    #"Added Custom3" = Table.AddColumn(#"Added Custom2", "Workspace Name - Model ID", each [WorkspaceName]&" - "&[DatasetId], type text),
		    // Clean up the temporary ModelID columns
		    #"Removed Columns1" = Table.RemoveColumns(#"Added Custom3",{"ModelID-2", "ModelID-1"})
		in
		    #"Removed Columns1"
